#!/usr/bin/env bash
# adlc: manage ADLC project runners on the dev server.
#
#   adlc doctor                      check the host (and each project's CI roles and slots)
#   adlc secrets <slug>              store the project's credentials (prompted, never echoed)
#   adlc up <slug> [options]         build images and start/update the project's runner
#       --repo <owner/name>          GitHub repository (required the first time)
#       --domain <base>              base domain for preview URLs (default: <host-ip>.nip.io)
#       --stacks <a,b>               runner image stack layers (default: from adlc.yaml, else none)
#       --dind privileged|sysbox     Docker-in-Docker mode (default: sysbox if installed)
#       --registry <host>            container registry host (default ghcr.io), e.g. harbor.example.com
#       --registry-user <user>       registry pull user (Harbor: robot$<project>+<name>)
#       --registry-ca <file>         CA certificate for a registry with a private CA
#       --edge-port <port>           host port for preview URLs (default 80; stored for all projects)
#       --ci-kvm on|off              add/remove the kvm CI runner (ci-kvm, /dev/kvm, label adlc-kvm): Android e2e on this host
#       --ci-roles <a,b|none>        CI runner roles on this host: test, publish, kvm (default test,publish)
#       --ci-only                    this host only runs CI runners for the project (a second machine; see README)
#       --ci-host <name>             CI-only host's short name in its runner names (default: hostname)
#       --force                      update even while a delivery run is active (it may be stopped)
#   adlc app <slug> --id <app-id> --key <private-key.pem>
#                                    agents act as the ADLC GitHub App (recommended over gh_pat)
#   adlc login <slug>                one-time Claude login inside the runner
#   adlc session <slug> [name]       interactive Claude session in its own worktree (also reachable
#                                    from claude.ai/app); re-running re-attaches
#   adlc session <slug> --run <n> [--takeover]
#                                    session in delivery run #n's worktree (--takeover stops the unattended run)
#   adlc shell <slug>                bash inside the runner (gh authenticated)
#   adlc attach <slug>               attach to the runner's tmux (rc / poller / deployer / shell / sessions)
#   adlc status [slug] [--all] [--disk]  runners, active runs, pause state, open work in order of precedence; --disk: Docker usage per engine (slow)
#   adlc pause|resume <slug>         stop/start launching new delivery runs
#   adlc logs <slug> [poller|deployer|rc|egress|ci|hoststats|run <issue>]
#   adlc audit <slug>                egress domains seen (to build the allowlist)
#   adlc train <slug> [on|dry-run|off]  show or switch the merge train (approved agent PRs merged in order), live
#   adlc restart <slug> [--force]    restart the runner: reloads the ADLC plugins and Remote Control
#                                    (refuses while delivery runs are active unless --force)
#   adlc down <slug>                 stop the runner (workspace and volumes are kept)
#   adlc prune [slug]                free disk now: old ADLC images, build caches, finished runs' images
#   adlc ui [up|down|token|status]   web dashboard for all projects (LAN; login token)
#       up [--host <name>]…          start it; --host adds names a reverse proxy will use
#       token [--rotate]             show the login token (--rotate signs everyone out)
#       host-token <name> [--rotate|--remove]  token a CI-only host reports its CPU/memory/disk with
#       report <dashboard url>       on a CI-only host: report to the main host's dashboard (asks for the token)
set -euo pipefail

ADLC_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
ADLC_ROOT=${ADLC_ROOT:-/srv/adlc}
SANDBOX="$ADLC_HOME/sandbox"

say()  { printf '%s\n' "$*"; }
ok()   { printf '  \033[32m✔\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
bad()  { printf '  \033[31m✘\033[0m %s\n' "$*"; }
die()  { printf 'adlc: %s\n' "$*" >&2; exit 1; }

cfg_file() { echo "$ADLC_ROOT/config/$1.env"; }
need_slug() { [ -n "${1:-}" ] || die "missing <slug>"; [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || die "invalid slug '$1'"; }
load_cfg() {
  local f; f=$(cfg_file "$1"); [ -f "$f" ] || die "unknown project '$1' (run: adlc up $1 --repo owner/name)"
  set -a; # shellcheck disable=SC1090
  source "$f"; set +a
}
set_cfg() { # set_cfg <file> <KEY> <value>
  local f=$1 k=$2 v=$3
  touch "$f"
  if grep -q "^$k=" "$f"; then
    awk -v k="$k" -v v="$v" -F= '$1 == k { print k "=" v; next } { print }' "$f" >"$f.tmp" && mv "$f.tmp" "$f"
  else
    echo "$k=$v" >>"$f"
  fi
}
edge_cfg() { echo "$ADLC_ROOT/edge/edge.env"; }
edge_port() { local p=""; [ -f "$(edge_cfg)" ] && p=$(grep '^ADLC_EDGE_PORT=' "$(edge_cfg)" | cut -d= -f2); echo "${p:-${ADLC_EDGE_PORT:-80}}"; }
has_sysbox() { docker info --format '{{json .Runtimes}}' 2>/dev/null | grep -q sysbox-runc; }

compose() { # compose <slug> <args...>
  local slug=$1; shift
  local f; f=$(cfg_file "$slug")
  local files
  if ci_only; then
    files=(-f "$SANDBOX/compose.ci-host.yml")
  else
    files=(-f "$SANDBOX/compose.project.yml" -f "$SANDBOX/compose.dind-${ADLC_DIND_MODE:-privileged}.yml")
    [ -e /dev/kvm ] && files+=(-f "$SANDBOX/compose.kvm.yml")
    [ -n "${ADLC_REGISTRY_CA:-}" ] && files+=(-f "$SANDBOX/compose.registry-ca.yml")
  fi
  if ci_enabled "$slug"; then
    files+=(-f "$SANDBOX/compose.ci.yml")
    [ "${ADLC_DIND_MODE:-}" = sysbox ] && files+=(-f "$SANDBOX/compose.ci-sysbox.yml")
    [ -n "${ADLC_REGISTRY_CA:-}" ] && files+=(-f "$SANDBOX/compose.ci-registry-ca.yml")
  fi
  # Each CI role (registrar + engine) is a compose profile: test, publish, kvm; hoststats reports a
  # CI-only host to the dashboard once `adlc ui report` has set it up.
  COMPOSE_PROFILES=$({ ci_roles "$slug"; ci_only && hoststats_on && echo hoststats; } | paste -sd, -) \
    docker compose --env-file "$f" "${files[@]}" "$@"
}
hoststats_on() { [ -n "${ADLC_DASHBOARD_URL:-}" ] && [ -s "$ADLC_ROOT/config/dashboard-token" ]; }
ci_only() { [ "${ADLC_CI_ONLY:-0}" = 1 ]; }
# Fingerprint of the runner image's sources (scripts, Dockerfiles): stored as a label at build time, so
# `adlc restart` and `adlc doctor` can tell a runner that still runs older scripts than this checkout.
runner_src() { (cd "$SANDBOX/runner" && find . -type f -print0 | LC_ALL=C sort -z | xargs -0 cksum | cksum | cut -d' ' -f1); }
# Prints why the running runner (or, on a CI-only host, a registrar) is out of date; nothing when current.
runner_stale() { # runner_stale <slug> (after load_cfg)
  local svc=runner c have
  ci_only && svc=$(ci_registrars "$1" | head -1)
  [ -n "$svc" ] || return 0
  c=$(compose "$1" ps -q "$svc" 2>/dev/null | head -1)
  [ -n "$c" ] || return 0
  have=$(docker inspect "$c" --format '{{index .Config.Labels "adlc.runner-src"}}' 2>/dev/null)
  if [ -z "$have" ] || [ "$have" = "<no value>" ]; then echo "its image predates version labels"
  elif [ "$have" != "$(runner_src)" ]; then echo "its scripts are older than $ADLC_HOME"; fi
}
# The CI roles this host runs for a project (after load_cfg): ADLC_CI_ROLES, else test,publish plus kvm
# with ADLC_CI_KVM=1 (older configs). kvm only where /dev/kvm exists.
ci_roles() {
  ci_enabled "$1" || return 0
  local r=${ADLC_CI_ROLES:-test,publish$([ "${ADLC_CI_KVM:-0}" = 1 ] && echo ,kvm)} x
  for x in ${r//,/ }; do
    case $x in test|publish) echo "$x" ;; kvm) [ -e /dev/kvm ] && echo kvm ;; esac
  done
}
# has_ci_role <slug> <role>: no pipe into grep -q (under pipefail an early-exiting grep can fail the pipe).
has_ci_role() { [[ " $(ci_roles "$1" | tr '\n' ' ') " == *" $2 "* ]]; }
ci_kvm() { has_ci_role "$1" kvm; }
ci_service() { case $1 in test) echo ci ;; *) echo "ci-$1" ;; esac; }
# The CI registrars of a project and their Docker engines (one pair per role, see compose.ci.yml).
ci_registrars() { local r; for r in $(ci_roles "$1"); do ci_service "$r"; done; }
ci_engine() { case $1 in ci) echo ci-docker ;; *) echo "ci-docker-${1#ci-}" ;; esac; }
ci_role() { case $1 in ci) echo test ;; *) echo "${1#ci-}" ;; esac; }
runner_exec() {
  local slug=$1; shift
  ! ci_only || die "'$slug' is a CI-only host here: run this on the main ADLC host"
  compose "$slug" exec runner "$@"
}
# Remove the registrar and engine of CI roles this host no longer runs (compose leaves services of
# inactive profiles running). A job running there is stopped; GitHub fails it.
drop_disabled_ci() {
  local slug=$1 r c
  for r in test publish kvm; do
    has_ci_role "$slug" "$r" && continue
    for c in "$(ci_service "$r")" "$(ci_engine "$(ci_service "$r")")"; do
      # docker rm -f succeeds for missing containers too: only report what existed.
      docker container inspect "adlc-$slug-$c-1" >/dev/null 2>&1 || continue
      docker rm -f "adlc-$slug-$c-1" >/dev/null 2>&1 && ok "CI role $r is off on this host: removed $c"
    done
  done
  return 0
}
ci_enabled() { [ -s "$ADLC_ROOT/secrets/$1/ci_admin_pat" ]; }

default_domain() {
  local ip
  ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  if [ -n "$ip" ]; then echo "${ip//./-}.nip.io"; else echo "lan"; fi
}

next_subnet() {
  local k
  for k in $(seq 10 250); do
    grep -qs "^ADLC_SUBNET_PREFIX=172.31.$k$" "$ADLC_ROOT"/config/*.env || { echo "172.31.$k"; return; }
  done
  die "no free subnet"
}

# ── commands ──────────────────────────────────────────────────────────────────
cmd_doctor() {
  say "ADLC doctor (ADLC_ROOT=$ADLC_ROOT)"
  command -v docker >/dev/null && docker info >/dev/null 2>&1 && ok "docker reachable" || bad "docker not reachable"
  docker compose version >/dev/null 2>&1 && ok "docker compose v2" || bad "docker compose plugin missing"
  [ "$(uname -m)" = x86_64 ] && ok "x86_64 host" || warn "$(uname -m) host: the react-native stack layer (Android tools) needs x86_64"
  [ -e /dev/kvm ] && ok "/dev/kvm present (Android emulator)" || warn "/dev/kvm missing: no Android emulator; Android e2e only in CI"
  has_sysbox && ok "sysbox runtime available (hardened DinD)" || warn "sysbox not installed: DinD runs privileged (see docs)"
  if [ -d "$ADLC_ROOT" ] && [ -w "$ADLC_ROOT" ]; then ok "$ADLC_ROOT writable by $(id -un)"; else bad "$ADLC_ROOT missing or not writable (sudo mkdir -p $ADLC_ROOT && sudo chown $(id -un): $ADLC_ROOT)"; fi
  [ "$(id -u)" != 0 ] && ok "not running as root" || bad "run adlc as the non-root owner of $ADLC_ROOT"
  local eport; eport=$(edge_port)
  if docker ps --format '{{.Names}}' | grep -qx adlc-edge-traefik-1; then ok "edge proxy running on port $eport"
  elif command -v ss >/dev/null && [ "$(ss -Hltn "sport = :$eport" 2>/dev/null | wc -l)" -gt 0 ]; then
    bad "port $eport is in use by something else: use 'adlc up <slug> --edge-port 8088' (see: sudo ss -ltnp 'sport = :$eport')"
  else ok "port $eport free for the edge proxy"; fi
  local free; free=$(df -Pk "$ADLC_ROOT" 2>/dev/null | awk 'NR==2{print int($4/1048576)}')
  [ "${free:-0}" -ge 50 ] && ok "${free}GB free" || warn "${free:-?}GB free (50GB+ recommended)"
  local f slug
  for f in "$ADLC_ROOT"/config/*.env; do
    [ -e "$f" ] || continue
    slug=$(basename "$f" .env)
    if grep -qs '^ADLC_CI_ONLY=1$' "$f"; then
      ci_enabled "$slug" && ok "$slug: CI-only host" || bad "$slug: CI-only host without ci_admin_pat (adlc secrets $slug)"
      doctor_ci "$slug"
      doctor_image "$slug"
      continue
    fi
    if [ -s "$ADLC_ROOT/secrets/$slug/gh_app_key" ]; then ok "$slug: agents act as the ADLC GitHub App"
    elif [ -s "$ADLC_ROOT/secrets/$slug/gh_pat" ]; then warn "$slug: agents act as your account via gh_pat (prefer: adlc app $slug …)"
    else bad "$slug: no GitHub credentials for agents (adlc app $slug … or adlc secrets $slug)"; fi
    [ -s "$ADLC_ROOT/secrets/$slug/claude_oauth_token" ] && ok "$slug: secret claude_oauth_token" || bad "$slug: secret claude_oauth_token missing (adlc secrets $slug)"
    ci_enabled "$slug" && doctor_ci "$slug" || warn "$slug: CI runner disabled (no ci_admin_pat)"
    doctor_image "$slug"
  done
}
doctor_ci() { # roles and slots (CI capacity) on this host, and whether the running registrars use them
  (load_cfg "$1"; local roles slots kw svc c have
   roles=$(ci_roles "$1" | paste -sd, -); slots=${ADLC_CI_SLOTS:-2}; kw=${ADLC_CI_WEIGHT_KVM:-2}
   [ -n "$roles" ] || { warn "$1: no CI roles on this host"; return 0; }
   ok "$1: CI roles $roles, $slots slot(s) on $(nproc 2>/dev/null || echo ?) CPUs$(ci_kvm "$1" && echo ", an Android job takes $kw")"
   if ci_kvm "$1" && has_ci_role "$1" test && [ "$slots" -lt $((kw + 1)) ]; then
     warn "$1: the test runner stops while an Android job runs ($slots slots): ADLC_CI_SLOTS=$((kw + 1)) in $(cfg_file "$1"), then adlc up $1"
   fi
   for svc in $(ci_registrars "$1"); do
     c=$(compose "$1" ps -q "$svc" 2>/dev/null | head -1); [ -n "$c" ] || continue
     have=$(docker inspect "$c" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | sed -n 's/^ADLC_CI_SLOTS=//p')
     [ "${have:-2}" = "$slots" ] || { warn "$1: the CI registrars run with ${have:-2} slot(s), the config says $slots: adlc up $1"; break; }
   done)
}
doctor_image() { # in a subshell: load_cfg sets this project's variables
  (load_cfg "$1"; local stale; stale=$(runner_stale "$1")
   if [ -n "$stale" ]; then warn "$1: runner out of date ($stale): adlc up $1"; else ok "$1: runner runs this checkout's scripts"; fi)
}

cmd_secrets() {
  local slug=$1 dir="$ADLC_ROOT/secrets/$1" v
  need_slug "$slug"; mkdir -p "$dir"; chmod 700 "$dir"
  say "Secrets for '$slug' are stored in $dir (mode 600). Press Enter to keep an existing value."
  say "  gh_pat:             (only without the ADLC GitHub App; see 'adlc app') FINE-GRAINED token, only this repo. Read/write: Contents, Issues, Pull requests, Workflows."
  say "                      Read: Actions, Commit statuses, Metadata. Nothing else (no Administration/Secrets)."
  say "  claude_oauth_token: output of 'claude setup-token' (unattended runs). One string starting with sk-ant-oat"
  say "  ci_admin_pat:       FINE-GRAINED token, only this repo, Administration: read/write (registers ephemeral CI"
  say "                      runners; held only by the CI registrar, never by agents or jobs). Optional: empty = no CI runner"
  say "                      On a CI-only host also Contents: read (the egress proxy's adlc.yaml); the other secrets stay empty there"
  say "  registry_token:     PULL credential for the dev deployer: Harbor robot secret (pull only), or a classic"
  say "                      GitHub token with read:packages for GHCR. Optional until CI publishes images"
  say "  Long tokens may wrap when copied: whitespace is removed automatically."
  local -A prefix=([gh_pat]=github_pat_ [claude_oauth_token]=sk-ant-oat [ci_admin_pat]=github_pat_ [registry_token]="")
  for s in gh_pat claude_oauth_token ci_admin_pat registry_token; do
    read -r -s -p "$s: " v; echo
    v=$(tr -d '[:space:]' <<<"$v")
    if [ -n "$v" ]; then
      (umask 077; printf '%s' "$v" >"$dir/$s"); ok "$s saved (${#v} chars)"
      [[ "$v" == "${prefix[$s]}"* ]] || warn "$s doesn't start with '${prefix[$s]}': check it's the right token and wasn't cut by a line wrap"
    elif [ ! -e "$dir/$s" ]; then (umask 077; : >"$dir/$s"); warn "$s left empty"; fi
  done
}

cmd_up() {
  local slug=$1; shift; need_slug "$slug"
  local repo="" domain="" stacks="" dind="" reg="" reg_user="" reg_ca="" edge_port="" ci_kvm="" ci_roles_opt="" ci_host="" only=0 force=0 runs
  while [ $# -gt 0 ]; do
    case $1 in
      --force) force=1; shift ;;
      --repo) repo=$2; shift 2 ;;
      --domain) domain=$2; shift 2 ;;
      --stacks) stacks=$2; shift 2 ;;
      --dind) dind=$2; shift 2 ;;
      --registry) reg=$2; shift 2 ;;
      --registry-user) reg_user=$2; shift 2 ;;
      --registry-ca) reg_ca=$2; shift 2 ;;
      --edge-port) edge_port=$2; shift 2 ;;
      --ci-kvm) ci_kvm=$2; shift 2 ;;
      --ci-roles) ci_roles_opt=$2; shift 2 ;;
      --ci-only) only=1; shift ;;
      --ci-host) ci_host=$2; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  # Recreating the runner (a new image or settings) stops a delivery run in it, like adlc restart.
  runs=$(find "$ADLC_ROOT/projects/$slug/state/running" -name '*.pid' 2>/dev/null | sed 's#.*/##; s#\.pid##' | tr '\n' ' ' || true)
  if [ -n "$runs" ] && [ "$force" = 0 ]; then
    die "delivery runs in progress: $runs(updating may restart the runner and stop them). Wait, or: adlc pause $slug, then retry; --force updates anyway"
  fi
  [ "$(id -u)" != 0 ] || die "run as the non-root owner of $ADLC_ROOT"
  local f; f=$(cfg_file "$slug")
  if [ "$only" = 1 ] || grep -qs '^ADLC_CI_ONLY=1$' "$f"; then
    [ -f "$f" ] && ! grep -qs '^ADLC_CI_ONLY=1$' "$f" && die "'$slug' already runs here as a full project; --ci-only is for a second machine"
    up_ci_only "$slug" "$repo" "$ci_roles_opt" "$ci_host" "$dind" "$reg" "$reg_ca" "$ci_kvm"
    return
  fi
  [ -z "$ci_host" ] || die "--ci-host is only for a CI-only host (--ci-only)"
  mkdir -p "$ADLC_ROOT"/{config,cache,edge/dynamic} "$ADLC_ROOT/projects/$slug"/{repo,runs,state,sessions,logs/egress} \
           "$ADLC_ROOT/ui/requests/$slug"
  if [ ! -f "$f" ]; then
    [ -n "$repo" ] || die "first start needs --repo owner/name"
    set_cfg "$f" ADLC_SLUG "$slug"
    set_cfg "$f" ADLC_SUBNET_PREFIX "$(next_subnet)"
  fi
  grep -q '^ADLC_CI_SUBNET_PREFIX=' "$f" \
    || set_cfg "$f" ADLC_CI_SUBNET_PREFIX "$(grep '^ADLC_SUBNET_PREFIX=' "$f" | cut -d= -f2 | sed 's/^172\.31\./172.30./')"
  [ -n "$reg" ] && set_cfg "$f" ADLC_REGISTRY_HOST "$reg"
  if [ -n "$reg_user" ]; then
    [[ "$reg_user" == robot-* ]] && warn "registry user '$reg_user' looks like 'robot\$…' lost its '\$' to shell expansion. Quote it: --registry-user 'robot\$name'"
    set_cfg "$f" ADLC_REGISTRY_USER "'$reg_user'"
  fi
  if [ -n "$reg_ca" ]; then
    [ -f "$reg_ca" ] || die "CA file '$reg_ca' not found"
    cp "$reg_ca" "$ADLC_ROOT/config/$slug-registry-ca.crt"
    set_cfg "$f" ADLC_REGISTRY_CA "$ADLC_ROOT/config/$slug-registry-ca.crt"
  fi
  [ -n "$repo" ] && set_cfg "$f" ADLC_REPO "$repo"
  grep -q '^ADLC_BASE_DOMAIN=' "$f" || set_cfg "$f" ADLC_BASE_DOMAIN "${domain:-$(default_domain)}"
  [ -n "$domain" ] && set_cfg "$f" ADLC_BASE_DOMAIN "$domain"
  if [ -n "$dind" ]; then set_cfg "$f" ADLC_DIND_MODE "$dind"
  elif ! grep -q '^ADLC_DIND_MODE=' "$f"; then has_sysbox && set_cfg "$f" ADLC_DIND_MODE sysbox || set_cfg "$f" ADLC_DIND_MODE privileged; fi
  set_ci_roles "$f" "$ci_roles_opt" "$ci_kvm"
  set_cfg "$f" ADLC_ROOT "$ADLC_ROOT"
  set_cfg "$f" ADLC_HOME "$ADLC_HOME"
  set_cfg "$f" ADLC_RUNNER_IMAGE "adlc/runner-$slug:local"
  load_cfg "$slug"
  for s in gh_pat claude_oauth_token ci_admin_pat registry_token; do
    [ -e "$ADLC_ROOT/secrets/$slug/$s" ] || die "secret $s missing: run 'adlc secrets $slug' first"
  done
  [ -e "$ADLC_ROOT/secrets/$slug/gh_app_key" ] || (umask 077; : >"$ADLC_ROOT/secrets/$slug/gh_app_key")
  if [ ! -s "$ADLC_ROOT/secrets/$slug/gh_app_key" ] && [ ! -s "$ADLC_ROOT/secrets/$slug/gh_pat" ]; then
    die "no GitHub credentials for agents: run 'adlc app $slug --id <app-id> --key <file.pem>' (recommended) or set gh_pat with 'adlc secrets $slug'"
  fi

  # Runner image: base + stack layers.
  say "Building runner image…"
  docker build -q -t adlc/runner-base:local --label "adlc.runner-src=$(runner_src)" \
    --build-arg ADLC_UID="$(id -u)" --build-arg ADLC_GID="$(id -g)" "$SANDBOX/runner" >/dev/null
  if [ -z "$stacks" ] && [ -f "$ADLC_ROOT/projects/$slug/repo/adlc.yaml" ]; then
    stacks=$(docker run --rm --entrypoint yq -v "$ADLC_ROOT/projects/$slug/repo/adlc.yaml:/a.yaml:ro" \
               adlc/runner-base:local -r '.stacks // [] | join(",")' /a.yaml 2>/dev/null || true)
  fi
  local img=adlc/runner-base:local s
  for s in ${stacks//,/ }; do
    [ -f "$SANDBOX/runner/stacks/$s.Dockerfile" ] || continue
    say "  + stack layer $s"
    docker build -q -t "adlc/runner-$slug-$s:local" --build-arg BASE="$img" \
      -f "$SANDBOX/runner/stacks/$s.Dockerfile" "$SANDBOX/runner" >/dev/null
    img="adlc/runner-$slug-$s:local"
  done
  docker tag "$img" "$ADLC_RUNNER_IMAGE"

  # Edge proxy (shared) and this project's route. A busy port must not block the project itself.
  [ -n "$edge_port" ] && set_cfg "$(edge_cfg)" ADLC_EDGE_PORT "$edge_port"
  local eport; eport=$(edge_port)
  set_cfg "$f" ADLC_EDGE_PORT "$eport"
  if ! ADLC_ROOT=$ADLC_ROOT ADLC_EDGE_PORT=$eport docker compose -f "$SANDBOX/edge/compose.yml" up -d --quiet-pull >/dev/null 2>"$ADLC_ROOT/edge/up.err"; then
    warn "edge proxy could not start on port $eport ($(grep -oE 'address already in use|port is already allocated' "$ADLC_ROOT/edge/up.err" | head -1 || echo "see $ADLC_ROOT/edge/up.err")). Preview URLs are unavailable."
    warn "fix: adlc up $slug --edge-port 8088   (or free port $eport)"
  fi
  local esc; esc=$(sed 's/\./\\./g' <<<"$slug.$ADLC_BASE_DOMAIN")
  cat >"$ADLC_ROOT/edge/dynamic/$slug.yml" <<EOF
http:
  routers:
    $slug:
      rule: 'HostRegexp(\`^.+\.$esc$\`)'
      entryPoints: [web]
      service: $slug
  services:
    $slug:
      loadBalancer:
        servers:
          - url: "http://adlc-$slug-docker:80"
EOF

  compose "$slug" up -d --build --remove-orphans
  drop_disabled_ci "$slug"
  host_housekeep
  say ""
  say "Runner for '$slug' is starting. Next:"
  [ -e "$ADLC_ROOT/projects/$slug/state/logged_in" ] \
    || say "  adlc login $slug        (one-time Claude login for Remote Control)"
  local suffix=""; [ "$eport" = 80 ] || suffix=":$eport"
  say "  (the runner is only recreated when its image or settings change; to load plugin updates: adlc restart $slug)"
  say "  adlc status $slug       ·  previews: http://<run>.app.$slug.$ADLC_BASE_DOMAIN$suffix"
}

# --ci-roles <a,b|none> and --ci-kvm on|off → ADLC_CI_ROLES (and ADLC_CI_KVM, read by older code paths).
set_ci_roles() { # set_ci_roles <cfg file> <roles option> <kvm option>
  local f=$1 opt=$2 kvm=$3 cur x out=""
  # shellcheck disable=SC1090
  cur=$( (set -a; source "$f"; set +a; echo "${ADLC_CI_ROLES:-test,publish$([ "${ADLC_CI_KVM:-0}" = 1 ] && echo ,kvm)}") )
  if [ -n "$opt" ]; then
    [ "$opt" = none ] && opt=""
    for x in ${opt//,/ }; do
      case $x in test|publish) ;; kvm) [ -e /dev/kvm ] || die "--ci-roles kvm: /dev/kvm doesn't exist on this host" ;;
        *) die "--ci-roles takes test, publish, kvm (comma-separated) or none" ;; esac
    done
    cur=$opt
  fi
  case $kvm in
    "") ;;
    on) [ -e /dev/kvm ] || die "--ci-kvm on: /dev/kvm doesn't exist on this host"; cur="$cur,kvm" ;;
    off) cur=${cur//kvm/} ;;
    *) die "--ci-kvm takes on or off" ;;
  esac
  for x in test publish kvm; do [[ ",$cur," == *",$x,"* ]] && out="$out${out:+,}$x"; done
  set_cfg "$f" ADLC_CI_ROLES "${out:-none}"
  set_cfg "$f" ADLC_CI_KVM "$([[ ",$out," == *",kvm,"* ]] && echo 1 || echo 0)"
}

# A second machine that only runs CI runners for the project (compose.ci-host.yml): registrars, their
# engines and an egress proxy. Agents, deployer, edge proxy and dashboard stay on the main host.
up_ci_only() { # up_ci_only <slug> <repo> <roles> <host> <dind> <registry> <registry ca> <kvm option>
  local slug=$1 repo=$2 roles=$3 host=$4 dind=$5 reg=$6 reg_ca=$7 kvm=$8 f
  f=$(cfg_file "$slug")
  mkdir -p "$ADLC_ROOT"/{config,cache} "$ADLC_ROOT/projects/$slug"/{repo,logs/egress}
  if [ ! -f "$f" ]; then
    [ -n "$repo" ] || die "first start needs --repo owner/name"
    [ -n "$roles" ] || die "first start needs --ci-roles (e.g. kvm, or test,kvm): the roles this host takes over"
    set_cfg "$f" ADLC_SLUG "$slug"
    set_cfg "$f" ADLC_CI_ONLY 1
    set_cfg "$f" ADLC_SUBNET_PREFIX "$(next_subnet)"
  fi
  grep -q '^ADLC_CI_SUBNET_PREFIX=' "$f" \
    || set_cfg "$f" ADLC_CI_SUBNET_PREFIX "$(grep '^ADLC_SUBNET_PREFIX=' "$f" | cut -d= -f2 | sed 's/^172\.31\./172.30./')"
  [ -n "$repo" ] && set_cfg "$f" ADLC_REPO "$repo"
  if [ -n "$host" ] || ! grep -q '^ADLC_CI_HOST=' "$f"; then
    host=${host:-$(hostname -s | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9' | cut -c1-12)}
    [[ "$host" =~ ^[a-z0-9]{1,12}$ ]] || die "--ci-host: 1-12 lowercase letters or digits"
    case $host in test|publish|kvm) die "--ci-host can't be a role name" ;; esac
    set_cfg "$f" ADLC_CI_HOST "$host"
  fi
  [ -n "$reg" ] && set_cfg "$f" ADLC_REGISTRY_HOST "$reg"
  if [ -n "$reg_ca" ]; then
    [ -f "$reg_ca" ] || die "CA file '$reg_ca' not found"
    cp "$reg_ca" "$ADLC_ROOT/config/$slug-registry-ca.crt"
    set_cfg "$f" ADLC_REGISTRY_CA "$ADLC_ROOT/config/$slug-registry-ca.crt"
  fi
  if [ -n "$dind" ]; then set_cfg "$f" ADLC_DIND_MODE "$dind"
  elif ! grep -q '^ADLC_DIND_MODE=' "$f"; then has_sysbox && set_cfg "$f" ADLC_DIND_MODE sysbox || set_cfg "$f" ADLC_DIND_MODE privileged; fi
  set_ci_roles "$f" "$roles" "$kvm"
  set_cfg "$f" ADLC_ROOT "$ADLC_ROOT"
  set_cfg "$f" ADLC_HOME "$ADLC_HOME"
  # The registrars run in the plain base image (no stack layers: they run no project code).
  set_cfg "$f" ADLC_RUNNER_IMAGE adlc/runner-base:local
  load_cfg "$slug"
  ci_enabled "$slug" || die "secret ci_admin_pat missing: run 'adlc secrets $slug' (only ci_admin_pat is needed on a CI-only host; leave the others empty)"
  [ -n "$(ci_roles "$slug")" ] || warn "no CI roles on this host (--ci-roles none): nothing runs here"

  say "Building the registrar image…"
  docker build -q -t adlc/runner-base:local --label "adlc.runner-src=$(runner_src)" \
    --build-arg ADLC_UID="$(id -u)" --build-arg ADLC_GID="$(id -g)" "$SANDBOX/runner" >/dev/null
  compose "$slug" up -d --build --remove-orphans
  drop_disabled_ci "$slug"
  host_housekeep
  say ""
  say "CI-only host '$ADLC_CI_HOST' for '$slug' ($ADLC_REPO): roles $(ci_roles "$slug" | paste -sd, -). Next:"
  say "  adlc logs $slug ci       registrars: each says 'runner … waiting for a job'"
  say "  on the main ADLC host: adlc up $slug --ci-roles <the roles it keeps>   (e.g. test,publish without kvm)"
}

cmd_app() {
  local slug=${1:-}; need_slug "$slug"; shift
  local id="" key=""
  while [ $# -gt 0 ]; do
    case $1 in --id) id=$2; shift 2 ;; --key) key=$2; shift 2 ;; *) die "unknown option $1" ;; esac
  done
  [[ "$id" =~ ^[0-9]+$ ]] || die "--id <numeric App ID> is required (GitHub → Settings → Developer settings → GitHub Apps → your app)"
  [ -f "$key" ] && grep -q 'PRIVATE KEY' "$key" || die "--key must be the app's .pem private key file"
  local dir="$ADLC_ROOT/secrets/$slug"; mkdir -p "$dir"; chmod 700 "$dir"
  (umask 077; cp "$key" "$dir/gh_app_key")
  set_cfg "$(cfg_file "$slug")" ADLC_GH_APP_ID "$id"
  ok "GitHub App $id configured for $slug (key stored in $dir/gh_app_key)"
  say "Delete the downloaded .pem from other places once it's stored here. Then: adlc up $slug"
}

cmd_restart() {
  local slug=${1:-}; need_slug "$slug"; load_cfg "$slug"
  local stale; stale=$(runner_stale "$slug")
  if [ -n "$stale" ]; then
    warn "the runner image is out of date ($stale): a restart reloads only the plugins"
    if ci_only; then warn "to load the new ADLC scripts: adlc up $slug"
    else warn "to load the new ADLC scripts: adlc pause $slug, wait until no delivery runs, adlc up $slug, adlc resume $slug"; fi
  fi
  if ci_only; then
    # shellcheck disable=SC2046  # one service per word
    compose "$slug" restart $(ci_registrars "$slug"); ok "CI registrars restarted (an idle runner is replaced; running jobs continue)"
    return
  fi
  local runs; runs=$(find "$ADLC_ROOT/projects/$slug/state/running" -name '*.pid' 2>/dev/null | sed 's#.*/##; s#\.pid##' | tr '\n' ' ' || true)
  if [ -n "$runs" ] && [ "${2:-}" != --force ]; then
    die "delivery runs in progress: $runs(a restart stops them). Wait, or: adlc pause $slug, then retry; --force restarts anyway"
  fi
  compose "$slug" restart runner
  ok "runner restarted: plugins update and Remote Control comes back within a minute (open sessions reconnect in the app)"
}

# ── Disk ─────────────────────────────────────────────────────────────────────
disk_line() { df -Pk "$ADLC_ROOT" 2>/dev/null | awk 'NR==2 { printf "%dGB free of %dGB (%s used)", $4/1048576, $2/1048576, $5 }'; }
disk_used_pct() { df -Pk "$ADLC_ROOT" 2>/dev/null | awk 'NR==2 { sub(/%/, "", $5); print $5 }'; }
# `docker system df` of one engine as one line: images, build cache, volumes (size, reclaimable).
DF_FMT='{{.Type}}|{{.Size}}|{{.Reclaimable}}'
usage_fmt() {
  awk -F'|' '$1 != "Containers" { sub(/ .*/, "", $3); printf "%s%s %s (%s reclaimable)", sep, tolower($1), $2, $3; sep=" · " } END { print "" }'
}
host_build_cache_cap() {
  local cap=${ADLC_HOST_BUILD_CACHE:-4GB}
  if docker builder prune --help 2>/dev/null | grep -q -- --reserved-space; then docker builder prune -f --reserved-space "$cap" >/dev/null 2>&1 || true
  else docker builder prune -f --keep-storage "$cap" >/dev/null 2>&1 || true; fi
}
# After builds: old ADLC images (replaced by a rebuild, now untagged) and the host build cache cap.
host_housekeep() {
  docker image prune -f --filter label=org.adlc.managed=true >/dev/null 2>&1 || true
  host_build_cache_cap
}
cmd_prune() {
  local f slug before r
  # A project's settings (e.g. ADLC_HOST_BUILD_CACHE) apply to the host part too.
  if [ -n "${1:-}" ]; then need_slug "$1"; load_cfg "$1"; fi
  before=$(disk_line)
  say "Freeing disk (before: $before)…"
  # Host: every untagged image (old builds of anything), then the build cache cap.
  docker image prune -f >/dev/null 2>&1 || true
  host_build_cache_cap
  ok "host: untagged images removed, build cache capped at ${ADLC_HOST_BUILD_CACHE:-4GB}"
  for f in "$ADLC_ROOT"/config/*.env; do
    [ -e "$f" ] || continue
    slug=$(basename "$f" .env)
    [ -n "${1:-}" ] && [ "$1" != "$slug" ] && continue
    load_cfg "$slug"
    if ci_only; then :
    elif runner_exec "$slug" adlc-housekeep >/dev/null 2>&1; then ok "$slug: finished runs' images, untagged images and build cache pruned"
    else warn "$slug: runner not reachable; skipped its Docker sidecar"; fi
    # Each CI engine, with the same rule as its registrar's after-job cleanup, run from the registrar
    # (it has adlc-lib and the engine's address): compose-built images idle 1h+ (not one a running job
    # just built), others idle ADLC_CI_IMAGE_MAX_IDLE_H, the build cache cap. Runner images and the
    # registrar's ADLC_KEEP_IMAGES (the emulator, on the kvm engine) stay.
    for r in $(ci_registrars "$slug"); do
      # shellcheck disable=SC2016  # expanded inside the container
      compose "$slug" exec -T "$r" bash -c 'source /usr/local/bin/adlc-lib.sh
        ADLC_BUILT_IMAGE_MAX_IDLE_H=1 ADLC_IMAGE_MAX_IDLE_H=${ADLC_CI_IMAGE_MAX_IDLE_H:-24} \
          prune_finished_runs "adlc/ci-runner:local ${ADLC_CI_RUNNER_IMAGE:-ghcr.io/actions/actions-runner:latest}"
        docker image prune -f; prune_build_cache "${ADLC_CI_BUILD_CACHE_KEEP:-4GB}"' >/dev/null 2>&1 \
        && ok "$slug: CI engine ($r): job images and idle images removed, build cache capped" || warn "$slug: CI engine ($r) not reachable; skipped"
    done
  done
  say "Done: $(disk_line)"
}

# ── Dashboard ────────────────────────────────────────────────────────────────
edge_get() { [ -f "$(edge_cfg)" ] && grep "^$1=" "$(edge_cfg)" | cut -d= -f2- || true; }
ui_compose() {
  ADLC_ROOT=$ADLC_ROOT ADLC_UID=$(id -u) ADLC_GID=$(id -g) ADLC_UI_HOSTS=$(edge_get ADLC_UI_HOSTS) \
    ADLC_HOST_NAME=$(hostname -s | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9-' | cut -c1-32) \
    docker compose -f "$ADLC_HOME/ui/compose.yml" "$@"
}
ui_host() {
  local h base="" f
  h=$(edge_get ADLC_UI_HOST); [ -n "$h" ] && { echo "$h"; return; }
  for f in "$ADLC_ROOT"/config/*.env; do
    [ -e "$f" ] || continue
    base=$(grep '^ADLC_BASE_DOMAIN=' "$f" | cut -d= -f2); [ -n "$base" ] && break
  done
  echo "adlc.${base:-$(default_domain)}"
}
new_token() { (umask 077; head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n' >"$1"); }
cmd_ui() {
  local sub=${1:-up}; shift || true
  local tokf="$ADLC_ROOT/ui/token" route="$ADLC_ROOT/edge/dynamic/adlc-ui.yml"
  case $sub in
    up)
      local hosts; hosts=$(edge_get ADLC_UI_HOSTS)
      while [ $# -gt 0 ]; do
        case $1 in
          --host) [[ "${2:-}" =~ ^[A-Za-z0-9.-]+$ ]] || die "invalid host '${2:-}'"
                  [[ ",$hosts," == *",$2,"* ]] || hosts=${hosts:+$hosts,}$2; shift 2 ;;
          *) die "unknown option $1" ;;
        esac
      done
      [ "$(id -u)" != 0 ] || die "run as the non-root owner of $ADLC_ROOT"
      docker network inspect adlc-edge >/dev/null 2>&1 || die "the edge proxy isn't running yet: start a project first (adlc up <slug>)"
      mkdir -p "$ADLC_ROOT/ui/requests" "$ADLC_ROOT/ui/hosts" "$ADLC_ROOT/edge/dynamic"; chmod 700 "$ADLC_ROOT/ui"
      [ -s "$tokf" ] || { new_token "$tokf"; ok "login token created"; }
      set_cfg "$(edge_cfg)" ADLC_UI_HOSTS "$hosts"
      local host rule h; host=$(ui_host); rule="Host(\`$host\`)"
      for h in ${hosts//,/ }; do rule="$rule || Host(\`$h\`)"; done
      printf '%s\n' "http:" "  routers:" "    adlc-ui:" "      rule: '$rule'" "      entryPoints: [web]" "      service: adlc-ui" \
        "  services:" "    adlc-ui:" "      loadBalancer:" "        servers:" '          - url: "http://adlc-ui:8080"' >"$route"
      say "Building and starting the dashboard…"
      ui_compose up -d --build --quiet-pull >/dev/null
      host_housekeep
      local suffix=""; [ "$(edge_port)" = 80 ] || suffix=":$(edge_port)"
      ok "dashboard: http://$host$suffix"
      [ -z "$hosts" ] || say "  also answers to: $hosts (through your reverse proxy; serve it over HTTPS there)"
      say "  sign in with the token from: adlc ui token"
      ;;
    token)
      if [ "${1:-}" = --rotate ]; then new_token "$tokf"; ok "token rotated: every browser has to sign in again"; fi
      [ -s "$tokf" ] || die "no dashboard yet: adlc ui up"
      cat "$tokf"; echo ;;
    host-token)
      local n=${1:-} hf; [[ "$n" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] \
        || die "usage: adlc ui host-token <name> [--rotate|--remove]   (the CI-only host's name in its runner names, e.g. ci2)"
      [ -d "$ADLC_ROOT/ui" ] || die "no dashboard yet: adlc ui up"
      mkdir -p "$ADLC_ROOT/ui/hosts"; hf="$ADLC_ROOT/ui/hosts/$n.token"
      case ${2:-} in
        --remove) rm -f "$hf" "$ADLC_ROOT/ui/hosts/$n.json"; ok "'$n' no longer reports to the dashboard"; return ;;
        --rotate) new_token "$hf"; ok "token for '$n' rotated: run adlc ui report on that host again" ;;
        "") [ -s "$hf" ] || { new_token "$hf"; ok "token for '$n' created"; } ;;
        *) die "unknown option $2" ;;
      esac
      cat "$hf"; echo
      local sfx=""; [ "$(edge_port)" = 80 ] || sfx=":$(edge_port)"
      say "  on '$n': adlc ui report http://$(ui_host)$sfx   (paste this token when asked)" ;;
    report)
      local url=${1:-} f s="" t tf="$ADLC_ROOT/config/dashboard-token"
      [[ "$url" =~ ^https?://[A-Za-z0-9.-]+(:[0-9]+)?/?$ ]] || die "usage: adlc ui report <dashboard url>   (e.g. http://adlc.example.lan:8088)"
      # One reporter per machine: on the first CI-only project here (each one's ADLC_CI_HOST names this host).
      for f in "$ADLC_ROOT"/config/*.env; do grep -qs '^ADLC_CI_ONLY=1$' "$f" && { s=$(basename "$f" .env); break; }; done
      [ -n "$s" ] || die "no CI-only project on this host: the main host's dashboard samples its own host"
      local name; name=$(grep '^ADLC_CI_HOST=' "$(cfg_file "$s")" | cut -d= -f2)
      docker run --rm --entrypoint sh adlc/runner-base:local -c 'command -v adlc-hoststats' >/dev/null 2>&1 \
        || die "this host's runner image predates the reporter: adlc up $s first"
      curl -fsS -m 5 "${url%/}/healthz" >/dev/null || die "can't reach the dashboard at $url from here"
      say "This host reports as '$name'. On the main host: adlc ui host-token $name"
      read -rsp "Token: " t; echo
      [[ "$t" =~ ^[0-9a-f]{48}$ ]] || die "that isn't a host token"
      (umask 077; printf '%s\n' "$t" >"$tf")
      set_cfg "$(cfg_file "$s")" ADLC_DASHBOARD_URL "${url%/}"
      (load_cfg "$s"; compose "$s" up -d hoststats)
      ok "reporting CPU, memory and disk to $url every 30 s (adlc logs $s hoststats)" ;;
    down) ui_compose down; rm -f "$route"; ok "dashboard stopped" ;;
    status)
      docker ps --filter name=adlc-ui --format '{{.Names}}  {{.Status}}'
      local sfx=""; [ "$(edge_port)" = 80 ] || sfx=":$(edge_port)"
      say "  url: http://$(ui_host)$sfx" ;;
    *) die "usage: adlc ui [up [--host name]…|down|token [--rotate]|host-token <name> [--rotate|--remove]|report <url>|status]" ;;
  esac
}

cmd_down()   { need_slug "$1"; load_cfg "$1"; compose "$1" down; }
cmd_login()  { need_slug "$1"; load_cfg "$1"; runner_exec "$1" adlc-login; }
cmd_attach() { need_slug "$1"; load_cfg "$1"; runner_exec "$1" tmux attach -t adlc; }
cmd_session() { local slug=${1:-}; need_slug "$slug"; shift; load_cfg "$slug"; runner_exec "$slug" adlc-session "$@"; }
cmd_shell() {
  need_slug "${1:-}"; load_cfg "$1"
  # shellcheck disable=SC2016  # expanded inside the container
  runner_exec "$1" bash -c 'cd "$ADLC_ROOT/projects/$ADLC_SLUG"; exec bash -l'
}
cmd_train() { # adlc train <slug> [on|dry-run|off]: show or switch the merge train, live (no restart)
  need_slug "${1:-}"; local f="$ADLC_ROOT/projects/$1/state/settings/merge_train"
  case ${2:-} in
    on|dry-run|off) mkdir -p "$(dirname "$f")"; echo "$2" >"$f"; say "merge train: $2 (the poller picks it up within two minutes)" ;;
    "") say "merge train: $(cat "$f" 2>/dev/null || echo "not set here (adlc.yaml autonomy.merge_train, else dry-run)")" ;;
    *) die "usage: adlc train <slug> [on|dry-run|off]" ;;
  esac
}
cmd_pause()  { need_slug "$1"; touch "$ADLC_ROOT/projects/$1/state/paused"; say "paused: no new runs will start (running ones continue)"; }
cmd_resume() { need_slug "$1"; rm -f "$ADLC_ROOT/projects/$1/state/paused"; say "resumed"; }

cmd_status() {
  # adlc status [slug] [--all] [--disk]: --all lists the whole queue; --disk adds per-engine Docker usage
  # (docker system df measures every layer and volume: it can take minutes on a full disk).
  local f slug st n free a only="" qall="" disk=0 r
  for a in "$@"; do case $a in --all) qall=--all ;; --disk) disk=1 ;; -*) die "unknown option $a" ;; *) only=$a ;; esac; done
  set -- "$only" "$qall"
  free=$(df -Pk "$ADLC_ROOT" 2>/dev/null | awk 'NR==2 { print int($4 / 1048576) }')
  if [ "${free:-0}" -lt "${ADLC_MIN_FREE_GB:-15}" ]; then warn "disk: $(disk_line). Below ${ADLC_MIN_FREE_GB:-15}GB no new runs start: adlc prune"
  elif [ "$(disk_used_pct)" -ge "${ADLC_DISK_WARN_PCT:-75}" ]; then warn "disk: $(disk_line), above ${ADLC_DISK_WARN_PCT:-75}%. Free space: adlc prune"
  else say "disk: $(disk_line)"; fi
  [ "$disk" = 1 ] && say "  host Docker: $(timeout 120 docker system df --format "$DF_FMT" 2>/dev/null | usage_fmt)"
  for f in "$ADLC_ROOT"/config/*.env; do
    [ -e "$f" ] || { say "no projects"; return; }
    slug=$(basename "$f" .env)
    [ -n "${1:-}" ] && [ "$1" != "$slug" ] && continue
    load_cfg "$slug"
    if ci_only; then
      say "■ $slug  ($ADLC_REPO) · CI-only host '$ADLC_CI_HOST', roles: $(ci_roles "$slug" | paste -sd, -)"
      compose "$slug" ps --format '    {{.Service}}: {{.State}} {{.Status}}' 2>/dev/null || true
      if [ "$disk" = 1 ]; then
        for r in $(ci_registrars "$slug"); do
          say "    Docker (CI $(ci_role "$r")): $(compose "$slug" exec -T "$(ci_engine "$r")" timeout 120 docker system df --format "$DF_FMT" 2>/dev/null | usage_fmt)"
        done
      fi
      continue
    fi
    st="$ADLC_ROOT/projects/$slug/state"
    say "■ $slug  ($ADLC_REPO)"
    compose "$slug" ps --format '    {{.Service}}: {{.State}} {{.Status}}' 2>/dev/null || true
    [ -e "$st/paused" ] && say "    paused"
    [ -s "$st/backoff_until" ] && [ "$(date +%s)" -lt "$(cat "$st/backoff_until")" ] && say "    usage-limit backoff until $(date -d "@$(cat "$st/backoff_until")" 2>/dev/null || cat "$st/backoff_until")"
    n=$(find "$st/running" -name '*.pid' 2>/dev/null | sed 's#.*/##; s#\.pid##' | tr '\n' ' ')
    say "    active runs: ${n:-none}"
    [ -s "$st/dev_deployed" ] && say "    dev environment: $(cat "$st/dev_deployed")"
    if [ -s "$st/dev_missing_secrets.json" ]; then
      warn "    dev deploy of $(jq -r .tag "$st/dev_missing_secrets.json") waits for missing dev secret(s):"
      jq -r '.missing[] | "      \(.name)\(if .pr then " (added by PR #\(.pr))" else "" end): \(.hint)"' "$st/dev_missing_secrets.json" | while IFS= read -r l; do say "$l"; done
    fi
    if [ -s "$st/merge_train.json" ]; then
      jq -r '"    merge train (\(.mode)): " + (if (.prs | length) == 0 then "no approved PRs" else "" end),
             (.prs[] | "      PR #\(.pr) (#\(.issue)): \(.status) · \(.detail)")' "$st/merge_train.json" 2>/dev/null | sed '/^$/d' | while IFS= read -r l; do say "$l"; done
    fi
    if [ "$disk" = 1 ]; then
      say "    Docker (agents): $(runner_exec "$slug" timeout 120 docker system df --format "$DF_FMT" 2>/dev/null | usage_fmt)"
      for r in $(ci_registrars "$slug"); do
        say "    Docker (CI $(ci_role "$r")): $(compose "$slug" exec -T "$(ci_engine "$r")" timeout 120 docker system df --format "$DF_FMT" 2>/dev/null | usage_fmt)"
      done
    else
      [ -s "$st/docker_usage" ] && say "    Docker (agents, at last housekeeping): $(cat "$st/docker_usage")"
    fi
    [ -e "$st/logged_in" ] || say "    not logged in (adlc login $slug)"
    n=$(runner_exec "$slug" adlc-gh-token --identity 2>/dev/null | cut -f1) || n=""
    if [ -z "${ADLC_GH_APP_ID:-}" ]; then
      say "    agents act as: the gh_pat owner (no GitHub App: adlc app $slug --id … --key …)"
    elif [ -n "$n" ]; then
      say "    agents act as: $n (GitHub App $ADLC_GH_APP_ID)"
    else
      say "    agents act as: GitHub App $ADLC_GH_APP_ID, but its identity can not be resolved, so no runs start"
    fi
    queue "$slug" ${2:+"$2"}
  done
}

# The project's open work in order of precedence (owner tasks included), from inside the runner.
queue() { # queue <slug> [--all]
  local out
  out=$(runner_exec "$1" adlc-queue ${2:+"$2"} 2>&1) || { say "    queue: unavailable (${out:0:120})"; return 0; }
  sed 's/^/    /' <<<"$out"
}

cmd_logs() {
  local slug=$1 what=${2:-poller}; need_slug "$slug"
  local d="$ADLC_ROOT/projects/$slug/logs"
  case $what in
    poller|deployer|rc) tail -n 100 -f "$d/$what.log" ;;
    egress) tail -n 100 -f "$d/egress/access.log" ;;
    ci) load_cfg "$slug"
        # shellcheck disable=SC2046  # one service per word
        compose "$slug" logs -f --tail 100 $(ci_registrars "$slug") ;;
    hoststats) load_cfg "$slug"; compose "$slug" logs -f --tail 100 hoststats ;;
    run)
      [ -n "${3:-}" ] || die "usage: adlc logs <slug> run <issue>"
      local latest; latest=$(ls -t "$d/runs/$3"-*.jsonl 2>/dev/null | head -1)
      [ -n "$latest" ] || die "no run logs for #$3"
      say "── $latest (following; Ctrl-C to stop)"
      tail -n +1 -F "$latest" | jq --unbuffered -r 'if .type == "assistant" then (.message.content[]? | select(.type == "text") | "• " + .text)
             elif .type == "result" then "══ result: " + (.subtype // "") + " · cost $" + ((.total_cost_usd // 0) | tostring)
             else empty end' ;;
    *) die "unknown log '$what'" ;;
  esac
}

cmd_audit() {
  local slug=$1; need_slug "$slug"; load_cfg "$slug"
  local log="$ADLC_ROOT/projects/$slug/logs/egress/access.log" allowed
  [ -s "$log" ] || die "no egress log yet"
  allowed=$(compose "$slug" exec -T egress cat /etc/squid/adlc-allowed.txt 2>/dev/null || true)
  say "Domains reached through the egress proxy (count · domain · in allowlist?):"
  awk '{u=$4; sub(/^[a-z]+:\/\//,"",u); sub(/[:\/].*$/,"",u); print u}' "$log" | sort | uniq -c | sort -rn \
  | while read -r c d; do
      m=no
      while read -r a; do
        [ -n "$a" ] || continue
        if [ "${a:0:1}" = . ]; then [[ "$d" == *"$a" || "$d" == "${a:1}" ]] && m=yes; else [ "$d" = "$a" ] && m=yes; fi
      done <<<"$allowed"
      printf '%7s  %-50s %s\n' "$c" "$d" "$m"
    done
  say "Add missing ones to adlc.yaml → network.extra_domains (or the stack pack's list) before switching to allowlist."
}

main() {
  local c=${1:-help}; shift || true
  case $c in
    doctor) cmd_doctor ;;
    secrets) cmd_secrets "${1:-}" ;;
    up) cmd_up "$@" ;;
    down) cmd_down "${1:-}" ;;
    restart) cmd_restart "$@" ;;
    ui) cmd_ui "$@" ;;
    prune) cmd_prune "${1:-}" ;;
    login) cmd_login "${1:-}" ;;
    app) cmd_app "$@" ;;
    attach) cmd_attach "${1:-}" ;;
    session) cmd_session "$@" ;;
    shell) cmd_shell "${1:-}" ;;
    status) cmd_status "$@" ;;
    pause) cmd_pause "${1:-}" ;;
    train) cmd_train "${1:-}" "${2:-}" ;;
    resume) cmd_resume "${1:-}" ;;
    logs) cmd_logs "$@" ;;
    audit) cmd_audit "${1:-}" ;;
    help|-h|--help) sed -n '2,40p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$c' (adlc help)" ;;
  esac
}
main "$@"
