# apps/api/Dockerfile (build context: repo root). Targets: dev (watch) and prod.
FROM node:22-trixie-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
# Builds behind the ADLC egress proxy: Node's fetch (used by corepack to download pnpm) only
# honours HTTP(S)_PROXY with this set. The prod stage starts from a fresh image without it.
ENV NODE_USE_ENV_PROXY=1
# /nodejs/bin/node is where the distroless prod image keeps node: one healthcheck works for all targets.
RUN corepack enable && mkdir -p /nodejs/bin && ln -s "$(command -v node)" /nodejs/bin/node
WORKDIR /repo

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json apps/api/
COPY packages/contracts/package.json packages/contracts/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

FROM deps AS dev
# source is bind-mounted over /repo in watch mode
CMD ["pnpm", "--filter", "api", "exec", "tsx", "watch", "src/main.ts"]

FROM deps AS build
COPY . .
RUN pnpm --filter api build && pnpm --filter api deploy --prod /out

# Runtime: distroless Node (same Debian 13 glibc as the build stage, so native modules work). No
# shell, package manager, npm or corepack: far fewer CVEs, so the registry's vulnerability policy
# lets it be pulled. node is /nodejs/bin/node (the entrypoint); the user is nonroot (65532).
FROM gcr.io/distroless/nodejs22-debian13:nonroot AS prod
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=65532:65532 /out ./
USER 65532:65532
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["dist/main.js"]
