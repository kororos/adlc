# apps/<app>/Dockerfile (build context: repo root). Targets: dev (vite, source mounted) and prod (nginx).
# Replace <app> with the app folder (e.g. web) and list the workspace packages the app depends on.
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/<app>/package.json apps/<app>/
# one line per workspace package the app imports (manifests only, so the install layer stays cached)
COPY packages/contracts/package.json packages/contracts/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

FROM deps AS dev
# watch mode: the worktree is bind-mounted over /repo (node_modules come from the worktree install)
CMD ["pnpm", "--filter", "<app>", "exec", "vite"]

FROM deps AS build
COPY . .
RUN pnpm --filter <app> build

FROM nginxinc/nginx-unprivileged:1.29-alpine AS prod
# Runtime settings (nginx renders /etc/nginx/templates/*.template with these at start):
ENV WEB_API_BASE_PATH=/api \
    WEB_ENVIRONMENT=production \
    WEB_CSP="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
COPY apps/<app>/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /repo/apps/<app>/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
