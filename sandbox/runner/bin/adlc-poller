#!/usr/bin/env bash
# ADLC poller: promotes unblocked issues, launches unattended delivery runs (claude -p)
# in per-run git worktrees, handles rate limits, and cleans up after merges.
set -uo pipefail
ADLC_COMPONENT=poller
# shellcheck source=adlc-lib.sh
source /usr/local/bin/adlc-lib.sh

POLL_INTERVAL=${ADLC_POLL_INTERVAL:-60}
RUN_TIMEOUT=${ADLC_RUN_TIMEOUT:-4h}
# Unattended runs keep every subagent and command in the foreground
# (CLAUDE_CODE_DISABLE_BACKGROUND_TASKS). If something still runs in the background, `claude -p`
# would stop it after 10 idle minutes and drop its result, which ended the first real run
# mid-design; CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 waits instead (RUN_TIMEOUT still applies).
LEAD_MODEL=${ADLC_LEAD_MODEL:-sonnet}
LOG_RETENTION_DAYS=${ADLC_LOG_RETENTION_DAYS:-7}
R="$ADLC_REPO"

label() { # label <issue> <remove> <add>
  gh issue edit "$1" -R "$R" ${2:+--remove-label "$2"} ${3:+--add-label "$3"} >/dev/null 2>&1 \
    || log "WARN: could not relabel #$1 (-$2 +$3)"
}
comment() { gh issue comment "$1" -R "$R" --body "$2" >/dev/null 2>&1 || log "WARN: could not comment on #$1"; }
has_label() { gh issue view "$1" -R "$R" --json labels --jq "[.labels[].name] | index(\"$2\") != null" 2>/dev/null | grep -q true; }
is_running() { local f="$STATE_DIR/running/$1.pid"; [ -f "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null; }
running_count() { local n=0 f; for f in "$STATE_DIR"/running/*.pid; do [ -e "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null && n=$((n + 1)); done; echo "$n"; }
max_runs() { local m; m=$(cfg '.autonomy.max_parallel_runs'); echo "${m:-${ADLC_MAX_PARALLEL_RUNS:-1}}"; }
is_collaborator() { gh api "repos/$R/collaborators/$1" --silent >/dev/null 2>&1; }

# The agents' own identity: the GitHub App configured for this project (`adlc app <slug>`), seen
# as <app-slug>[bot]. Issues it wrote (e.g. /adlc-core:plan-backlog) and labels it set
# (queued → ready) count as trusted. Nothing here is specific to one owner or app.
SELF=""
is_self() { [ -n "$SELF" ] && { [ "$1" = "$SELF" ] || [ "$1" = "app/${SELF%\[bot\]}" ]; }; }

# Before launching anything: the runtime identity must resolve and match adlc.yaml `identity`
# (written by /adlc-core:init). Fails closed and quietly: nothing starts, and each distinct
# problem is logged once (not every poll).
id_err=""
id_fail() { [ "$1" = "$id_err" ] || log "$1"; id_err=$1; return 1; }
identity_ok() {
  local want_mode want_app
  [ -n "$SELF" ] || SELF=$(adlc-gh-token --identity 2>/dev/null | cut -f1)
  want_mode=$(cfg '.identity.agents'); want_app=$(cfg '.identity.app')
  if [ -n "${ADLC_GH_APP_ID:-}" ]; then
    [[ "$SELF" == *"[bot]" ]] || { SELF=""; id_fail "ERROR: cannot resolve the GitHub App identity (app id $ADLC_GH_APP_ID); not launching. Check: adlc-gh-token --identity"; return; }
  elif [ "$want_mode" = github-app ] || [ "$want_mode" = app ]; then
    id_fail "ERROR: adlc.yaml identity.agents is '$want_mode' but the runner has no app configured; not launching. Run: adlc app $ADLC_SLUG --id <app-id> --key <file.pem>, then adlc up $ADLC_SLUG"; return
  fi
  if [ -n "$want_app" ] && [ "$want_app" != tbd ] && [ -n "${ADLC_GH_APP_ID:-}" ] && [ "$SELF" != "${want_app}[bot]" ]; then
    id_fail "ERROR: runner acts as $SELF but adlc.yaml identity.app is '$want_app'; not launching. Fix the app (adlc app) or adlc.yaml (/adlc-core:init --update)"; return
  fi
  [ -z "$id_err" ] || log "identity OK: $SELF"
  id_err=""
}

# Who may start a delivery run: an issue written by a collaborator or by ADLC itself, or any
# issue a collaborator labelled adlc:ready (that's how you approve an outsider's issue).
trusted_issue() { # trusted_issue <n> <author>
  local actor
  is_self "$2" || is_collaborator "$2" && return 0
  actor=$(gh api --paginate "repos/$R/issues/$1/events?per_page=100" \
            --jq '.[] | select(.event == "labeled" and .label.name == "adlc:ready") | .actor.login' 2>/dev/null | tail -n 1)
  [ -n "$actor" ] && ! is_self "$actor" && is_collaborator "$actor"
}

# ── Backoff (shared Max quota) ────────────────────────────────────────────────
in_backoff() { local u; u=$(cat "$STATE_DIR/backoff_until" 2>/dev/null || echo 0); [ "$(date +%s)" -lt "$u" ]; }
set_backoff() { # set_backoff [reset_epoch]
  local now step until
  now=$(date +%s)
  step=$(cat "$STATE_DIR/backoff_step" 2>/dev/null || echo 300)
  if [ -n "${1:-}" ] && [ "$1" -gt "$now" ]; then until=$(( $1 + 60 )); else until=$(( now + step )); fi
  echo "$until" >"$STATE_DIR/backoff_until"
  echo $(( step * 2 > 3600 ? 3600 : step * 2 )) >"$STATE_DIR/backoff_step"
  log "usage limit: pausing launches until $(date -u -d "@$until" +%FT%TZ 2>/dev/null || echo "$until")"
}
clear_backoff() { rm -f "$STATE_DIR/backoff_until" "$STATE_DIR/backoff_step"; }

# ── Startup recovery: runs interrupted by a restart resume from state.json ────
recover_interrupted() {
  local n
  for n in $(gh issue list -R "$R" --label adlc:in-progress --state open --json number --jq '.[].number' 2>/dev/null); do
    is_running "$n" && continue
    log "#$n was in progress when the runner stopped; re-queueing (it resumes from state.json)"
    label "$n" adlc:in-progress adlc:ready
  done
}

# Owner tasks and epics are never delivered by agents, even if one gets a pipeline label by mistake.
NOT_AGENT_WORK='select([.labels[].name] | any(. == "adlc:owner" or . == "owner-task" or . == "type:epic") | not)'

# ── queued → ready when every "blocked by" issue is closed ───────────────────
promote_queued() {
  local n open
  for n in $(gh issue list -R "$R" --label adlc:queued --state open --limit 1000 --json number,labels \
               --jq ".[] | $NOT_AGENT_WORK | .number" 2>/dev/null); do
    open=$(gh api "repos/$R/issues/$n/dependencies/blocked_by" --jq '[.[] | select(.state == "open")] | length' 2>/dev/null) || continue
    if [ "$open" = 0 ]; then label "$n" adlc:queued adlc:ready; log "promoted #$n to ready"; fi
  done
}

# ── Launch ────────────────────────────────────────────────────────────────────
prepare_worktree() { # prepare_worktree <n> <title>  → prints worktree path
  local n=$1 title=$2 wt="$RUNS_DIR/$1" existing b
  if [ -d "$wt/.git" ] || [ -f "$wt/.git" ]; then
    git -C "$wt" fetch --quiet origin 2>/dev/null || true
    echo "$wt"; return 0
  fi
  b=$(default_branch)
  existing=$(git -C "$REPO_DIR" for-each-ref --format='%(refname:lstrip=3)' "refs/remotes/origin/adlc/$n-*" \
               | grep -Ev -- "^adlc/$n-t[0-9]+$" | head -1)
  if [ -n "$existing" ]; then
    git -C "$REPO_DIR" worktree add --quiet -B "$existing" "$wt" "origin/$existing" >/dev/null 2>&1 || return 1
  else
    git -C "$REPO_DIR" worktree add --quiet -b "adlc/$n-$(slugify <<<"$title")" "$wt" "origin/$b" >/dev/null 2>&1 || return 1
  fi
  echo "$wt"
}

post_run() { # post_run <n> <exit-code> <jsonl> <stderr>
  local n=$1 rc=$2 out=$3 err=$4 init_errors result reset
  if [ -f "$STATE_DIR/takeover/$n" ]; then
    rm -f "$STATE_DIR/takeover/$n"
    log "#$n: taken over by an interactive session; leaving labels as they are"
    return
  fi
  init_errors=$(jq -c 'select(.type == "system" and .subtype == "init") | .plugin_errors // [] | length' "$out" 2>/dev/null | head -1)
  if [ "${init_errors:-0}" != 0 ]; then
    log "#$n: plugins failed to load. Pausing the poller. See $out"
    touch "$STATE_DIR/paused"
    label "$n" adlc:in-progress adlc:ready
    return
  fi
  result=$(jq -r 'select(.type == "result") | (.result // "") + " " + (.subtype // "")' "$out" 2>/dev/null | tail -1)
  if grep -qiE 'usage limit|rate.?limit|429|overloaded' <<<"$result $(tail -c 2000 "$err" 2>/dev/null)"; then
    reset=$(grep -oE 'limit reached\|[0-9]{10}' <<<"$result" | grep -oE '[0-9]{10}' | head -1)
    set_backoff "$reset"
    label "$n" adlc:in-progress adlc:ready
    return
  fi
  if has_label "$n" adlc:in-progress; then
    # deliver didn't reach a terminal label: crash, timeout or tool failure
    log "#$n: run ended without a terminal state (exit $rc)"
    comment "$n" "ADLC runner: the delivery run ended unexpectedly (exit $rc). Last result: \`${result:0:300}\`. Log: \`$out\` on the runner. Relabel \`adlc:ready\` to retry; it resumes from the last pushed phase."
    label "$n" adlc:in-progress adlc:blocked
  else
    clear_backoff
    log "#$n: run finished (exit $rc)"
  fi
}

# ── Run next (dashboard) ───────────────────────────────────────────────────────
# "Run next" on an issue puts it first in line: label adlc:priority, which launch_ready sorts before the
# milestone order. Only an open agent issue (ready, or queued with no open "blocked by" issue: it's then
# promoted) qualifies. It doesn't stop a running delivery: it starts when a run slot is free. The label
# is removed when its run starts.
PRIORITY_LABEL=adlc:priority
prioritize() { # prioritize <n>
  local n=$1 info state labels open
  info=$(gh issue view "$n" -R "$R" --json state,labels --jq '[.state, ([.labels[].name] | join(","))] | @tsv' 2>/dev/null) \
    || { log "WARN: run next: cannot read #$n"; return 0; }
  state=${info%%$'\t'*}; labels=",${info#*$'\t'},"
  [ "$state" = OPEN ] || { log "WARN: run next: #$n is not open"; return 0; }
  # An epic: its startable sub-issues go first (see epic_first); the epic itself is never started.
  if [[ $labels == *,type:epic,* ]]; then
    gh label create "$PRIORITY_LABEL" -R "$R" --color B60205 --description "Run this issue next (ADLC dashboard)" >/dev/null 2>&1 || true
    label "$n" "" "$PRIORITY_LABEL"
    log "#$n (epic): its sub-issues run next (from the dashboard), in their own order and dependencies"
    return 0
  fi
  case $labels in *,adlc:owner,*|*,owner-task,*) log "WARN: run next: #$n is not agent work"; return 0 ;; esac
  case $labels in
    *,adlc:in-progress,*|*,adlc:pr-open,*|*,adlc:blocked,*|*,adlc:needs-info,*|*,adlc:needs-human-review,*)
      log "WARN: run next: #$n is already in the pipeline (not ready or queued)"; return 0 ;;
  esac
  open=$(gh api "repos/$R/issues/$n/dependencies/blocked_by" --jq '[.[] | select(.state == "open")] | length' 2>/dev/null) \
    || { log "WARN: run next: cannot read the blockers of #$n"; return 0; }
  [ "$open" = 0 ] || { log "WARN: run next: #$n is blocked by $open open issue(s); not moved"; return 0; }
  gh label create "$PRIORITY_LABEL" -R "$R" --color B60205 --description "Run this issue next (ADLC dashboard)" >/dev/null 2>&1 || true
  if [[ $labels == *,adlc:queued,* ]]; then label "$n" adlc:queued adlc:ready
  elif [[ $labels != *,adlc:ready,* ]]; then label "$n" "" adlc:ready; fi      # an issue to triage: start it
  label "$n" "" "$PRIORITY_LABEL"
  log "#$n: run next (from the dashboard); it starts when a run slot is free"
}
deprioritize() { label "$1" "$PRIORITY_LABEL" ""; log "#$1: back to the normal order (from the dashboard)"; }
# "Start" on an issue to triage (opened by an agent or the nightly, no pipeline state yet): into the
# pipeline as ready, or queued while it has open blockers.
start_issue() { # start_issue <n>
  local n=$1 info state labels open
  info=$(gh issue view "$n" -R "$R" --json state,labels --jq '[.state, ([.labels[].name] | join(","))] | @tsv' 2>/dev/null) \
    || { log "WARN: start: cannot read #$n"; return 0; }
  state=${info%%$'\t'*}; labels=",${info#*$'\t'},"
  [ "$state" = OPEN ] || { log "WARN: start: #$n is not open"; return 0; }
  case $labels in *,adlc:owner,*|*,owner-task,*|*,type:epic,*) log "WARN: start: #$n is not agent work"; return 0 ;; esac
  case $labels in *,adlc:ready,*|*,adlc:queued,*|*,adlc:in-progress,*|*,adlc:pr-open,*|*,adlc:blocked,*|*,adlc:needs-info,*|*,adlc:needs-human-review,*)
    log "WARN: start: #$n is already in the pipeline"; return 0 ;;
  esac
  enter_pipeline "$n" "from the dashboard"
}
# Into the pipeline: ready, or queued while it has open blockers.
enter_pipeline() { # enter_pipeline <n> <why>
  local n=$1 open
  open=$(gh api "repos/$R/issues/$n/dependencies/blocked_by" --jq '[.[] | select(.state == "open")] | length' 2>/dev/null) || open=0
  if [ "$open" = 0 ]; then label "$n" "" adlc:ready; log "#$n: started $2 (ready)"
  else label "$n" "" adlc:queued; log "#$n: started $2 (queued: $open open blocker(s))"; fi
}
# Regressions (main or the nightly is broken) don't wait for triage: one with no pipeline state, e.g. opened
# by a nightly workflow without adlc:ready, is started once. Remove its state label later and it stays out.
start_regressions() {
  local d="$STATE_DIR/regressions-started" n
  mkdir -p "$d"
  for n in $(gh issue list -R "$R" --label adlc:regression --state open --limit 50 --json number,labels --jq "map($NOT_AGENT_WORK)
      | .[] | select([.labels[].name] | any(test(\"^adlc:(ready|queued|in-progress|pr-open|blocked|needs-info|needs-human-review)$\")) | not) | .number" 2>/dev/null); do
    [ -e "$d/$n" ] && continue
    touch "$d/$n"
    enter_pipeline "$n" "automatically: a regression"
  done
}

launch() { # launch <n> <title>
  local n=$1 title=$2 wt ts out err protected mode
  wt=$(prepare_worktree "$n" "$title") || { log "#$n: could not create worktree"; return 1; }
  ts=$(date -u +%Y%m%dT%H%M%SZ)
  out="$LOG_DIR/runs/$n-$ts.jsonl"; err="$LOG_DIR/runs/$n-$ts.stderr"
  protected=$(cfg '.repo.protected_branches | join("|")')
  # An open PR from this issue's branch means a rework (failed checks or a person's request): say so
  # explicitly, so the run never just resumes its recorded phase.
  # A conflicting PR adds --conflicts: a person may have relabelled the issue (e.g. from blocked) without the
  # poller's conflict comment on the PR, and the run must not reuse an earlier conclusion.
  local pr_state
  mode=""
  pr_state=$(gh pr list -R "$R" --state open --json headRefName,mergeable --jq ".[] | select(.headRefName | startswith(\"adlc/$n-\")) | .mergeable" 2>/dev/null | head -1)
  if [ -n "$pr_state" ]; then
    mode=" --rework"
    [ "$pr_state" = CONFLICTING ] && mode=" --rework --conflicts"
  fi
  label "$n" adlc:ready adlc:in-progress
  gh issue edit "$n" -R "$R" --remove-label "$PRIORITY_LABEL" >/dev/null 2>&1 || true
  log "#$n: starting delivery${mode:+ (rework of its open PR)} in $wt"
  (
    cd "$wt" || exit 1
    ADLC_MODE=unattended ADLC_RUN=$n \
    ADLC_PROJECT_DOMAIN="$ADLC_SLUG.${ADLC_BASE_DOMAIN:-lan}" \
    ADLC_PROTECTED_BRANCHES="${protected:-main|master}" \
    CLAUDE_CODE_OAUTH_TOKEN="$(secret claude_oauth_token)" \
    CLAUDE_CODE_SYNC_PLUGIN_INSTALL=1 \
    CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1 \
    CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 \
      timeout --kill-after=60 "$RUN_TIMEOUT" \
      claude -p "/adlc-core:deliver $n$mode" \
        --permission-mode bypassPermissions \
        --model "$LEAD_MODEL" \
        --output-format stream-json --verbose \
        >"$out" 2>"$err"
    rc=$?
    post_run "$n" "$rc" "$out" "$err"
    rm -f "$STATE_DIR/running/$n.pid"
  ) &
  echo $! >"$STATE_DIR/running/$n.pid"
}

# Issues with an open agent PR (branch adlc/<n>-…): a run for one of them is a rework (conflicts, failed
# checks, review comments), which finishes work that's already waiting instead of adding more.
agent_pr_issues() {
  gh pr list -R "$R" --state open --limit 100 --json headRefName \
    --jq '[.[].headRefName | select(test("^adlc/[0-9]+-")) | capture("^adlc/(?<n>[0-9]+)-").n | tonumber] | unique' 2>/dev/null || echo '[]'
}
# Ready issues whose epic (parent, or the parent's parent) has "run next" (adlc:priority on the epic), as a
# JSON array of numbers.
epic_first() {
  gh api graphql -f query='query($o:String!,$r:String!){repository(owner:$o,name:$r){issues(states:OPEN,labels:["adlc:ready"],first:100){nodes{
      number parent{labels(first:30){nodes{name}} parent{labels(first:30){nodes{name}}}}}}}}' \
    -f o="${R%%/*}" -f r="${R##*/}" \
    --jq "[.data.repository.issues.nodes[] | select([(.parent.labels.nodes[]?.name), (.parent.parent.labels.nodes[]?.name)] | index(\"$PRIORITY_LABEL\")) | .number]" 2>/dev/null \
    || echo '[]'
}
wip_held=""
# Order of the ready issues: "run next" on the issue (adlc:priority), then regressions (adlc:regression), then "run next" on its epic, then reworks
# (rework_first, default on), then the milestone due date and age. With max_open_prs set, a new issue (no open PR) doesn't start while that many
# agent PRs are open: they wait for your review, a merge or a rework first. Reworks and "run next" always start.
launch_ready() {
  local slots n author title has_pr urgent prs open max rework order epics
  in_backoff && return 0
  [ -n "$(secret claude_oauth_token)" ] || { log "secret claude_oauth_token missing; not launching"; return 0; }
  identity_ok || return 0
  disk_ok || return 0
  slots=$(( $(max_runs) - $(running_count) ))
  [ "$slots" -gt 0 ] || return 0
  prs=$(agent_pr_issues); [[ "$prs" == \[* ]] || prs='[]'
  open=$(jq length <<<"$prs"); max=$(setting max_open_prs)
  rework=false; [ "$(setting rework_first)" = on ] && rework=true
  epics=$(epic_first); [[ "$epics" == \[* ]] || epics='[]'
  order="sort_by(([.labels[].name] | index(\"$PRIORITY_LABEL\") == null), ([.labels[].name] | index(\"adlc:regression\") == null), (.number as \$n | $epics | index(\$n) == null), ($rework and (.number as \$n | $prs | index(\$n) == null)), (.milestone.dueOn // \"9999\"), .createdAt)"
  while IFS=$'\t' read -r n author title has_pr urgent; do
    [ -n "$n" ] || continue
    [ "$slots" -gt 0 ] || break
    is_running "$n" && continue
    # "Run next" is your explicit choice: it isn't held back by the limit.
    if [ "$has_pr" = false ] && [ "$urgent" != true ] && [[ "$max" =~ ^[0-9]+$ ]] && [ "$open" -ge "$max" ]; then
      [ "$wip_held" = "$open/$max" ] || log "not starting new issues: $open agent PRs are open (max_open_prs $max); reworks and run next still run. Review, merge or close PRs to make room"
      wip_held="$open/$max"
      continue
    fi
    if ! trusted_issue "$n" "$author"; then
      log "#$n: author @$author is not a collaborator; needs human review"
      label "$n" adlc:ready adlc:needs-human-review
      comment "$n" "ADLC: issues from non-collaborators aren't processed automatically. A maintainer can review it, remove \`adlc:needs-human-review\` and add \`adlc:ready\` to approve it."
      continue
    fi
    launch "$n" "$title" && slots=$((slots - 1))
  done < <(gh issue list -R "$R" --label adlc:ready --state open --limit 100 \
             --json number,title,author,milestone,createdAt,labels \
             --jq "map($NOT_AGENT_WORK) | $order | .[] | [.number, .author.login, .title, (.number as \$n | $prs | index(\$n) != null), ([.labels[].name] | index(\"$PRIORITY_LABEL\") != null)] | @tsv" 2>/dev/null)
  if [ -n "$wip_held" ] && ! { [[ "$max" =~ ^[0-9]+$ ]] && [ "$open" -ge "$max" ]; }; then
    log "open agent PRs below max_open_prs again: new issues start"; wip_held=""
  fi
}

# ── Automation switches ──────────────────────────────────────────────────────
# Live overrides in state/settings/<key> (written from the dashboard, or `adlc train`) win over the
# project's adlc.yaml, which wins over the default. state/settings.json shows the effective values.
SETTINGS_DIR="$STATE_DIR/settings"
# key|adlc.yaml path|default|allowed values
SETTINGS="merge_train|.autonomy.merge_train|dry-run|on dry-run off
ci_auto_rework|.autonomy.ci_auto_rework|on|on off
keep_prs_current|.autonomy.keep_prs_current|on|on off
rework_first|.autonomy.rework_first|on|on off
max_open_prs|.autonomy.max_open_prs|off|off 2 3 4 5 6 8"
setting_def() { grep "^$1|" <<<"$SETTINGS"; }
norm_value() { case $1 in true|on|yes) echo on ;; false|off|no) echo off ;; *) echo "$1" ;; esac; }
setting() { # setting <key> → effective value
  local key=$1 def path default v
  def=$(setting_def "$key"); path=$(cut -d'|' -f2 <<<"$def"); default=$(cut -d'|' -f3 <<<"$def")
  v=$(cat "$SETTINGS_DIR/$key" 2>/dev/null)
  [ -z "$v" ] && [ "$key" = merge_train ] && v=${ADLC_MERGE_TRAIN:-}
  [ -n "$v" ] || v=$(cfg_raw "$path" "$default")
  norm_value "$v"
}
setting_source() {
  local key=$1 def path
  [ -s "$SETTINGS_DIR/$key" ] && { echo dashboard; return; }
  [ "$key" = merge_train ] && [ -n "${ADLC_MERGE_TRAIN:-}" ] && { echo env; return; }
  def=$(setting_def "$key"); path=$(cut -d'|' -f2 <<<"$def")
  [ -n "$(cfg_raw "$path" "")" ] && echo adlc.yaml || echo default
}
write_settings() {
  local key path default allowed out=()
  while IFS='|' read -r key path default allowed; do
    out+=("$(jq -cn --arg key "$key" --arg value "$(setting "$key")" --arg source "$(setting_source "$key")" \
      --arg project "$(norm_value "$(cfg_raw "$path" "$default")")" --arg allowed "$allowed" \
      '{key:$key, value:$value, source:$source, project:$project, allowed:($allowed | split(" "))}')")
  done <<<"$SETTINGS"
  printf '%s\n' "${out[@]}" | jq -s '{settings:.}' >"$STATE_DIR/settings.json.tmp" 2>/dev/null && mv "$STATE_DIR/settings.json.tmp" "$STATE_DIR/settings.json"
}

# ── Failed checks go back to the agent ───────────────────────────────────────
# An agent's PR (branch adlc/<n>-…, issue labelled adlc:pr-open) whose checks on the head commit have all
# finished with a failure: comment the failed checks on the PR and relabel the issue adlc:ready, so the
# delivery run reworks it (see /adlc-core:deliver, "First, rework or not"). Green PRs that fell behind the
# base branch are brought up to date (keep_current). Once per commit, at most
# autonomy.ci_rework_max times per PR (default 2); then adlc:needs-human-review. PRs from people, Renovate
# etc. are left alone. Off with autonomy.ci_auto_rework: false.
CI_DIR="$STATE_DIR/ci_rework"
ci_auto() { [ "$(setting ci_auto_rework)" = on ]; }
# A green agent PR that is behind its base branch (branch protection requires up-to-date branches, so any
# other merge leaves it unmergeable): merge the base into it, so its checks run on the current base and it
# can merge (auto-merge for low/medium risk, or by you). A merge, not a rebase, keeps the agent's history.
# Once per head commit; failing PRs are left to the rework path, which merges the base itself.
keep_current() { # keep_current <pr> <issue> <head sha>
  local pr=$1 n=$2 sha=$3 base behind f="$CI_DIR/current-$1"
  [ "$(setting keep_prs_current)" = on ] || return 0
  grep -qx "$sha" "$f" 2>/dev/null && return 0
  has_label "$n" adlc:pr-open || return 0
  base=$(gh pr view "$pr" -R "$R" --json baseRefName --jq .baseRefName 2>/dev/null) || return 0
  behind=$(gh api "repos/$R/compare/$base...$sha" --jq .behind_by 2>/dev/null) || return 0
  [ "${behind:-0}" -gt 0 ] || return 0
  if gh pr update-branch "$pr" -R "$R" >/dev/null 2>&1; then
    echo "$sha" >>"$f"
    log "#$n: PR #$pr was $behind commit(s) behind $base with green checks; merged $base into it"
  else
    log "WARN: #$n: PR #$pr is $behind commit(s) behind $base but could not be updated (retrying next cycle)"
  fi
}
# Send an agent PR back to its issue's delivery run. Shared by failed checks and merge conflicts: once per
# head commit, at most autonomy.ci_rework_max automatic reworks per PR, then adlc:needs-human-review.
# Conflicts also send back a PR whose issue is adlc:blocked (e.g. waiting on an environment fix): the base
# moved on after the block, and nothing else would tell the agent.
request_rework() { # request_rework <pr> <issue> <head sha> <what> <comment> [also-blocked]
  local pr=$1 n=$2 sha=$3 what=$4 body=$5 max f tried from=adlc:pr-open
  max=$(cfg_raw '.autonomy.ci_rework_max' "${ADLC_CI_REWORK_MAX:-2}")
  is_running "$n" && return 0
  if ! has_label "$n" adlc:pr-open; then
    [ "${6:-}" = also-blocked ] && has_label "$n" adlc:blocked || return 0
    from=adlc:blocked
  fi
  f="$CI_DIR/$pr"
  grep -qx "$sha" "$f" 2>/dev/null && return 0         # this commit was handled already
  tried=$(grep -c . "$f" 2>/dev/null || true); tried=${tried:-0}
  if [ "$tried" -ge "$max" ]; then
    echo "$sha" >>"$f"
    gh pr comment "$pr" -R "$R" --body "ADLC: $what on \`${sha:0:7}\` after $tried automatic rework(s). Leaving it to a person." >/dev/null 2>&1 || true
    label "$n" "" adlc:needs-human-review
    log "#$n: PR #$pr: $what after $tried rework(s); needs human review"
    return 0
  fi
  gh pr comment "$pr" -R "$R" --body "$body
The delivery agent will rework this PR (automatic attempt $((tried + 1)) of $max)." >/dev/null 2>&1 \
    || { log "WARN: could not comment on PR #$pr (retrying next cycle)"; return 0; }
  # Recorded only once the comment is posted, so a failed attempt is retried.
  echo "$sha" >>"$f"
  label "$n" "$from" adlc:ready
  log "#$n: PR #$pr: $what on ${sha:0:7}; queued for rework ($((tried + 1))/$max)"
}
watch_pr_checks() {
  ci_auto || return 0
  local rows pr branch sha mergeable base failed n
  mkdir -p "$CI_DIR"
  # Agents' PRs: number, branch, head sha, mergeable (MERGEABLE, CONFLICTING or UNKNOWN while GitHub
  # computes it), base branch. Their checks come from the Actions runs for the head commit: the App token
  # has Actions: read, while a PR's check rollup needs Checks: read, which it lacks.
  rows=$(gh pr list -R "$R" --state open --limit 100 --json number,headRefName,headRefOid,mergeable,baseRefName \
           --jq '.[] | select(.headRefName | test("^adlc/[0-9]+-")) | [.number, .headRefName, .headRefOid, .mergeable, .baseRefName] | @tsv' 2>/dev/null) || return 0
  while IFS=$'\t' read -r pr branch sha mergeable base; do
    [ -n "$pr" ] || continue
    n=$(sed -E 's#^adlc/([0-9]+)-.*#\1#' <<<"$branch")
    # Conflicts first: GitHub runs no pull_request workflows for a conflicting PR, so its checks would
    # look pending forever.
    if [ "$mergeable" = CONFLICTING ]; then
      request_rework "$pr" "$n" "$sha" "merge conflicts with $base" "ADLC: this PR has merge conflicts with \`$base\` at \`${sha:0:7}\`. Merge \`$base\` into the branch and resolve them, keeping the intent of both sides; then verify and review again." also-blocked
      continue
    fi
    # GitHub computes mergeability lazily: UNKNOWN may still turn out CONFLICTING, so don't treat it as green yet.
    [ "$mergeable" = UNKNOWN ] && continue
    # "PENDING" while any run for the commit is unfinished (or none started yet); else the failed
    # workflows as "name <url>" joined by "; " (empty = all green). Only each workflow's latest run counts:
    # one superseded by a newer run for the same commit doesn't. A latest run that was cancelled (by hand,
    # or the CI registrar's job time limit) counts as failed: its required check never passes otherwise.
    failed=$(gh run list -R "$R" --commit "$sha" --event pull_request --limit 50 --json name,status,conclusion,url,createdAt --jq '
      if length == 0 or any(.[]; .status != "completed") then "PENDING" else
      [group_by(.name)[] | max_by(.createdAt)
       | select(.conclusion == "failure" or .conclusion == "timed_out" or .conclusion == "startup_failure" or .conclusion == "cancelled")
       | "\(.name) <\(.url)>\(if .conclusion == "cancelled" then " (cancelled)" else "" end)"] | join("; ") end' 2>/dev/null) || continue
    [ "$failed" != PENDING ] || continue
    if [ -z "$failed" ]; then keep_current "$pr" "$n" "$sha"; continue; fi
    request_rework "$pr" "$n" "$sha" "checks failed" "ADLC: required checks failed on \`${sha:0:7}\`: ${failed}
It fixes code and test failures; failures of the environment (runner, emulator, network, disk) it reports instead of changing the code or the tests."
  done <<<"$rows"
}
# A push workflow that fails on the default branch's head: one regression issue per commit (the agent
# picks it up like the nightly's regression issues).
watch_main_checks() {
  ci_auto || return 0
  local b sha failed f title
  b=$(default_branch); sha=$(git -C "$REPO_DIR" rev-parse "origin/$b" 2>/dev/null) || return 0
  f="$CI_DIR/main-$sha"; [ -e "$f" ] && return 0
  # all push runs for this commit finished, at least one failed
  failed=$(gh run list -R "$R" --commit "$sha" --event push --limit 50 --json name,status,conclusion,url --jq '
    if any(.[]; .status != "completed") or length == 0 then "" else
    [.[] | select(.conclusion == "failure" or .conclusion == "timed_out" or .conclusion == "startup_failure") | "\(.name) <\(.url)>"] | join("; ") end' 2>/dev/null) || return 0
  [ -n "$failed" ] || { gh run list -R "$R" --commit "$sha" --event push --limit 1 --json status --jq '.[0].status' 2>/dev/null | grep -q completed && touch "$f"; return 0; }
  mkdir -p "$CI_DIR"; touch "$f"
  title="CI failed on $b at ${sha:0:7}"
  gh issue create -R "$R" --title "$title" --label adlc:regression --label adlc:ready --body "ADLC: workflows failed on \`$b\` at $sha: ${failed}
Find the cause and fix it. If it's the environment (runner, emulator, network, disk, registry), report it instead of changing code or tests." >/dev/null 2>&1 \
    && log "$b at ${sha:0:7}: workflows failed ($failed); opened a regression issue" \
    || log "WARN: workflows failed on $b at ${sha:0:7} ($failed) but the regression issue could not be created"
}

# ── Merge train: approved agent PRs are merged one after another ─────────────
# You review and approve; ADLC merges. Approved agent PRs (adlc/<n>-*) queue in approval order and one at a
# time goes through: brought up to date with its base (keep it current), checks green, then squash-merged
# with the App (a normal merge: required checks and reviews apply). Conflicts and failed checks take the
# usual rework path. ADLC decides whether an approval still holds (the branch protection setting
# "dismiss stale approvals" is off): it does when every commit after the approved one is a clean merge
# from the base branch, i.e. a merge whose tree is exactly what git produces by itself, or touches only
# ADLC's own run records under .adlc/ (review, rework notes, state). Anything else (new code, a conflict
# resolution) needs a new approval, which ADLC asks for on the PR.
# Mode (see train_mode): on | dry-run (default: decide and report, merge nothing) | off.
# Out of the train: adlc:hold on the PR, a "changes requested" review, or removing the approval.
TRAIN_FILE="$STATE_DIR/merge_train.json"
# The mode (see "Automation switches"): dashboard or `adlc train` override, ADLC_MERGE_TRAIN, adlc.yaml
# autonomy.merge_train, else dry-run.
train_mode() { case $(setting merge_train) in on) echo on ;; off) echo off ;; *) echo dry-run ;; esac; }
# Is every commit in <approved>..<head> a clean merge of the base branch or a .adlc/-only record?
# (1 = new changes since approval)
approval_holds() { # approval_holds <approved sha> <head sha> <base>
  local a=$1 h=$2 base=$3 c p1 p2 tree
  [ "$a" = "$h" ] && return 0
  git -C "$REPO_DIR" merge-base --is-ancestor "$a" "$h" 2>/dev/null || return 1
  # The branch's own line (first parents); commits that came in from the base are covered by the p2 check.
  for c in $(git -C "$REPO_DIR" rev-list --first-parent "$a..$h"); do
    p1=$(git -C "$REPO_DIR" rev-parse --verify --quiet "$c^1") || return 1
    if ! p2=$(git -C "$REPO_DIR" rev-parse --verify --quiet "$c^2"); then     # not a merge
      # ADLC's run records only (at least one file, none outside .adlc/)
      git -C "$REPO_DIR" diff-tree --no-commit-id --name-only -r "$c" | grep -q . || return 1
      git -C "$REPO_DIR" diff-tree --no-commit-id --name-only -r "$c" | grep -qv '^\.adlc/' && return 1
      continue
    fi
    git -C "$REPO_DIR" rev-parse --verify --quiet "$c^3" >/dev/null && return 1 # octopus
    git -C "$REPO_DIR" merge-base --is-ancestor "$p2" "origin/$base" 2>/dev/null || return 1
    tree=$(git -C "$REPO_DIR" merge-tree --write-tree "$p1" "$p2" 2>/dev/null) || return 1  # conflicted
    [ "$tree" = "$(git -C "$REPO_DIR" rev-parse "$c^{tree}")" ] || return 1     # edited by hand
  done
}
train_entry() { jq -cn --argjson pr "$1" --argjson issue "$2" --arg status "$3" --arg detail "${4:-}" '{pr:$pr,issue:$issue,status:$status,detail:$detail}'; }
merge_train() {
  local mode rows pr branch head base mergeable hold approved approvedAt changes n front="" entries=() status detail behind failed f
  mode=$(train_mode)
  [ "$mode" != off ] || { rm -f "$TRAIN_FILE"; return 0; }
  # latestOpinionatedReviews(writersOnly): each reviewer's latest approve/request-changes, people with write
  # access only. Bots (the agents' App) never count as approval.
  rows=$(gh api graphql -f query='query($o:String!,$r:String!){repository(owner:$o,name:$r){pullRequests(states:OPEN,first:50){nodes{
      number headRefName headRefOid baseRefName mergeable labels(first:20){nodes{name}}
      latestOpinionatedReviews(first:20,writersOnly:true){nodes{author{__typename login} state submittedAt commit{oid}}}}}}}' \
      -f o="${R%%/*}" -f r="${R##*/}" --jq '
      .data.repository.pullRequests.nodes[] | select(.headRefName | test("^adlc/[0-9]+-")) |
      ([.latestOpinionatedReviews.nodes[] | select(.author.__typename != "Bot")]) as $rv |
      ([$rv[] | select(.state == "APPROVED")] | sort_by(.submittedAt) | last) as $ok |
      select($ok != null) |
      [.number, .headRefName, .headRefOid, .baseRefName, .mergeable,
       ([.labels.nodes[].name] | index("adlc:hold") != null),
       $ok.commit.oid, $ok.submittedAt, ([$rv[] | select(.state == "CHANGES_REQUESTED")] | length > 0)] | @tsv' 2>/dev/null) \
    || return 0   # GitHub unreachable: keep the last train state rather than writing an empty one
  rows=$(sort -t$'\t' -k8 <<<"$rows")
  mkdir -p "$CI_DIR"
  while IFS=$'\t' read -r pr branch head base mergeable hold approved approvedAt changes; do
    [ -n "$pr" ] || continue
    n=$(sed -E 's#^adlc/([0-9]+)-.*#\1#' <<<"$branch")
    if [ "$hold" = true ]; then entries+=("$(train_entry "$pr" "$n" hold "adlc:hold on the PR")"); continue; fi
    if [ "$changes" = true ]; then entries+=("$(train_entry "$pr" "$n" changes-requested "a review requests changes")"); continue; fi
    if ! approval_holds "$approved" "$head" "$base"; then
      entries+=("$(train_entry "$pr" "$n" needs-reapproval "new changes since your approval (${approved:0:7}..${head:0:7})")")
      f="$CI_DIR/reapprove-$pr"
      if ! grep -qx "$head" "$f" 2>/dev/null && [ "$mode" = on ]; then
        # GitHub keeps the (stale) approval since "dismiss stale approvals" is off: make sure its auto-merge
        # (enabled by the agents for low/medium risk) can't merge on it either.
        gh pr merge "$pr" -R "$R" --disable-auto >/dev/null 2>&1 || true
        gh pr comment "$pr" -R "$R" --body "ADLC merge train: this PR changed after your approval (beyond clean merges of \`$base\` and ADLC run records): https://github.com/$R/compare/${approved:0:7}...${head:0:7}
Please review those changes and approve again to put it back in the merge train (auto-merge, if it was on, is off until then)." >/dev/null 2>&1 && echo "$head" >>"$f"
      fi
      continue
    fi
    if [ -n "$front" ]; then entries+=("$(train_entry "$pr" "$n" queued "approved ${approvedAt:0:16}Z; waits for #$front")"); continue; fi
    front=$pr
    # The front PR: bring it to a mergeable state, one step per cycle.
    if is_running "$n"; then status=agent; detail="the delivery agent is reworking #$n"
    elif [ "$mergeable" = CONFLICTING ]; then status=conflicts; detail="conflicts with $base: the agent resolves them, then you re-approve"
    elif [ "$mergeable" = UNKNOWN ]; then status=checking; detail="GitHub is computing mergeability"
    else
      behind=$(gh api "repos/$R/compare/$base...$head" --jq .behind_by 2>/dev/null || echo 0)
      if [ "${behind:-0}" -gt 0 ]; then
        status=updating; detail="$behind commit(s) behind $base"
        if [ "$mode" = on ]; then
          gh pr update-branch "$pr" -R "$R" >/dev/null 2>&1 && log "merge train: updated PR #$pr with $base" || log "WARN: merge train: could not update PR #$pr"
        else detail="$detail (dry run: would update it)"; fi
      else
        failed=$(gh run list -R "$R" --commit "$head" --event pull_request --limit 50 --json status,conclusion,name --jq '
          if length == 0 or any(.[]; .status != "completed") then "PENDING" else
          [.[] | select(.conclusion == "failure" or .conclusion == "timed_out" or .conclusion == "startup_failure") | .name] | join(", ") end' 2>/dev/null || echo PENDING)
        if [ "$failed" = PENDING ]; then status=checks; detail="waiting for checks"
        elif [ -n "$failed" ]; then status=failed; detail="checks failed ($failed): rework, then you re-approve if code changed"
        elif [ "$mode" = on ]; then
          if gh pr merge "$pr" -R "$R" --squash >/dev/null 2>&1; then
            status=merged; detail="merged"; log "merge train: merged PR #$pr (#$n)"; front=""
          else status=blocked; detail="GitHub refused the merge (branch protection?)"; log "WARN: merge train: GitHub refused to merge PR #$pr"; fi
        else status=ready; detail="green and up to date (dry run: would merge it now)"; log "merge train (dry run): would merge PR #$pr (#$n)"; fi
      fi
    fi
    entries+=("$(train_entry "$pr" "$n" "$status" "$detail")")
  done <<<"$rows"
  printf '%s\n' "${entries[@]}" | jq -s --arg mode "$mode" --arg at "$(date -u +%FT%TZ)" '{mode:$mode, updated:$at, prs:.}' >"$TRAIN_FILE.tmp" 2>/dev/null \
    && mv "$TRAIN_FILE.tmp" "$TRAIN_FILE"
}

# ── ADLC dashboard ────────────────────────────────────────────────────────────
# The dashboard (adlc ui) has no GitHub credentials and can't write runner state: it reads a
# snapshot written here, and asks for actions by dropping request files that are applied here.
UI_REQUESTS="$ADLC_ROOT/ui/requests/$ADLC_SLUG"
write_snapshot() {
  adlc-queue --snapshot "$STATE_DIR/github.json" 2>>"$LOG_DIR/poller.snapshot.err" \
    || log "WARN: dashboard snapshot failed (see logs/poller.snapshot.err)"
}
apply_ui_requests() {
  local f action
  [ -d "$UI_REQUESTS" ] || return 0
  for f in "$UI_REQUESTS"/*.json; do
    [ -e "$f" ] || continue
    action=$(jq -r '.action // ""' "$f" 2>/dev/null)
    case $action in
      pause)  touch "$STATE_DIR/paused"; log "paused from the dashboard" ;;
      resume) rm -f "$STATE_DIR/paused"; log "resumed from the dashboard" ;;
      prioritize:[0-9]*) prioritize "${action#*:}" ;;
      deprioritize:[0-9]*) deprioritize "${action#*:}" ;;
      start:[0-9]*) start_issue "${action#*:}" ;;
      *:*)
        local key=${action%%:*} value=${action#*:} def
        def=$(setting_def "$key")
        if [ -z "$def" ]; then log "WARN: ignored dashboard request '$action' (unknown setting)"
        elif [ "$value" = default ]; then rm -f "$SETTINGS_DIR/$key"; log "$key: back to the project setting (from the dashboard)"
        elif [[ " $(cut -d'|' -f4 <<<"$def") " == *" $value "* ]]; then
          mkdir -p "$SETTINGS_DIR"; echo "$value" >"$SETTINGS_DIR/$key"; log "$key: $value (from the dashboard)"
        else log "WARN: ignored dashboard request '$action' (value not allowed)"; fi
        write_settings ;;
      *)      log "WARN: ignored dashboard request '$action' ($(basename "$f"))" ;;
    esac
    rm -f "$f"
  done
}

# Wait for the next cycle, but apply dashboard requests (pause/resume) within ~5 seconds.
nap() {
  local waited=0
  while [ "$waited" -lt "$POLL_INTERVAL" ]; do
    sleep 5; waited=$((waited + 5))
    compgen -G "$UI_REQUESTS/*.json" >/dev/null && apply_ui_requests
  done
}

# ── Disk housekeeping: see housekeep in adlc-lib.sh ────────────────────────────
HOUSEKEEP_EVERY=$(( ${ADLC_HOUSEKEEP_HOURS:-6} * 3600 / POLL_INTERVAL ))
MIN_FREE_GB=${ADLC_MIN_FREE_GB:-15}
# Before launching: enough free disk, or housekeeping first, or nothing starts (logged once).
disk_err=""
disk_ok() {
  local free; free=$(free_gb)
  [ -n "$free" ] && [ "$free" -lt "$MIN_FREE_GB" ] || { [ -z "$disk_err" ] || log "disk OK again (${free}GB free)"; disk_err=""; return 0; }
  housekeep; free=$(free_gb)
  [ "$free" -lt "$MIN_FREE_GB" ] || return 0
  [ "$disk_err" = "$free" ] || log "ERROR: only ${free}GB free on the dev server (minimum ${MIN_FREE_GB}GB); not starting runs. Free space: adlc prune $ADLC_SLUG"
  disk_err=$free; return 1
}

# ── An agent PR closed without merging ───────────────────────────────────────
# A person closed the PR to have the issue done again (e.g. on a changed main). Its issue would otherwise
# stay adlc:pr-open forever, and a new run would resume the old branch. So: archive the branch as
# adlc-closed/<n>-<pr> (the work stays reachable; no run picks it up), remove the workspace, relabel the
# issue adlc:queued (promoted to ready once nothing blocks it) and say so on the issue. The next run
# starts fresh from main. Merged PRs close their issue as usual and are left alone.
watch_closed_prs() {
  local n branch pr oid tip had st done_dir="$STATE_DIR/closed-prs"
  mkdir -p "$done_dir"
  # Issues that can have an agent PR: pr-open, and those a rework left blocked or waiting for review.
  for n in $(for st in pr-open blocked needs-human-review; do
               gh issue list -R "$R" --label "adlc:$st" --state open --limit 100 --json number --jq '.[].number' 2>/dev/null
             done | sort -un); do
    is_running "$n" && continue
    # still an open PR from its branch: nothing to do
    [ -z "$(gh pr list -R "$R" --state open --json headRefName --jq ".[] | select(.headRefName | startswith(\"adlc/$n-\")) | .headRefName" 2>/dev/null)" ] || continue
    read -r pr branch oid < <(gh pr list -R "$R" --state closed --limit 100 --json number,headRefName,headRefOid,mergedAt,closedAt \
      --jq "[.[] | select(.headRefName | startswith(\"adlc/$n-\")) | select(.mergedAt == null)] | sort_by(.closedAt) | last | select(. != null) | \"\(.number) \(.headRefName) \(.headRefOid)\"" 2>/dev/null)
    [ -n "${pr:-}" ] || continue                                    # merged (the issue closes) or unknown
    [ -e "$done_dir/$pr" ] && continue                              # already handled
    tip=$(gh api "repos/$R/git/refs/heads/$branch" --jq .object.sha 2>/dev/null || true)
    # A branch that moved on after the close is a newer run's work (same branch name): leave it alone.
    if [ -n "$tip" ] && [ "$tip" != "$oid" ]; then : >"$done_dir/$pr"; continue; fi
    if [ -n "$tip" ]; then
      gh api -X POST "repos/$R/branches/$branch/rename" -f new_name="adlc-closed/$n-pr$pr" >/dev/null 2>&1 \
        || { log "WARN: #$n: PR #$pr was closed, but its branch $branch could not be archived (retrying next cycle)"; continue; }
    elif ! has_label "$n" adlc:pr-open; then
      : >"$done_dir/$pr"; continue                                  # blocked/review with no branch left: not this PR's state
    fi
    git -C "$REPO_DIR" update-ref -d "refs/remotes/origin/$branch" >/dev/null 2>&1 || true
    remove_workspace "$n" || log "WARN: #$n: the old worktree $RUNS_DIR/$n could not be removed; remove it by hand before the next run"
    had=$(gh issue view "$n" -R "$R" --json labels --jq '[.labels[].name | select(. == "adlc:pr-open" or . == "adlc:blocked" or . == "adlc:needs-human-review")] | join(",")' 2>/dev/null)
    label "$n" "$had" adlc:queued
    : >"$done_dir/$pr"
    comment "$n" "ADLC: PR #$pr was closed without merging, so this issue starts again from \`main\`. The previous work is kept on the branch \`adlc-closed/$n-pr$pr\`; the next run doesn't use it."
    log "#$n: PR #$pr closed without merging; branch archived as adlc-closed/$n-pr$pr, issue back to queued"
  done
}

# ── Cleanup after merge/close ─────────────────────────────────────────────────
# An issue's workspace: its test environment (and built images), worktree and local branches. Fails when
# the worktree can't be removed.
# Compose projects of issue <n> in the Docker sidecar: adlc-<n>, and adlc-<n>-<suffix> that a task agent
# may start with its own ADLC_RUN (e.g. adlc-38-t2). Not adlc-emulator or the dev deployment.
issue_projects() { # issue_projects <n>
  { echo "adlc-$1"; docker ps -a --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null | grep -E "^adlc-$1(-[a-z0-9]+)?$"; } | sort -u
}
down_issue_envs() { # down_issue_envs <n>: their containers, volumes, networks and built images
  local p
  for p in $(issue_projects "$1"); do docker compose -p "$p" down -v --rmi local >/dev/null 2>&1 || true; done
}
remove_workspace() { # remove_workspace <n>
  local n=$1 wt="$RUNS_DIR/$1"
  down_issue_envs "$n"
  if [ -e "$wt" ]; then
    git -C "$REPO_DIR" worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt" 2>/dev/null
    # Test-environment containers (e.g. vite as root) leave files this user can't delete. The
    # Docker sidecar sees the workspace at the same path and runs as root: remove them there.
    [ ! -e "$wt" ] || docker run --rm -v "$RUNS_DIR:/runs" alpine:3.22 rm -rf "/runs/$n" >/dev/null 2>&1 || true
  fi
  git -C "$REPO_DIR" worktree prune >/dev/null 2>&1 || true
  git -C "$REPO_DIR" for-each-ref --format='%(refname:short)' "refs/heads/adlc/$n-*" \
    | xargs -r git -C "$REPO_DIR" branch -D >/dev/null 2>&1
  [ ! -e "$wt" ]
}
cleanup() {
  local wt n state envs
  for wt in "$RUNS_DIR"/*/; do
    [ -d "$wt" ] || continue
    n=$(basename "$wt")
    is_running "$n" && continue
    state=$(gh issue view "$n" -R "$R" --json state --jq .state 2>/dev/null) || continue
    [ "$state" = CLOSED ] || continue
    if remove_workspace "$n"; then log "#$n closed: removed worktree and local branches"
    else log "ERROR: #$n closed but its worktree $wt could not be removed; remove it by hand (sudo rm -rf)"; fi
  done
  # Test environments left behind with no workspace: a task agent's adlc-<n>-t<k> after the workspace went,
  # or a workspace removed by hand. Down once the issue is closed.
  for n in $(docker ps -a --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null | sed -nE 's/^adlc-([0-9]+)(-[a-z0-9]+)?$/\1/p' | sort -un); do
    [ -d "$RUNS_DIR/$n" ] && continue
    is_running "$n" && continue
    state=$(gh issue view "$n" -R "$R" --json state --jq .state 2>/dev/null) || continue
    [ "$state" = CLOSED ] || continue
    envs=$(issue_projects "$n" | paste -sd' ' -)
    down_issue_envs "$n"
    log "#$n closed: removed its leftover test environments ($envs)"
  done
  git -C "$REPO_DIR" worktree prune >/dev/null 2>&1 || true
  find "$LOG_DIR/runs" -type f -mtime +"$LOG_RETENTION_DAYS" -delete 2>/dev/null || true
}

# ── Main loop ─────────────────────────────────────────────────────────────────
ensure_dirs
recovered=0
i=0
while :; do
  if ! repo_ready; then
    git clone --quiet "https://github.com/$R.git" "$REPO_DIR" 2>/dev/null && log "cloned $R" \
      || { log "waiting for $R to exist"; sleep "$POLL_INTERVAL"; continue; }
  fi
  if [ $((i % 10)) = 0 ] && ! gh api user --silent >/dev/null 2>&1 && ! gh api "repos/$R" --silent >/dev/null 2>&1; then
    log "ERROR: GitHub rejects the gh_pat token (expired or wrong scope). Fix with 'adlc secrets $ADLC_SLUG' + 'adlc up $ADLC_SLUG'"
  fi
  if ! sync_repo; then log "WARN: fetch/sync failed"; sleep "$POLL_INTERVAL"; continue; fi
  [ "$recovered" = 1 ] || { recover_interrupted; recovered=1; }
  apply_ui_requests
  if [ -f "$STATE_DIR/paused" ]; then
    [ $((i % 10)) = 0 ] && log "paused (adlc resume $ADLC_SLUG)"
  else
    start_regressions
    promote_queued
    [ $((i % 2)) = 0 ] && { watch_pr_checks; watch_main_checks; watch_closed_prs; merge_train; }
    launch_ready
  fi
  [ $((i % 10)) = 0 ] && cleanup
  [ $((i % HOUSEKEEP_EVERY)) = 1 ] && housekeep
  write_snapshot
  write_settings
  i=$((i + 1))
  nap
done
