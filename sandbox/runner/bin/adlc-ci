#!/usr/bin/env bash
# ADLC CI registrar: keeps one ephemeral GitHub Actions runner available for the project's repo.
#
# - Only this container holds ci_admin_pat (repo Administration: write, needed to create
#   just-in-time runner configs). It never runs workflow code.
# - Each job runs in a fresh runner container inside the CI Docker engine (ci-docker), which
#   agents can't reach. A JIT runner takes exactly one job and exits.
# - Before every new runner, everything the previous job left in ci-docker is removed, so a
#   pull-request job can't plant anything for a later main-branch publish job.
set -uo pipefail
ADLC_COMPONENT=ci
# shellcheck source=adlc-lib.sh
source /usr/local/bin/adlc-lib.sh

R="$ADLC_REPO"
# Jobs run in the ADLC CI runner image: the official runner (BASE) plus docker compose, yq and the
# proxy settings jobs need (definition in /usr/local/share/adlc/ci-runner, from sandbox/runner/ci-runner).
BASE=${ADLC_CI_RUNNER_IMAGE:-ghcr.io/actions/actions-runner:latest}
IMAGE=adlc/ci-runner:local
CI_IMAGE_DIR=/usr/local/share/adlc/ci-runner
LABELS=${ADLC_CI_LABELS:-self-hosted,linux,adlc-publish,adlc-test}
INTERVAL=${ADLC_CI_INTERVAL:-15}
# With /dev/kvm in ci-docker (adlc up --ci-kvm on), jobs can run the Android emulator here.
[ "${ADLC_CI_KVM:-0}" = 1 ] && [[ ",$LABELS," != *",adlc-kvm,"* ]] && LABELS="$LABELS,adlc-kvm"
# The real gh, not the wrapper on PATH: the wrapper always swaps in the agents' token, and this
# container must use ci_admin_pat (the only credential that can register runners).
GH=/usr/bin/gh

mkdir -p ~/.docker
cat >~/.docker/config.json <<EOF
{ "proxies": { "default": {
    "httpProxy": "${ADLC_INNER_PROXY:-}", "httpsProxy": "${ADLC_INNER_PROXY:-}",
    "noProxy": "localhost,127.0.0.1" } } }
EOF

for _ in $(seq 1 60); do docker info >/dev/null 2>&1 && break; sleep 2; done
docker info >/dev/null 2>&1 || die "cannot reach the CI Docker engine at ${DOCKER_HOST:-?}"

runner_running() { [ -n "$(docker ps -q --filter label=adlc.ci=runner)" ]; }

# A waiting runner lives in ci-docker and survives restarts of this container. One registered
# with other labels (ADLC_CI_LABELS changed) would wait forever for jobs nobody sends it: remove
# it and its GitHub registration. A runner that has started a job is left to finish.
# A waiting runner started from an older CI image (the image was rebuilt) is replaced the same way,
# so jobs always get the current image.
# The runner's work folder (work_folder=_work under its home); see start_runner.
WORK=/home/runner/_work
# Bump when start_runner changes how runners are started, so idle runners are replaced.
SPEC=3

replace_stale_runners() {
  local c labels image spec current token id why
  current=$(docker image inspect -f '{{.Id}}' "$IMAGE" 2>/dev/null)
  for c in $(docker ps --filter label=adlc.ci=runner --format '{{.Names}}'); do
    labels=$(docker inspect -f '{{index .Config.Labels "adlc.ci.labels"}}' "$c" 2>/dev/null)
    image=$(docker inspect -f '{{.Image}}' "$c" 2>/dev/null)
    spec=$(docker inspect -f '{{index .Config.Labels "adlc.ci.spec"}}' "$c" 2>/dev/null)
    if [ "$labels" != "$LABELS" ]; then why="labels ${labels:-unknown} → $LABELS"
    elif [ -n "$current" ] && [ "$image" != "$current" ]; then why="the CI image was updated"
    elif [ "$spec" != "$SPEC" ]; then why="the runner setup changed"
    else continue; fi
    token=$(secret ci_admin_pat)
    id=$(GH_TOKEN=$token $GH api "repos/$R/actions/runners?per_page=100" \
          --jq ".runners[] | select(.name == \"$c\") | select(.busy | not) | .id" 2>/dev/null)
    if [ -z "$id" ]; then
      log "runner $c is outdated ($why) but busy or unknown to GitHub; leaving it"
      continue
    fi
    docker rm -f "$c" >/dev/null 2>&1
    GH_TOKEN=$token $GH api -X DELETE "repos/$R/actions/runners/$id" >/dev/null 2>&1 || true
    log "replaced idle runner $c: $why"
  done
}

# Remove everything except running runner containers; keep image layers (build cache).
reset_engine() {
  local ids
  ids=$(docker ps -aq | grep -vxF -f <(docker ps -q --filter label=adlc.ci=runner) || true)
  if [ -n "$ids" ]; then
    xargs docker rm -f <<<"$ids" >/dev/null 2>&1
    log "removed $(wc -l <<<"$ids") leftover container(s) from the previous job"
  fi
  docker volume prune -af >/dev/null 2>&1 || true
  docker network prune -f >/dev/null 2>&1 || true
}

last_pull=0
# Pull the official base daily; (re)build the ADLC image when the base or its definition changed.
last_build_fail=0
ensure_image() {
  local now key have
  now=$(date +%s)
  if [ $((now - last_pull)) -gt 86400 ] || ! docker image inspect "$BASE" >/dev/null 2>&1; then
    docker pull -q "$BASE" >/dev/null && last_pull=$now && log "base runner image $BASE up to date"
  fi
  key="$(docker image inspect -f '{{.Id}}' "$BASE" 2>/dev/null)-$(cat "$CI_IMAGE_DIR"/* | sha256sum | cut -c1-16)"
  have=$(docker image inspect -f '{{index .Config.Labels "org.adlc.ci.key"}}' "$IMAGE" 2>/dev/null || true)
  [ "$have" = "$key" ] && return 0
  # After a failed build, retry hourly; jobs use the plain base image meanwhile.
  [ $((now - last_build_fail)) -gt 3600 ] || return 0
  if docker build -q -t "$IMAGE" --build-arg BASE="$BASE" --label "org.adlc.ci.key=$key" "$CI_IMAGE_DIR" >/dev/null 2>/tmp/ci-runner-build.err; then
    log "CI runner image $IMAGE built (docker compose, yq, proxy for sudo and Node)"
  else
    last_build_fail=$now
    log "ERROR: cannot build $IMAGE ($(tail -n 3 /tmp/ci-runner-build.err 2>/dev/null | tr '\n' ' ')); jobs use the plain base image, retrying in an hour"
    docker image inspect "$IMAGE" >/dev/null 2>&1 || docker tag "$BASE" "$IMAGE" >/dev/null 2>&1 || true
  fi
}

start_runner() {
  local token name jit gid start label_args=() l
  token=$(secret ci_admin_pat)
  name="adlc-$ADLC_SLUG-$(date +%s)"
  for l in ${LABELS//,/ }; do label_args+=(-f "labels[]=$l"); done
  jit=$(GH_TOKEN=$token $GH api -X POST "repos/$R/actions/runners/generate-jitconfig" \
          -f name="$name" -F runner_group_id=1 -f work_folder=_work "${label_args[@]}" \
          --jq .encoded_jit_config 2>&1) || {
    log "ERROR: cannot create a JIT runner config ($jit). ci_admin_pat needs Administration: read and write on $R"
    return 1
  }
  # The plain base image (fallback when the CI image cannot be built) has only run.sh.
  start=./run.sh
  docker run --rm --entrypoint sh "$IMAGE" -c 'command -v adlc-runner-start' >/dev/null 2>&1 && start=adlc-runner-start
  gid=$(docker run --rm --entrypoint stat -v /var/run/docker.sock:/s "$IMAGE" -c %g /s 2>/dev/null || echo 0)
  # Jobs talk to this engine, so the paths in their bind mounts (docker compose with ./files)
  # are looked up on the engine, not in the runner. Give the engine the job workspace at the
  # same path, fresh for each runner.
  docker run --rm --user root --entrypoint sh -v "$(dirname "$WORK")":/h "$IMAGE" \
    -c "rm -rf /h/$(basename "$WORK") && mkdir -p /h/$(basename "$WORK") && chown runner:runner /h/$(basename "$WORK")" >/dev/null 2>&1 \
    || { log "ERROR: cannot prepare the job workspace $WORK on the CI engine"; return 1; }
  docker run -d --rm --name "$name" --label adlc.ci=runner --label "adlc.ci.labels=$LABELS" --label "adlc.ci.spec=$SPEC" \
    -v /var/run/docker.sock:/var/run/docker.sock --group-add "$gid" -v "$WORK:$WORK" \
    -e ADLC_JOB_NO_PROXY="localhost,127.0.0.1,.lan,.internal" \
    "$IMAGE" "$start" --jitconfig "$jit" >/dev/null \
    && log "runner $name waiting for a job (labels: $LABELS)"
}


# Once a day, between jobs: drop dangling images and cap the build cache. Images in use (the
# runner image) and pulled base images stay, so jobs keep their speed.
# Cap the build cache (Docker 29 renamed --keep-storage to --reserved-space).
prune_build_cache() {
  if docker builder prune --help 2>/dev/null | grep -q -- --reserved-space; then
    docker builder prune -f --reserved-space "$1" >/dev/null 2>&1 || true
  else
    docker builder prune -f --keep-storage "$1" >/dev/null 2>&1 || true
  fi
}
last_prune=0
prune_engine() {
  local now; now=$(date +%s)
  [ $((now - last_prune)) -gt 86400 ] || return 0
  docker image prune -f >/dev/null 2>&1 || true
  prune_build_cache "${ADLC_CI_BUILD_CACHE_KEEP:-5GB}"
  last_prune=$now
  log "housekeeping: dangling images and build cache pruned"
}

log "registrar started: one runner at a time with labels $LABELS, image $IMAGE"
while :; do
  if [ -z "$(secret ci_admin_pat)" ]; then
    log "CI runner disabled: no ci_admin_pat (adlc secrets $ADLC_SLUG)"; sleep 300; continue
  fi
  # Image first (cheap when current), then retire idle runners that are outdated, then make sure
  # one runner waits for the next job.
  ensure_image
  replace_stale_runners
  if ! runner_running; then
    reset_engine
    prune_engine
    start_runner || sleep 60
  fi
  sleep "$INTERVAL"
done
