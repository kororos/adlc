#!/usr/bin/env bash
# ADLC CI registrar: keeps one ephemeral GitHub Actions runner waiting for the project's repo, and for
# the test role starts more while jobs run, up to the host's CI capacity (see Shared CI capacity).
#
# - Only this container holds ci_admin_pat (repo Administration: write, needed to create
#   just-in-time runner configs). It never runs workflow code.
# - Each job runs in a fresh runner container inside the CI Docker engine (ci-docker), which
#   agents can't reach. A JIT runner takes exactly one job and exits.
# - Before every new runner, everything finished jobs left in the role's engine is removed, so a
#   pull-request job can't plant anything for a later main-branch publish job. Only test jobs share
#   their engine with other jobs running at the same time (they hold no secrets).
set -uo pipefail
ROLE=${ADLC_CI_ROLE:-test}
ADLC_COMPONENT=ci-$ROLE
# shellcheck source=adlc-lib.sh
source /usr/local/bin/adlc-lib.sh

R="$ADLC_REPO"
# Jobs run in the ADLC CI runner image: the official runner (BASE) plus docker compose, yq, the
# browser libraries and the proxy settings jobs need (definition in /usr/local/share/adlc/ci-runner, from sandbox/runner/ci-runner).
BASE=${ADLC_CI_RUNNER_IMAGE:-ghcr.io/actions/actions-runner:latest}
IMAGE=adlc/ci-runner:local
CI_IMAGE_DIR=/usr/local/share/adlc/ci-runner
# 1: the image carries the system libraries and fonts headless Chromium needs (e2e jobs skip --with-deps).
BROWSER_DEPS=${ADLC_CI_BROWSER_DEPS:-1}
LABELS=${ADLC_CI_LABELS:-self-hosted,linux,adlc-test}
INTERVAL=${ADLC_CI_INTERVAL:-15}
# The real gh, not the wrapper on PATH: the wrapper always swaps in the agents' token, and this
# container must use ci_admin_pat (the only credential that can register runners).
GH=/usr/bin/gh
# Set on a CI-only host (adlc up <slug> --ci-only): part of the runner names, so each host counts only its
# own busy runners against its CI capacity. Empty on the main ADLC host.
HOST=${ADLC_CI_HOST:-}

mkdir -p ~/.docker
cat >~/.docker/config.json <<EOF
{ "proxies": { "default": {
    "httpProxy": "${ADLC_INNER_PROXY:-}", "httpsProxy": "${ADLC_INNER_PROXY:-}",
    "noProxy": "localhost,127.0.0.1" } } }
EOF

for _ in $(seq 1 60); do docker info >/dev/null 2>&1 && break; sleep 2; done
docker info >/dev/null 2>&1 || die "cannot reach the CI Docker engine at ${DOCKER_HOST:-?}"

my_runners() { docker ps --filter label=adlc.ci=runner --format '{{.Names}}'; }

# A waiting runner lives in ci-docker and survives restarts of this container. One registered
# with other labels (ADLC_CI_LABELS changed) would wait forever for jobs nobody sends it: remove
# it and its GitHub registration. A runner that has started a job is left to finish.
# A waiting runner started from an older CI image (the image was rebuilt) is replaced the same way,
# so jobs always get the current image.
# Each runner's work folder is _work-<runner name> under its home, so runners in one engine don't share it;
# see start_runner.
RUNNER_HOME=/home/runner
# Bump when start_runner changes how runners are started, so idle runners are replaced.
SPEC=8
# Caches that survive between jobs (named volumes labelled org.adlc.ci.cache, which reset_engine
# keeps): Gradle (dependencies, wrapper, build cache) and the Android SDK/NDK, so Android builds
# don't start from cold. A volume above ADLC_CI_CACHE_MAX_GB is emptied by the daily housekeeping.
# PR jobs can write to them; each runner start rewrites gradle.properties and drops Gradle init
# scripts, and the publish job doesn't run Gradle.
# Only the roles that build Android apps need them (ADLC_CI_CACHES=on, set for kvm in compose.ci.yml);
# on other engines, cache volumes left from before are removed once no runner holds them.
CACHE_VOLUMES="adlc-ci-cache-gradle adlc-ci-cache-android"
CACHES=""
[ "${ADLC_CI_CACHES:-off}" = on ] && CACHES="adlc-ci-cache-gradle:/home/runner/.gradle adlc-ci-cache-android:/home/runner/.android"
CACHE_LABEL=org.adlc.ci.cache
drop_unused_caches() {
  [ -z "$CACHES" ] || return 0
  local v
  for v in $CACHE_VOLUMES; do
    docker volume inspect "$v" >/dev/null 2>&1 || continue
    docker volume rm "$v" >/dev/null 2>&1 && log "removed cache volume $v (this runner role doesn't use it)"
  done
}
ensure_caches() {
  local c vol
  for c in $CACHES; do
    vol=${c%%:*}
    docker volume inspect "$vol" >/dev/null 2>&1 || docker volume create --label "$CACHE_LABEL=true" "$vol" >/dev/null || return 1
    docker run --rm --user root --entrypoint sh -v "$vol:/c" "$IMAGE" \
      -c 'chown runner:runner /c && rm -rf /c/init.d /c/init.gradle /c/gradle.properties' >/dev/null 2>&1 || return 1
  done
}
cache_mounts() { local c; for c in $CACHES; do printf -- '-v %s ' "$c"; done; }
# Hosts jobs reach directly, not through the egress proxy: the run's own test environment
# (http://<run>.app.<project>.ci.internal via the job's Traefik) and the dev domain.
JOB_NO_PROXY=localhost,127.0.0.1,.lan,.internal

# Remove an idle runner safely: unregister it on GitHub first, which GitHub refuses while the runner has a
# job; only then remove its container. GitHub's "busy" flag lags a few seconds behind a job assignment, so
# removing the container first could kill a job that was just handed out (GitHub then fails it after 10
# minutes with no steps). Fails (and keeps the runner) when GitHub refuses.
# GitHub's flag can also be wrong the other way: on 2026-11-23 it reported a runner 20 minutes into a job
# as not busy and accepted the unregister; removing it killed the nightly Android job and its emulator.
# So first ask the container itself: a runner running a job has a Runner.Worker process.
runner_has_job() { docker top "$1" 2>/dev/null | grep -q 'Runner\.Worker'; }
# GitHub answers are cached in files: every request counts against the ci_admin_pat owner's 5000 an hour,
# which all registrars (every host and role) and the owner's own gh share, and the checks run in command
# substitutions (subshells), where a cache in a shell variable is lost. (On 2026-11-24 the limit ran out:
# each check asked for the runner list, and the CI-order scan ran on every pass instead of once a minute.)
CACHE_DIR=$(mktemp -d)
cached() { # cached <name> <seconds> <command…>: the command's output, reused for <seconds>; fails if it fails
  local f=$CACHE_DIR/$1 ttl=$2 at
  shift 2
  if [ -e "$f" ] && at=$(stat -c %Y "$f" 2>/dev/null) && [ $(($(date +%s) - at)) -lt "$ttl" ]; then cat "$f"; return 0; fi
  "$@" >"$f.tmp" 2>/dev/null || { rm -f "$f.tmp"; return 1; }
  mv -f "$f.tmp" "$f" && cat "$f"
}
# GitHub's runner list, at most every 10 s (fails when GitHub can't be asked).
runners_json() { cached runners 10 env GH_TOKEN="$(secret ci_admin_pat)" "$GH" api "repos/$R/actions/runners?per_page=100"; }
remove_idle_runner() { # remove_idle_runner <container> <runner id>
  runner_has_job "$1" && return 1
  GH_TOKEN=$(secret ci_admin_pat) $GH api -X DELETE "repos/$R/actions/runners/$2" >/dev/null 2>&1 || return 1
  docker rm -f "$1" >/dev/null 2>&1
  return 0
}

replace_stale_runners() {
  local c labels image spec current token id why want
  current=$(docker image inspect -f '{{.Id}}' "$IMAGE" 2>/dev/null)
  want=$(runner_labels)
  for c in $(docker ps --filter label=adlc.ci=runner --format '{{.Names}}'); do
    labels=$(docker inspect -f '{{index .Config.Labels "adlc.ci.labels"}}' "$c" 2>/dev/null)
    image=$(docker inspect -f '{{.Image}}' "$c" 2>/dev/null)
    spec=$(docker inspect -f '{{index .Config.Labels "adlc.ci.spec"}}' "$c" 2>/dev/null)
    if [ "$labels" != "$want" ]; then why="labels ${labels:-unknown} → $want"
    elif [ -n "$current" ] && [ "$image" != "$current" ]; then why="the CI image was updated"
    elif [ "$spec" != "$SPEC" ]; then why="the runner setup changed"
    else continue; fi
    token=$(secret ci_admin_pat)
    id=$(runners_json | jq -r ".runners[] | select(.name == \"$c\") | select(.busy | not) | .id" 2>/dev/null)
    if [ -z "$id" ]; then
      log "runner $c is outdated ($why) but busy or unknown to GitHub; leaving it"
      continue
    fi
    if remove_idle_runner "$c" "$id"; then log "replaced idle runner $c: $why"
    else log "runner $c is outdated ($why) but just took a job; leaving it"; fi
  done
}

# Work folders on the engine whose runner is gone (all of them when no runner runs). The shared _work of
# runners started before SPEC 8 goes only then: such a runner may still run a job in it.
clean_work_dirs() {
  docker run --rm --user root --entrypoint sh -v "$RUNNER_HOME":/h -e LIVE=" $(my_runners | tr '\n' ' ') " "$IMAGE" \
    -c 'for d in /h/_work*; do [ -d "$d" ] || continue; [ "$d" != /h/_work ] || [ -z "$(echo $LIVE)" ] || continue
        case "$LIVE" in *" ${d#/h/_work-} "*) ;; *) rm -rf "$d" ;; esac; done' \
    >/dev/null 2>&1 || true
}

# No runner left in the engine: remove everything except runner containers; keep image layers (build cache).
reset_engine() {
  local ids
  ids=$(docker ps -aq | grep -vxF -f <(docker ps -q --filter label=adlc.ci=runner) || true)
  if [ -n "$ids" ]; then
    xargs docker rm -f <<<"$ids" >/dev/null 2>&1
    log "removed $(wc -l <<<"$ids") leftover container(s) from the previous job"
  fi
  docker volume prune -af --filter "label!=$CACHE_LABEL" >/dev/null 2>&1 || true
  drop_unused_caches
  docker network prune -f >/dev/null 2>&1 || true
  # Images the job's docker compose built (test environments): the next job rebuilds them from the
  # build cache, which is capped here too. Pulled images (postgres, …) stay for speed; see prune_engine.
  ADLC_BUILT_IMAGE_MAX_IDLE_H=0 ADLC_IMAGE_MAX_IDLE_H=876000 prune_finished_runs "$IMAGE $BASE"
  docker image prune -f >/dev/null 2>&1 || true
  prune_build_cache "${ADLC_CI_BUILD_CACHE_KEEP:-4GB}"
  clean_work_dirs
}

# Other jobs still run in this engine: remove only what finished runs left. A job's containers, networks
# and volumes belong to compose projects adlc-<ci|nightly>-<run id>[-…] (ADLC_RUN in the workflow
# templates); those of runs no longer queued or in progress go. Anything else waits for reset_engine,
# the next time the engine has no runner. Skipped when GitHub can't be asked.
tidy_engine() {
  local token active p ids
  token=$(secret ci_admin_pat)
  active=$( { GH_TOKEN=$token $GH api "repos/$R/actions/runs?status=in_progress&per_page=100" --jq '.workflow_runs[].id' \
              && GH_TOKEN=$token $GH api "repos/$R/actions/runs?status=queued&per_page=100" --jq '.workflow_runs[].id'; } 2>/dev/null) \
    || return 0
  for p in $(docker ps -a --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null | sort -u); do
    [[ $p =~ ^adlc-(ci|nightly)-([0-9]+)(-.*)?$ ]] || continue
    grep -qx "${BASH_REMATCH[2]}" <<<"$active" && continue
    ids=$(docker ps -aq --filter "label=com.docker.compose.project=$p")
    [ -z "$ids" ] || xargs docker rm -f <<<"$ids" >/dev/null 2>&1
    docker network ls -q --filter "label=com.docker.compose.project=$p" | xargs -r docker network rm >/dev/null 2>&1
    docker volume ls -q --filter "label=com.docker.compose.project=$p" | xargs -r docker volume rm >/dev/null 2>&1
    log "removed what finished run ${BASH_REMATCH[2]} left in the engine ($p)"
  done
  clean_work_dirs
  prune_build_cache "${ADLC_CI_BUILD_CACHE_KEEP:-4GB}"
}

last_pull=0
# Pull the official base daily; (re)build the ADLC image when the base or its definition changed.
last_build_fail=0
ensure_image() {
  local now key have
  now=$(date +%s)
  if [ $((now - last_pull)) -gt 86400 ] || ! docker image inspect "$BASE" >/dev/null 2>&1; then
    docker pull -q "$BASE" >/dev/null && last_pull=$now && log "base runner image $BASE up to date"
  fi
  key="$(docker image inspect -f '{{.Id}}' "$BASE" 2>/dev/null)-$(cat "$CI_IMAGE_DIR"/* | sha256sum | cut -c1-16)-deps$BROWSER_DEPS"
  have=$(docker image inspect -f '{{index .Config.Labels "org.adlc.ci.key"}}' "$IMAGE" 2>/dev/null || true)
  [ "$have" = "$key" ] && return 0
  # After a failed build, retry hourly; jobs use the plain base image meanwhile.
  [ $((now - last_build_fail)) -gt 3600 ] || return 0
  if docker build -q -t "$IMAGE" --build-arg BASE="$BASE" --build-arg BROWSER_DEPS="$BROWSER_DEPS" --label "org.adlc.ci.key=$key" "$CI_IMAGE_DIR" >/dev/null 2>/tmp/ci-runner-build.err; then
    log "CI runner image $IMAGE built (docker compose, yq, proxy for sudo and Node$([ "$BROWSER_DEPS" = 1 ] && echo ', browser libraries'))"
  else
    last_build_fail=$now
    log "ERROR: cannot build $IMAGE ($(tail -n 3 /tmp/ci-runner-build.err 2>/dev/null | tr '\n' ' ')); jobs use the plain base image, retrying in an hour"
    docker image inspect "$IMAGE" >/dev/null 2>&1 || docker tag "$BASE" "$IMAGE" >/dev/null 2>&1 || true
  fi
}

start_runner() {
  local token name jit gid start label_args=() l work labels
  token=$(secret ci_admin_pat)
  labels=$(runner_labels)
  name="adlc-$ADLC_SLUG${HOST:+-$HOST}-$ROLE-$(date +%s)"
  work=$RUNNER_HOME/_work-$name
  for l in ${labels//,/ }; do label_args+=(-f "labels[]=$l"); done
  jit=$(GH_TOKEN=$token $GH api -X POST "repos/$R/actions/runners/generate-jitconfig" \
          -f name="$name" -F runner_group_id=1 -f work_folder="_work-$name" "${label_args[@]}" \
          --jq .encoded_jit_config 2>&1) || {
    log "ERROR: cannot create a JIT runner config ($jit). ci_admin_pat needs Administration: read and write on $R"
    return 1
  }
  # The plain base image (fallback when the CI image cannot be built) has only run.sh.
  start=./run.sh
  docker run --rm --entrypoint sh "$IMAGE" -c 'command -v adlc-runner-start' >/dev/null 2>&1 && start=adlc-runner-start
  gid=$(docker run --rm --entrypoint stat -v /var/run/docker.sock:/s "$IMAGE" -c %g /s 2>/dev/null || echo 0)
  # Jobs talk to this engine, so the paths in their bind mounts (docker compose with ./files)
  # are looked up on the engine, not in the runner. Give the engine the job workspace at the
  # same path, fresh for each runner and its own (other runners may run in the same engine).
  docker run --rm --user root --entrypoint sh -v "$RUNNER_HOME":/h "$IMAGE" \
    -c "rm -rf /h/${work##*/} && mkdir -p /h/${work##*/} && chown runner:runner /h/${work##*/}" >/dev/null 2>&1 \
    || { log "ERROR: cannot prepare the job workspace $work on the CI engine"; return 1; }
  ensure_caches || log "WARN: cannot prepare the build caches; this job starts cold"
  # RUNNER_MANUALLY_TRAP_SIG: run.sh passes SIGTERM on to the listener, which cancels the job and
  # reports it, so `docker stop` (watch_job_time) ends the job on GitHub at once instead of after the
  # runner is declared lost.
  # shellcheck disable=SC2046  # cache_mounts prints -v options
  docker run -d --rm --name "$name" --label adlc.ci=runner --label "adlc.ci.labels=$labels" --label "adlc.ci.spec=$SPEC" \
    -v /var/run/docker.sock:/var/run/docker.sock --group-add "$gid" -v "$work:$work" $(cache_mounts) \
    -e NO_PROXY="$JOB_NO_PROXY" -e no_proxy="$JOB_NO_PROXY" -e ADLC_JOB_NO_PROXY="$JOB_NO_PROXY" \
    -e RUNNER_MANUALLY_TRAP_SIG=1 \
    "$IMAGE" "$start" --jitconfig "$jit" >/dev/null \
    && log "runner $name waiting for a job (labels: $labels)"
}


# Once a day, between jobs: images no job used for ADLC_CI_IMAGE_MAX_IDLE_H hours (default 24), e.g.
# publish's local copies of pushed images and base images a project stopped using. The runner images
# and ADLC_KEEP_IMAGES (the Android emulator) stay. (prune_build_cache comes from adlc-lib.sh.)
last_prune=0
prune_engine() {
  local now; now=$(date +%s)
  [ $((now - last_prune)) -gt 86400 ] || return 0
  ADLC_IMAGE_MAX_IDLE_H=${ADLC_CI_IMAGE_MAX_IDLE_H:-24} prune_finished_runs "$IMAGE $BASE"
  local c vol mb
  for c in $CACHES; do
    vol=${c%%:*}
    docker volume inspect "$vol" >/dev/null 2>&1 || continue
    mb=$(docker run --rm --entrypoint du -v "$vol:/c" "$IMAGE" -sm /c 2>/dev/null | cut -f1)
    if [ "${mb:-0}" -gt $(( ${ADLC_CI_CACHE_MAX_GB:-12} * 1024 )) ]; then
      docker volume rm "$vol" >/dev/null 2>&1 && log "housekeeping: cache $vol was ${mb} MB (over ${ADLC_CI_CACHE_MAX_GB:-12} GB): emptied"
    fi
  done
  last_prune=$now
  log "housekeeping: images idle for ${ADLC_CI_IMAGE_MAX_IDLE_H:-24}h removed; $(engine_usage)"
}

# ── Shared CI capacity ───────────────────────────────────────────────────────
# The roles' runners share the host's CPU. Capacity is ADLC_CI_SLOTS (default 2); a job of this
# role takes ADLC_CI_WEIGHT (test and publish 1, kvm 2: an Android build plus emulator runs alone).
# GitHub's runner list (same token for all registrars) says which runners are busy; host and role are in
# the name (adlc-<slug>[-<host>]-<role>-<time>). Capacity is per host: only this host's runners count. A
# registrar starts a runner only if its job fits next to the busy jobs (all roles, its own included), and
# removes its idle runner when it no longer fits. Best effort: two idle runners can still get jobs in the
# same second.
# Runners per role: the test registrar keeps one runner waiting and starts the next as soon as that one
# takes a job, up to ADLC_CI_PARALLEL test jobs at once (default: the slots). Test jobs keep their
# containers apart by run (compose project adlc-ci-<run id>, no host ports). publish (registry
# credentials) and kvm (one emulator, shared caches) run one job at a time in their engine.
SLOTS=${ADLC_CI_SLOTS:-2}
WEIGHT=${ADLC_CI_WEIGHT:-$([ "$ROLE" = kvm ] && echo 2 || echo 1)}
PARALLEL=1
[ "$ROLE" = test ] && PARALLEL=${ADLC_CI_PARALLEL:-$SLOTS}
[[ $PARALLEL =~ ^[1-9][0-9]*$ ]] || PARALLEL=1
role_weight() { case $1 in kvm) echo "${ADLC_CI_WEIGHT_KVM:-2}" ;; *) echo 1 ;; esac; }
# Weight of this host's busy runners, all roles; "?" when GitHub can't be asked (then don't block).
host_load() {
  local names n r h sum=0
  names=$(runners_json | jq -r ".runners[] | select(.busy) | .name" 2>/dev/null) || { echo "?"; return; }
  for n in $names; do
    if [[ "$n" =~ ^adlc-$ADLC_SLUG-(([a-z0-9]+)-)?(test|publish|kvm)-[0-9]+$ ]]; then
      h=${BASH_REMATCH[2]} r=${BASH_REMATCH[3]}
      [ "$h" = "$HOST" ] || continue                     # another host's runner: its own capacity
    else
      [ -z "$HOST" ] || continue                         # unknown runners count on the main host only
      r=other
    fi
    sum=$((sum + $(role_weight "$r")))
  done
  echo "$sum"
}
capacity_ok() { local b; b=$(host_load); [ "$b" = "?" ] || [ $((b + WEIGHT)) -le "$SLOTS" ]; }
# This registrar's runners without a job: "<name> <runner id>" per line, the id empty while the runner is
# still registering. Fails when GitHub can't be asked.
idle_runners() {
  local list c line
  list=$(runners_json | jq -r '.runners[] | "\(.name) \(.busy) \(.id)"' 2>/dev/null) || return 1
  for c in $(my_runners); do
    line=$(awk -v n="$c" '$1 == n' <<<"$list")
    [ "$(cut -d' ' -f2 <<<"$line")" = true ] && continue
    runner_has_job "$c" && continue       # GitHub said idle, but the runner is running a job
    echo "$c $(cut -s -d' ' -f3 <<<"$line")"
  done
}
# One registered idle runner of this registrar ("<name> <runner id>"), if any.
my_idle_runner() { idle_runners 2>/dev/null | awk 'NF == 2' | head -1; }
# ── Role priority on this host ───────────────────────────────────────────────
# Roles in ADLC_CI_PRIORITY order (default kvm,publish,test: the slowest required check and the one that
# needs most slots first, then publish, which the dev deploy waits for, then the short test jobs).
# While a job of a higher-priority role that this host also runs (ADLC_CI_HOST_ROLES, from adlc up
# --ci-roles) waits on GitHub for a runner, and it wouldn't fit next to a new job of this role, this
# registrar starts no runner and removes its idle one: running jobs finish, then the waiting job fits.
# Nothing names a host: each registrar only looks at its own host's roles and busy runners.
PRIORITY=${ADLC_CI_PRIORITY:-kvm,publish,test}
HOST_ROLES=${ADLC_CI_HOST_ROLES:-$ROLE}
HIGHER=""
for _r in ${PRIORITY//,/ }; do
  [ "$_r" = "$ROLE" ] && break
  [[ ",$HOST_ROLES," == *",$_r,"* ]] && HIGHER="$HIGHER $_r"
done
HIGHER=${HIGHER# }
# ── One PR's checks at a time ───────────────────────────────────────────────
# GitHub hands a queued job to any idle runner whose labels cover the job's runs-on; a registrar can't
# choose the job, only its runner's labels. Workflows put a group label in runs-on: adlc-group-<PR number>
# for a pull request, adlc-group-<commit> otherwise (the templates' runs-on is
# fromJSON(format(vars.ADLC_TEST_RUNS_ON …, <PR number or commit>)), and the variable carries
# "adlc-group-{0}"). Then the test and kvm registrars give their new runners the label of one group, the
# active one, and every job of other groups waits on GitHub until it is done: a PR's checks run to the end
# before the next PR's start, so it is merge-ready (or reworked) as early as possible.
# The active group: among the queued and running workflow runs that carry a group label, the oldest run
# with a job in progress; when none has started, the oldest waiting one. Jobs without a group label (older
# workflows, the variable without "{0}") keep going to any runner, as before.
# The ci_one_pr switch (dashboard → Automation, or adlc.yaml autonomy.ci_one_pr; default on) turns it off:
# then a new runner carries the labels of every group with a queued or running job, so it takes a job of
# any PR. The main host's registrars read the poller's settings.json; a CI-only host's reporter
# (adlc-hoststats) writes ci-switches.json from the dashboard's answer. Neither: on.
GROUP_RE='^adlc-group-[0-9a-f]+$'
SWITCH_DIR=/run/adlc/state
ci_switch() { # ci_switch <key> <default>
  local v
  v=$(jq -r --arg k "$1" '.settings[]? | select(.key == $k) | .value' "$SWITCH_DIR/settings.json" 2>/dev/null)
  [ -n "$v" ] || v=$(jq -r --arg k "$1" '.[$k] // empty' "$SWITCH_DIR/ci-switches.json" 2>/dev/null)
  echo "${v:-$2}"
}
# The queued and in-progress runs and their jobs, cached for a minute:
#   "R <created> <started 0|1> <group|->" per run, "Q <role|-> <group|->" per job waiting for a runner.
ci_scan() { cached scan 60 scan_runs || true; }
scan_runs() {
  local token row id created
  token=$(secret ci_admin_pat)
  for row in $( { GH_TOKEN=$token $GH api "repos/$R/actions/runs?status=queued&per_page=50" --jq '.workflow_runs[] | "\(.id)|\(.created_at)"'
                  GH_TOKEN=$token $GH api "repos/$R/actions/runs?status=in_progress&per_page=50" --jq '.workflow_runs[] | "\(.id)|\(.created_at)"'; } 2>/dev/null | sort -u); do
    id=${row%%|*} created=${row#*|}
    GH_TOKEN=$token $GH api "repos/$R/actions/runs/$id/jobs?filter=latest&per_page=100" --jq "
      ([.jobs[].labels[] | select(test(\"$GROUP_RE\"))] | first // \"-\") as \$g
      | \"R $created \\(if any(.jobs[]; .status == \"in_progress\") then 1 else 0 end) \\(\$g)\",
        (.jobs[] | select(.status == \"queued\")
         | \"Q \\(([.labels[] | capture(\"^adlc-(?<r>test|publish|kvm)$\").r] | first) // \"-\") \\(([.labels[] | select(test(\"$GROUP_RE\"))] | first) // \"-\")\")" 2>/dev/null
  done
}
# The group whose jobs run now (empty: none, every job goes to any runner).
active_group() {
  ci_scan | awk '$1 == "R" && $4 != "-"' | sort -k3,3r -k2,2 | head -n 1 | cut -d' ' -f4
}
# ci_one_pr off: every group with a queued or running job, comma-separated (at most 20).
all_groups() {
  ci_scan | awk '$1 == "R" && $4 != "-" { print $4 }' | sort -u | head -n 20 | paste -sd, -
}
# Labels for this registrar's next runner: the role's labels, plus the active group's for test and kvm
# (publish jobs carry no group label: the dev deploy never waits for a PR).
runner_labels() {
  local g k
  [ "$ROLE" != publish ] || { echo "$LABELS"; return; }
  if [ "$(ci_switch ci_one_pr on)" = off ]; then
    g=$(all_groups)
    [ "$(cat "$CACHE_DIR/order" 2>/dev/null)" = "*off" ] || { log "CI order: off (ci_one_pr): runners take jobs of every PR"; echo "*off" >"$CACHE_DIR/order"; }
    echo "$LABELS${g:+,$g}"; return
  fi
  g=$(active_group)
  if [ "$g" != "$(cat "$CACHE_DIR/order" 2>/dev/null)" ]; then
    k=${g#adlc-group-}
    if [ -z "$g" ]; then log "CI order: no grouped checks queued or running"
    elif [ ${#k} -le 10 ]; then log "CI order: running the checks of PR #$k to the end; other PRs' checks wait"
    else log "CI order: running the checks of commit ${k:0:7} to the end; other PRs' checks wait"; fi
    echo "$g" >"$CACHE_DIR/order"
  fi
  echo "$LABELS${g:+,$g}"
}
# Roles with a job waiting for a runner on GitHub, one per line: jobs of the active group and jobs without
# a group label (a job of a group that isn't active can't start, so nothing makes room for it); with
# ci_one_pr off, every waiting job.
waiting_roles() {
  local g="*"
  [ "$(ci_switch ci_one_pr on)" = off ] || g=$(active_group)
  ci_scan | awk -v g="${g:--}" '$1 == "Q" && $2 != "-" && (g == "*" || $3 == "-" || $3 == g) { print $2 }' | sort -u
}
# Roles of this host's busy runners, one per line (fails when GitHub can't be asked).
busy_here() {
  local names n
  names=$(runners_json | jq -r ".runners[] | select(.busy) | .name" 2>/dev/null) || return 1
  for n in $names; do
    [[ "$n" =~ ^adlc-$ADLC_SLUG-(([a-z0-9]+)-)?(test|publish|kvm)-[0-9]+$ ]] || continue
    [ "${BASH_REMATCH[2]}" = "$HOST" ] && echo "${BASH_REMATCH[3]}"
  done
  return 0
}
# The higher-priority role this registrar makes room for, if any: it has a waiting job, no busy runner on
# this host (else that job waits for its own runner anyway), and wouldn't fit next to a new job of ours.
yield_to() {
  [ -n "$HIGHER" ] || return 1
  local w busy r b load=0
  w=$(waiting_roles); [ -n "$w" ] || return 1
  busy=$(busy_here) || return 1
  for b in $busy; do load=$((load + $(role_weight "$b"))); done
  for r in $HIGHER; do
    grep -qx "$r" <<<"$w" || continue
    grep -qx "$r" <<<"$busy" && continue
    [ $((load + WEIGHT + $(role_weight "$r"))) -gt "$SLOTS" ] || continue
    echo "$r"; return 0
  done
  return 1
}

waiting_logged=0 held_for=""
yield_capacity() { # remove our idle runner when other roles' jobs fill the capacity or one goes first
  local idle c id r why
  idle=$(my_idle_runner) || return 0; [ -n "$idle" ] || return 0
  if r=$(yield_to); then why="a $r job is waiting and goes first on this host ($PRIORITY)"
  elif ! capacity_ok; then why="other CI jobs use the capacity ($SLOTS slots)"
  else return 0; fi
  c=${idle%% *}; id=${idle##* }
  remove_idle_runner "$c" "$id" || return 0     # it just took a job: let it run
  log "removed idle runner $c: $why; a new one starts when there is room"
}

# ── Job time limit ───────────────────────────────────────────────────────────
# A job without timeout-minutes gets GitHub's 6 hours, so one hung step holds this role's only runner
# (and its share of the CI capacity) that long, with every later job of the role queued behind it.
# After ADLC_CI_JOB_MAX_MIN minutes (default 75; 0 = off) the registrar stops the runner: run.sh passes
# the signal on, GitHub ends the job, the poller treats it like a failed check, and the next reset_engine
# removes what the job started. The clock starts at the job's started_at (or when this registrar first
# saw the runner busy, if GitHub can't say), so a registrar restart doesn't reset it.
# It stays above the templates' largest timeout-minutes (60), so GitHub's own timeout ends a job first
# and its cleanup steps still run.
JOB_MAX_MIN=${ADLC_CI_JOB_MAX_MIN:-75}
declare -A job_since=() job_desc=()
last_watch=0
# The job a runner is running: "<started_at>\t<workflow / job>\t<url>", empty if not found.
runner_job() { # runner_job <runner name> <token>
  local id
  for id in $(GH_TOKEN=$2 $GH api "repos/$R/actions/runs?status=in_progress&per_page=50" --jq '.workflow_runs[].id' 2>/dev/null); do
    GH_TOKEN=$2 $GH api "repos/$R/actions/runs/$id/jobs?filter=latest&per_page=100" --jq \
      ".jobs[] | select(.runner_name == \"$1\" and .status == \"in_progress\") | \"\\(.started_at)\t\\(.workflow_name) / \\(.name)\t\\(.html_url)\"" \
      2>/dev/null | head -1 | grep . && return 0
  done
  return 0
}
watch_job_time() {
  [ "${JOB_MAX_MIN:-0}" -gt 0 ] 2>/dev/null || return 0
  local now c token busy job started id live
  now=$(date +%s); [ $((now - last_watch)) -ge 60 ] || return 0; last_watch=$now
  live=$(my_runners)
  for c in "${!job_since[@]}"; do grep -qx "$c" <<<"$live" || unset "job_since[$c]" "job_desc[$c]"; done
  [ -n "$live" ] || return 0
  token=$(secret ci_admin_pat)
  busy=$(runners_json | jq -r '.runners[] | select(.busy) | .name' 2>/dev/null) || return 0
  for c in $live; do
    grep -qx "$c" <<<"$busy" || continue
    if [ -z "${job_since[$c]:-}" ]; then
      job_since[$c]=$now job_desc[$c]="its job"
      job=$(runner_job "$c" "$token")
      if [ -n "$job" ]; then
        started=$(date -d "$(cut -f1 <<<"$job")" +%s 2>/dev/null) && job_since[$c]=$started
        job_desc[$c]="$(cut -f2 <<<"$job") <$(cut -f3 <<<"$job")>"
      fi
    fi
    [ $((now - job_since[$c])) -ge $((JOB_MAX_MIN * 60)) ] || continue
    log "WARN: runner $c has run ${job_desc[$c]} for $(((now - job_since[$c]) / 60)) min (limit ADLC_CI_JOB_MAX_MIN=$JOB_MAX_MIN): stopping it; GitHub ends the job and what it left in the engine is removed"
    docker stop -t 60 "$c" >/dev/null 2>&1 || docker rm -f "$c" >/dev/null 2>&1
    id=$(runners_json | jq -r ".runners[] | select(.name == \"$c\") | .id" 2>/dev/null)
    [ -z "$id" ] || GH_TOKEN=$token $GH api -X DELETE "repos/$R/actions/runners/$id" >/dev/null 2>&1 || true
    unset "job_since[$c]" "job_desc[$c]"
  done
}

# ── Network policy (CI-only host) ────────────────────────────────────────────
# The egress proxy reads adlc.yaml; on the main host the poller keeps a clone. On a CI-only host the
# registrars fetch it from the default branch into ADLC_CI_POLICY_DIR every 10 minutes (written only when
# it changed, so the proxy reloads only then). Needs Contents: read on ci_admin_pat; without it the
# proxy keeps ADLC_NETWORK_MODE (default audit), and in allowlist mode would lack the project's domains.
POLICY_DIR=${ADLC_CI_POLICY_DIR:-}
last_policy=0 policy_warned=0
sync_policy() {
  [ -n "$POLICY_DIR" ] || return 0
  local now out
  now=$(date +%s); [ $((now - last_policy)) -ge 600 ] || return 0; last_policy=$now
  if out=$(GH_TOKEN=$(secret ci_admin_pat) $GH api "repos/$R/contents/adlc.yaml" --jq .content 2>/dev/null | base64 -d 2>/dev/null) \
     && [ -n "$out" ]; then
    cmp -s <(printf '%s\n' "$out") "$POLICY_DIR/adlc.yaml" && return 0
    printf '%s\n' "$out" >"$POLICY_DIR/.adlc.yaml.$ROLE" && mv -f "$POLICY_DIR/.adlc.yaml.$ROLE" "$POLICY_DIR/adlc.yaml" \
      && log "network policy: adlc.yaml updated from $R"
    policy_warned=0
  elif [ "$policy_warned" = 0 ]; then
    policy_warned=1
    log "WARN: cannot read adlc.yaml from $R (ci_admin_pat needs Contents: read); the egress proxy keeps ${ADLC_NETWORK_MODE:-audit} mode"
  fi
}

log "registrar ($ROLE${HOST:+ on $HOST}) started: up to $PARALLEL runner(s) at a time with labels $LABELS, image $IMAGE; CI capacity $SLOTS slot(s), this role takes $WEIGHT${HIGHER:+, makes room for: $HIGHER}; job limit ${JOB_MAX_MIN} min"
while :; do
  if [ -z "$(secret ci_admin_pat)" ]; then
    log "CI runner disabled: no ci_admin_pat (adlc secrets $ADLC_SLUG)"; sleep 300; continue
  fi
  # Image first (cheap when current), then retire idle runners that are outdated, then make sure
  # one runner waits for the next job (while the others run theirs, up to PARALLEL).
  sync_policy
  ensure_image
  replace_stale_runners
  if [ -n "$(my_runners)" ]; then
    watch_job_time
    yield_capacity
  fi
  n=$(my_runners | grep -c .)
  if [ "$n" -ge "$PARALLEL" ]; then
    :                                                   # this role's limit on this host
  elif [ "$n" -gt 0 ] && { ! idle=$(idle_runners) || [ -n "$idle" ]; }; then
    :                                                   # one already waits for a job (or GitHub can't say)
  elif r=$(yield_to); then
    [ "$held_for" = "$r" ] || log "holding: a $r job is waiting and goes first on this host ($PRIORITY)"
    held_for=$r
  elif capacity_ok; then
    [ "$waiting_logged" = 0 ] && [ -z "$held_for" ] || log "CI capacity free again"
    waiting_logged=0 held_for=""
    if [ "$n" = 0 ]; then reset_engine; else tidy_engine; fi
    prune_engine
    start_runner || sleep 60
  elif [ "$waiting_logged" = 0 ]; then
    log "waiting: running CI jobs use the capacity ($SLOTS slots, this role takes $WEIGHT)"; waiting_logged=1
  fi
  sleep "$INTERVAL"
done
