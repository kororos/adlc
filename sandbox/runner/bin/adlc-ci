#!/usr/bin/env bash
# ADLC CI registrar: keeps one ephemeral GitHub Actions runner available for the project's repo.
#
# - Only this container holds ci_admin_pat (repo Administration: write, needed to create
#   just-in-time runner configs). It never runs workflow code.
# - Each job runs in a fresh runner container inside the CI Docker engine (ci-docker), which
#   agents can't reach. A JIT runner takes exactly one job and exits.
# - Before every new runner, everything the previous job left in ci-docker is removed, so a
#   pull-request job can't plant anything for a later main-branch publish job.
set -uo pipefail
ROLE=${ADLC_CI_ROLE:-test}
ADLC_COMPONENT=ci-$ROLE
# shellcheck source=adlc-lib.sh
source /usr/local/bin/adlc-lib.sh

R="$ADLC_REPO"
# Jobs run in the ADLC CI runner image: the official runner (BASE) plus docker compose, yq and the
# proxy settings jobs need (definition in /usr/local/share/adlc/ci-runner, from sandbox/runner/ci-runner).
BASE=${ADLC_CI_RUNNER_IMAGE:-ghcr.io/actions/actions-runner:latest}
IMAGE=adlc/ci-runner:local
CI_IMAGE_DIR=/usr/local/share/adlc/ci-runner
LABELS=${ADLC_CI_LABELS:-self-hosted,linux,adlc-test}
INTERVAL=${ADLC_CI_INTERVAL:-15}
# The real gh, not the wrapper on PATH: the wrapper always swaps in the agents' token, and this
# container must use ci_admin_pat (the only credential that can register runners).
GH=/usr/bin/gh
# Set on a CI-only host (adlc up <slug> --ci-only): part of the runner names, so each host counts only its
# own busy runners against its CI capacity. Empty on the main ADLC host.
HOST=${ADLC_CI_HOST:-}

mkdir -p ~/.docker
cat >~/.docker/config.json <<EOF
{ "proxies": { "default": {
    "httpProxy": "${ADLC_INNER_PROXY:-}", "httpsProxy": "${ADLC_INNER_PROXY:-}",
    "noProxy": "localhost,127.0.0.1" } } }
EOF

for _ in $(seq 1 60); do docker info >/dev/null 2>&1 && break; sleep 2; done
docker info >/dev/null 2>&1 || die "cannot reach the CI Docker engine at ${DOCKER_HOST:-?}"

runner_running() { [ -n "$(docker ps -q --filter label=adlc.ci=runner)" ]; }

# A waiting runner lives in ci-docker and survives restarts of this container. One registered
# with other labels (ADLC_CI_LABELS changed) would wait forever for jobs nobody sends it: remove
# it and its GitHub registration. A runner that has started a job is left to finish.
# A waiting runner started from an older CI image (the image was rebuilt) is replaced the same way,
# so jobs always get the current image.
# The runner's work folder (work_folder=_work under its home); see start_runner.
WORK=/home/runner/_work
# Bump when start_runner changes how runners are started, so idle runners are replaced.
SPEC=7
# Caches that survive between jobs (named volumes labelled org.adlc.ci.cache, which reset_engine
# keeps): Gradle (dependencies, wrapper, build cache) and the Android SDK/NDK, so Android builds
# don't start from cold. A volume above ADLC_CI_CACHE_MAX_GB is emptied by the daily housekeeping.
# PR jobs can write to them; each runner start rewrites gradle.properties and drops Gradle init
# scripts, and the publish job doesn't run Gradle.
# Only the roles that build Android apps need them (ADLC_CI_CACHES=on, set for kvm in compose.ci.yml);
# on other engines, cache volumes left from before are removed once no runner holds them.
CACHE_VOLUMES="adlc-ci-cache-gradle adlc-ci-cache-android"
CACHES=""
[ "${ADLC_CI_CACHES:-off}" = on ] && CACHES="adlc-ci-cache-gradle:/home/runner/.gradle adlc-ci-cache-android:/home/runner/.android"
CACHE_LABEL=org.adlc.ci.cache
drop_unused_caches() {
  [ -z "$CACHES" ] || return 0
  local v
  for v in $CACHE_VOLUMES; do
    docker volume inspect "$v" >/dev/null 2>&1 || continue
    docker volume rm "$v" >/dev/null 2>&1 && log "removed cache volume $v (this runner role doesn't use it)"
  done
}
ensure_caches() {
  local c vol
  for c in $CACHES; do
    vol=${c%%:*}
    docker volume inspect "$vol" >/dev/null 2>&1 || docker volume create --label "$CACHE_LABEL=true" "$vol" >/dev/null || return 1
    docker run --rm --user root --entrypoint sh -v "$vol:/c" "$IMAGE" \
      -c 'chown runner:runner /c && rm -rf /c/init.d /c/init.gradle /c/gradle.properties' >/dev/null 2>&1 || return 1
  done
}
cache_mounts() { local c; for c in $CACHES; do printf -- '-v %s ' "$c"; done; }
# Hosts jobs reach directly, not through the egress proxy: the run's own test environment
# (http://<run>.app.<project>.ci.internal via the job's Traefik) and the dev domain.
JOB_NO_PROXY=localhost,127.0.0.1,.lan,.internal

replace_stale_runners() {
  local c labels image spec current token id why
  current=$(docker image inspect -f '{{.Id}}' "$IMAGE" 2>/dev/null)
  for c in $(docker ps --filter label=adlc.ci=runner --format '{{.Names}}'); do
    labels=$(docker inspect -f '{{index .Config.Labels "adlc.ci.labels"}}' "$c" 2>/dev/null)
    image=$(docker inspect -f '{{.Image}}' "$c" 2>/dev/null)
    spec=$(docker inspect -f '{{index .Config.Labels "adlc.ci.spec"}}' "$c" 2>/dev/null)
    if [ "$labels" != "$LABELS" ]; then why="labels ${labels:-unknown} → $LABELS"
    elif [ -n "$current" ] && [ "$image" != "$current" ]; then why="the CI image was updated"
    elif [ "$spec" != "$SPEC" ]; then why="the runner setup changed"
    else continue; fi
    token=$(secret ci_admin_pat)
    id=$(GH_TOKEN=$token $GH api "repos/$R/actions/runners?per_page=100" \
          --jq ".runners[] | select(.name == \"$c\") | select(.busy | not) | .id" 2>/dev/null)
    if [ -z "$id" ]; then
      log "runner $c is outdated ($why) but busy or unknown to GitHub; leaving it"
      continue
    fi
    docker rm -f "$c" >/dev/null 2>&1
    GH_TOKEN=$token $GH api -X DELETE "repos/$R/actions/runners/$id" >/dev/null 2>&1 || true
    log "replaced idle runner $c: $why"
  done
}

# Remove everything except running runner containers; keep image layers (build cache).
reset_engine() {
  local ids
  ids=$(docker ps -aq | grep -vxF -f <(docker ps -q --filter label=adlc.ci=runner) || true)
  if [ -n "$ids" ]; then
    xargs docker rm -f <<<"$ids" >/dev/null 2>&1
    log "removed $(wc -l <<<"$ids") leftover container(s) from the previous job"
  fi
  docker volume prune -af --filter "label!=$CACHE_LABEL" >/dev/null 2>&1 || true
  drop_unused_caches
  docker network prune -f >/dev/null 2>&1 || true
  # Images the job's docker compose built (test environments): the next job rebuilds them from the
  # build cache, which is capped here too. Pulled images (postgres, …) stay for speed; see prune_engine.
  ADLC_BUILT_IMAGE_MAX_IDLE_H=0 ADLC_IMAGE_MAX_IDLE_H=876000 prune_finished_runs "$IMAGE $BASE"
  docker image prune -f >/dev/null 2>&1 || true
  prune_build_cache "${ADLC_CI_BUILD_CACHE_KEEP:-4GB}"
}

last_pull=0
# Pull the official base daily; (re)build the ADLC image when the base or its definition changed.
last_build_fail=0
ensure_image() {
  local now key have
  now=$(date +%s)
  if [ $((now - last_pull)) -gt 86400 ] || ! docker image inspect "$BASE" >/dev/null 2>&1; then
    docker pull -q "$BASE" >/dev/null && last_pull=$now && log "base runner image $BASE up to date"
  fi
  key="$(docker image inspect -f '{{.Id}}' "$BASE" 2>/dev/null)-$(cat "$CI_IMAGE_DIR"/* | sha256sum | cut -c1-16)"
  have=$(docker image inspect -f '{{index .Config.Labels "org.adlc.ci.key"}}' "$IMAGE" 2>/dev/null || true)
  [ "$have" = "$key" ] && return 0
  # After a failed build, retry hourly; jobs use the plain base image meanwhile.
  [ $((now - last_build_fail)) -gt 3600 ] || return 0
  if docker build -q -t "$IMAGE" --build-arg BASE="$BASE" --label "org.adlc.ci.key=$key" "$CI_IMAGE_DIR" >/dev/null 2>/tmp/ci-runner-build.err; then
    log "CI runner image $IMAGE built (docker compose, yq, proxy for sudo and Node)"
  else
    last_build_fail=$now
    log "ERROR: cannot build $IMAGE ($(tail -n 3 /tmp/ci-runner-build.err 2>/dev/null | tr '\n' ' ')); jobs use the plain base image, retrying in an hour"
    docker image inspect "$IMAGE" >/dev/null 2>&1 || docker tag "$BASE" "$IMAGE" >/dev/null 2>&1 || true
  fi
}

start_runner() {
  local token name jit gid start label_args=() l
  token=$(secret ci_admin_pat)
  name="adlc-$ADLC_SLUG${HOST:+-$HOST}-$ROLE-$(date +%s)"
  for l in ${LABELS//,/ }; do label_args+=(-f "labels[]=$l"); done
  jit=$(GH_TOKEN=$token $GH api -X POST "repos/$R/actions/runners/generate-jitconfig" \
          -f name="$name" -F runner_group_id=1 -f work_folder=_work "${label_args[@]}" \
          --jq .encoded_jit_config 2>&1) || {
    log "ERROR: cannot create a JIT runner config ($jit). ci_admin_pat needs Administration: read and write on $R"
    return 1
  }
  # The plain base image (fallback when the CI image cannot be built) has only run.sh.
  start=./run.sh
  docker run --rm --entrypoint sh "$IMAGE" -c 'command -v adlc-runner-start' >/dev/null 2>&1 && start=adlc-runner-start
  gid=$(docker run --rm --entrypoint stat -v /var/run/docker.sock:/s "$IMAGE" -c %g /s 2>/dev/null || echo 0)
  # Jobs talk to this engine, so the paths in their bind mounts (docker compose with ./files)
  # are looked up on the engine, not in the runner. Give the engine the job workspace at the
  # same path, fresh for each runner.
  docker run --rm --user root --entrypoint sh -v "$(dirname "$WORK")":/h "$IMAGE" \
    -c "rm -rf /h/$(basename "$WORK") && mkdir -p /h/$(basename "$WORK") && chown runner:runner /h/$(basename "$WORK")" >/dev/null 2>&1 \
    || { log "ERROR: cannot prepare the job workspace $WORK on the CI engine"; return 1; }
  ensure_caches || log "WARN: cannot prepare the build caches; this job starts cold"
  # RUNNER_MANUALLY_TRAP_SIG: run.sh passes SIGTERM on to the listener, which cancels the job and
  # reports it, so `docker stop` (watch_job_time) ends the job on GitHub at once instead of after the
  # runner is declared lost.
  # shellcheck disable=SC2046  # cache_mounts prints -v options
  docker run -d --rm --name "$name" --label adlc.ci=runner --label "adlc.ci.labels=$LABELS" --label "adlc.ci.spec=$SPEC" \
    -v /var/run/docker.sock:/var/run/docker.sock --group-add "$gid" -v "$WORK:$WORK" $(cache_mounts) \
    -e NO_PROXY="$JOB_NO_PROXY" -e no_proxy="$JOB_NO_PROXY" -e ADLC_JOB_NO_PROXY="$JOB_NO_PROXY" \
    -e RUNNER_MANUALLY_TRAP_SIG=1 \
    "$IMAGE" "$start" --jitconfig "$jit" >/dev/null \
    && log "runner $name waiting for a job (labels: $LABELS)"
}


# Once a day, between jobs: images no job used for ADLC_CI_IMAGE_MAX_IDLE_H hours (default 24), e.g.
# publish's local copies of pushed images and base images a project stopped using. The runner images
# and ADLC_KEEP_IMAGES (the Android emulator) stay. (prune_build_cache comes from adlc-lib.sh.)
last_prune=0
prune_engine() {
  local now; now=$(date +%s)
  [ $((now - last_prune)) -gt 86400 ] || return 0
  ADLC_IMAGE_MAX_IDLE_H=${ADLC_CI_IMAGE_MAX_IDLE_H:-24} prune_finished_runs "$IMAGE $BASE"
  local c vol mb
  for c in $CACHES; do
    vol=${c%%:*}
    docker volume inspect "$vol" >/dev/null 2>&1 || continue
    mb=$(docker run --rm --entrypoint du -v "$vol:/c" "$IMAGE" -sm /c 2>/dev/null | cut -f1)
    if [ "${mb:-0}" -gt $(( ${ADLC_CI_CACHE_MAX_GB:-12} * 1024 )) ]; then
      docker volume rm "$vol" >/dev/null 2>&1 && log "housekeeping: cache $vol was ${mb} MB (over ${ADLC_CI_CACHE_MAX_GB:-12} GB): emptied"
    fi
  done
  last_prune=$now
  log "housekeeping: images idle for ${ADLC_CI_IMAGE_MAX_IDLE_H:-24}h removed; $(engine_usage)"
}

# ── Shared CI capacity ───────────────────────────────────────────────────────
# The roles' runners share the dev server's CPU. Capacity is ADLC_CI_SLOTS (default 2); a job of this
# role takes ADLC_CI_WEIGHT (test and publish 1, kvm 2: an Android build plus emulator runs alone).
# GitHub's runner list (same token for all registrars) says which runners are busy; host and role are in
# the name (adlc-<slug>[-<host>]-<role>-<time>). Capacity is per host: only this host's runners count. A
# registrar starts a runner only if its job fits next to the other roles' busy jobs, and removes its
# idle runner when it no longer fits. Best effort: two idle runners can still get jobs in the same second.
SLOTS=${ADLC_CI_SLOTS:-2}
WEIGHT=${ADLC_CI_WEIGHT:-$([ "$ROLE" = kvm ] && echo 2 || echo 1)}
role_weight() { case $1 in kvm) echo "${ADLC_CI_WEIGHT_KVM:-2}" ;; *) echo 1 ;; esac; }
# Weight of the other roles' busy runners; "?" when GitHub can't be asked (then don't block).
others_busy() {
  local names n r h sum=0
  names=$(GH_TOKEN=$(secret ci_admin_pat) $GH api "repos/$R/actions/runners?per_page=100" \
            --jq ".runners[] | select(.busy) | .name" 2>/dev/null) || { echo "?"; return; }
  for n in $names; do
    if [[ "$n" =~ ^adlc-$ADLC_SLUG-(([a-z0-9]+)-)?(test|publish|kvm)-[0-9]+$ ]]; then
      h=${BASH_REMATCH[2]} r=${BASH_REMATCH[3]}
      [ "$h" = "$HOST" ] || continue                     # another host's runner: its own capacity
      [ "$r" = "$ROLE" ] && continue
    else
      [ -z "$HOST" ] || continue                         # unknown runners count on the main host only
      r=other
    fi
    sum=$((sum + $(role_weight "$r")))
  done
  echo "$sum"
}
capacity_ok() { local b; b=$(others_busy); [ "$b" = "?" ] || [ $((b + WEIGHT)) -le "$SLOTS" ]; }
# This registrar's runner, if it is registered and idle on GitHub.
my_idle_runner() {
  local c token
  c=$(docker ps --filter label=adlc.ci=runner --format '{{.Names}}' | head -1); [ -n "$c" ] || return 1
  token=$(secret ci_admin_pat)
  GH_TOKEN=$token $GH api "repos/$R/actions/runners?per_page=100" \
    --jq ".runners[] | select(.name == \"$c\") | select(.busy | not) | \"$c \\(.id)\"" 2>/dev/null
}
waiting_logged=0
yield_capacity() { # remove our idle runner while other roles' jobs fill the capacity
  local idle c id
  idle=$(my_idle_runner) || return 0; [ -n "$idle" ] || return 0
  capacity_ok && return 0
  c=${idle%% *}; id=${idle##* }
  docker rm -f "$c" >/dev/null 2>&1
  GH_TOKEN=$(secret ci_admin_pat) $GH api -X DELETE "repos/$R/actions/runners/$id" >/dev/null 2>&1 || true
  log "removed idle runner $c: other CI jobs use the capacity ($SLOTS slots); a new one starts when they finish"
}

# ── Job time limit ───────────────────────────────────────────────────────────
# A job without timeout-minutes gets GitHub's 6 hours, so one hung step holds this role's only runner
# (and its share of the CI capacity) that long, with every later job of the role queued behind it.
# After ADLC_CI_JOB_MAX_MIN minutes (default 60; 0 = off) the registrar stops the runner: run.sh passes
# the signal on, GitHub ends the job, the poller treats it like a failed check, and the next reset_engine
# removes what the job started. The clock starts at the job's started_at (or when this registrar first
# saw the runner busy, if GitHub can't say), so a registrar restart doesn't reset it.
JOB_MAX_MIN=${ADLC_CI_JOB_MAX_MIN:-60}
job_runner="" job_since=0 job_desc="" last_watch=0
# The job a runner is running: "<started_at>\t<workflow / job>\t<url>", empty if not found.
runner_job() { # runner_job <runner name> <token>
  local id
  for id in $(GH_TOKEN=$2 $GH api "repos/$R/actions/runs?status=in_progress&per_page=50" --jq '.workflow_runs[].id' 2>/dev/null); do
    GH_TOKEN=$2 $GH api "repos/$R/actions/runs/$id/jobs?filter=latest&per_page=100" --jq \
      ".jobs[] | select(.runner_name == \"$1\" and .status == \"in_progress\") | \"\\(.started_at)\t\\(.workflow_name) / \\(.name)\t\\(.html_url)\"" \
      2>/dev/null | head -1 | grep . && return 0
  done
  return 0
}
watch_job_time() {
  [ "${JOB_MAX_MIN:-0}" -gt 0 ] 2>/dev/null || return 0
  local now c token busy job started id
  now=$(date +%s); [ $((now - last_watch)) -ge 60 ] || return 0; last_watch=$now
  c=$(docker ps --filter label=adlc.ci=runner --format '{{.Names}}' | head -1)
  [ -n "$c" ] || { job_runner=""; return 0; }
  token=$(secret ci_admin_pat)
  busy=$(GH_TOKEN=$token $GH api "repos/$R/actions/runners?per_page=100" \
           --jq ".runners[] | select(.name == \"$c\") | .busy" 2>/dev/null) || return 0
  [ "$busy" = true ] || return 0
  if [ "$job_runner" != "$c" ]; then
    job_runner=$c job_since=$now job_desc="its job"
    job=$(runner_job "$c" "$token")
    if [ -n "$job" ]; then
      started=$(date -d "$(cut -f1 <<<"$job")" +%s 2>/dev/null) && job_since=$started
      job_desc="$(cut -f2 <<<"$job") <$(cut -f3 <<<"$job")>"
    fi
  fi
  [ $((now - job_since)) -ge $((JOB_MAX_MIN * 60)) ] || return 0
  log "WARN: runner $c has run $job_desc for $(((now - job_since) / 60)) min (limit ADLC_CI_JOB_MAX_MIN=$JOB_MAX_MIN): stopping it; GitHub ends the job and the next one gets a fresh engine"
  docker stop -t 60 "$c" >/dev/null 2>&1 || docker rm -f "$c" >/dev/null 2>&1
  id=$(GH_TOKEN=$token $GH api "repos/$R/actions/runners?per_page=100" --jq ".runners[] | select(.name == \"$c\") | .id" 2>/dev/null)
  [ -z "$id" ] || GH_TOKEN=$token $GH api -X DELETE "repos/$R/actions/runners/$id" >/dev/null 2>&1 || true
  job_runner=""
}

# ── Network policy (CI-only host) ────────────────────────────────────────────
# The egress proxy reads adlc.yaml; on the main host the poller keeps a clone. On a CI-only host the
# registrars fetch it from the default branch into ADLC_CI_POLICY_DIR every 10 minutes (written only when
# it changed, so the proxy reloads only then). Needs Contents: read on ci_admin_pat; without it the
# proxy keeps ADLC_NETWORK_MODE (default audit), and in allowlist mode would lack the project's domains.
POLICY_DIR=${ADLC_CI_POLICY_DIR:-}
last_policy=0 policy_warned=0
sync_policy() {
  [ -n "$POLICY_DIR" ] || return 0
  local now out
  now=$(date +%s); [ $((now - last_policy)) -ge 600 ] || return 0; last_policy=$now
  if out=$(GH_TOKEN=$(secret ci_admin_pat) $GH api "repos/$R/contents/adlc.yaml" --jq .content 2>/dev/null | base64 -d 2>/dev/null) \
     && [ -n "$out" ]; then
    cmp -s <(printf '%s\n' "$out") "$POLICY_DIR/adlc.yaml" && return 0
    printf '%s\n' "$out" >"$POLICY_DIR/.adlc.yaml.$ROLE" && mv -f "$POLICY_DIR/.adlc.yaml.$ROLE" "$POLICY_DIR/adlc.yaml" \
      && log "network policy: adlc.yaml updated from $R"
    policy_warned=0
  elif [ "$policy_warned" = 0 ]; then
    policy_warned=1
    log "WARN: cannot read adlc.yaml from $R (ci_admin_pat needs Contents: read); the egress proxy keeps ${ADLC_NETWORK_MODE:-audit} mode"
  fi
}

log "registrar ($ROLE${HOST:+ on $HOST}) started: one runner at a time with labels $LABELS, image $IMAGE; CI capacity $SLOTS slot(s), this role takes $WEIGHT; job limit ${JOB_MAX_MIN} min"
while :; do
  if [ -z "$(secret ci_admin_pat)" ]; then
    log "CI runner disabled: no ci_admin_pat (adlc secrets $ADLC_SLUG)"; sleep 300; continue
  fi
  # Image first (cheap when current), then retire idle runners that are outdated, then make sure
  # one runner waits for the next job.
  sync_policy
  ensure_image
  replace_stale_runners
  if runner_running; then
    watch_job_time
    yield_capacity
  elif capacity_ok; then
    [ "$waiting_logged" = 0 ] || log "CI capacity free again"
    waiting_logged=0
    reset_engine
    prune_engine
    start_runner || sleep 60
  elif [ "$waiting_logged" = 0 ]; then
    log "waiting: other CI jobs use the capacity ($SLOTS slots, this role takes $WEIGHT)"; waiting_logged=1
  fi
  sleep "$INTERVAL"
done
