#!/usr/bin/env bash
# Open (or re-attach to) an interactive Claude Code session in the runner's tmux.
# The session is started with --remote-control, so the same conversation is also
# reachable from claude.ai/code and the Claude app, and it survives SSH disconnects.
#
#   adlc-session [name]                  own worktree sessions/<name> (branch adlc/session-<name>)
#   adlc-session --run <n> [--takeover]  the worktree of delivery run #n; --takeover stops
#                                        the unattended run first (resume it with /adlc-core:deliver <n>)
set -euo pipefail
ADLC_COMPONENT=session
# shellcheck source=adlc-lib.sh
source /usr/local/bin/adlc-lib.sh

name=main run="" takeover=0
while [ $# -gt 0 ]; do
  case $1 in
    --run) run=$2; shift 2 ;;
    --takeover) takeover=1; shift ;;
    -*) die "unknown option $1" ;;
    *) name=$1; shift ;;
  esac
done
[[ "$name" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || die "invalid session name '$name'"
[ -f "$STATE_DIR/logged_in" ] || die "not logged in yet: run 'adlc login $ADLC_SLUG' on the host"
repo_ready || die "the shared clone doesn't exist yet"
tmux has-session -t adlc 2>/dev/null || die "runner tmux session is not running"

if [ -n "$run" ]; then
  [[ "$run" =~ ^[0-9]+$ ]] || die "invalid issue number '$run'"
  dir="$RUNS_DIR/$run"; window="run-$run"
  [ -d "$dir" ] || die "no worktree for run #$run (it hasn't started, or was cleaned up)"
  if pgrep -f "adlc-core:deliver $run( |$)" >/dev/null; then
    if [ "$takeover" = 1 ]; then
      mkdir -p "$STATE_DIR/takeover" && touch "$STATE_DIR/takeover/$run"
      pkill -TERM -f "adlc-core:deliver $run( |$)" || true
      for _ in $(seq 1 30); do pgrep -f "adlc-core:deliver $run( |$)" >/dev/null || break; sleep 1; done
      log "stopped unattended run #$run; continue it here with: /adlc-core:deliver $run"
    else
      die "run #$run is in progress unattended. Watch it with 'adlc logs $ADLC_SLUG run $run', or take it over with --takeover"
    fi
  fi
  title="adlc-$ADLC_SLUG-run-$run"
else
  dir="$ADLC_WS/sessions/$name"; window="s-$name"
  if [ ! -e "$dir/.git" ]; then
    b=$(default_branch)
    if git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/adlc/session-$name"; then
      git -C "$REPO_DIR" worktree add --quiet "$dir" "adlc/session-$name"
    else
      git -C "$REPO_DIR" worktree add --quiet -b "adlc/session-$name" "$dir" "origin/$b"
    fi
    log "created worktree $dir (branch adlc/session-$name)"
  fi
  title="adlc-$ADLC_SLUG-$name"
fi

if ! tmux list-windows -t adlc -F '#{window_name}' | grep -qx "$window"; then
  # Interactive sessions use the /login account (not the headless token) and are never "unattended".
  tmux new-window -d -t adlc -n "$window" -c "$dir" \
    "env -u CLAUDE_CODE_OAUTH_TOKEN -u ADLC_MODE ADLC_RUN='$run' \
       ADLC_PROJECT_DOMAIN='$ADLC_SLUG.${ADLC_BASE_DOMAIN:-lan}' \
       claude --remote-control '$title'; echo; echo 'Claude exited. Shell in $dir (exit closes this window).'; exec bash -l"
fi
echo "Attaching to '$window'. Detach: Ctrl-b d · switch windows: Ctrl-b w"
[ -t 1 ] && exec tmux attach -t "adlc:$window"
echo "(no terminal: attach later with 'adlc attach $ADLC_SLUG')"
