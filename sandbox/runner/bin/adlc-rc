#!/usr/bin/env bash
# Keeps a Claude Code Remote Control server running for the project.
#
# The server runs in its own worktree (sessions/rc), never in the shared clone: the poller
# resets repo/ to origin/<default> every minute.
#
# Spawn mode (ADLC_RC_SPAWN):
#   same-dir (default)  every session from the Claude app works in sessions/rc, on whatever
#                       branch is checked out there. Continuing a phase after a restart just
#                       works. Sessions open at the same time share the folder; for parallel
#                       work use `adlc session <slug> <name>` (own worktree).
#   worktree            every new app session gets a fresh worktree under repo/.claude/worktrees.
set -uo pipefail
ADLC_COMPONENT=rc
# shellcheck source=adlc-lib.sh
source /usr/local/bin/adlc-lib.sh

# Remote Control needs the /login session, not the setup-token used for headless runs.
unset CLAUDE_CODE_OAUTH_TOKEN

RC_DIR="$ADLC_WS/sessions/rc"
RC_BRANCH=adlc/session-rc
SPAWN=${ADLC_RC_SPAWN:-same-dir}

until [ -f "$STATE_DIR/logged_in" ] && repo_ready; do
  log "waiting: run 'adlc login $ADLC_SLUG' on the host (and make sure the repo exists)"
  sleep 30
done

clean() { [ -z "$(git -C "$1" status --porcelain 2>/dev/null)" ]; }

# Sessions from before this (re)start are gone. Remove their worktrees when they hold no
# uncommitted work, so their branches (which keep all commits) can be checked out again.
release_stale_session_worktrees() {
  local wt
  for wt in "$REPO_DIR"/.claude/worktrees/*/; do
    [ -e "$wt/.git" ] || continue
    if clean "$wt"; then
      git -C "$REPO_DIR" worktree remove "$wt" >/dev/null 2>&1 && log "removed idle session worktree $(basename "$wt")"
    else
      log "session worktree $(basename "$wt") has uncommitted work; kept (its branch stays checked out there)"
    fi
  done
  git -C "$REPO_DIR" worktree prune 2>/dev/null || true
}

# Create sessions/rc, or move it to the latest default branch when it's idle. A phase branch
# (e.g. adlc/discovery) that's checked out there is left as is, so work continues after restarts.
prepare_rc_worktree() {
  local b current; b=$(default_branch)
  git -C "$REPO_DIR" fetch --quiet origin 2>/dev/null || true
  if [ ! -e "$RC_DIR/.git" ]; then
    git -C "$REPO_DIR" worktree prune 2>/dev/null || true
    if git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/$RC_BRANCH"; then
      git -C "$REPO_DIR" worktree add --quiet "$RC_DIR" "$RC_BRANCH"
    else
      git -C "$REPO_DIR" worktree add --quiet -b "$RC_BRANCH" "$RC_DIR" "origin/$b"
    fi
    log "created worktree $RC_DIR ($RC_BRANCH)"
    return
  fi
  current=$(git -C "$RC_DIR" symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
  if [ -n "$current" ] && [ "$current" != "$RC_BRANCH" ]; then
    log "sessions/rc stays on $current"
  elif clean "$RC_DIR" && [ -z "$(git -C "$RC_DIR" rev-list HEAD --not --remotes 2>/dev/null)" ]; then
    git -C "$RC_DIR" checkout --quiet -B "$RC_BRANCH" "origin/$b" && log "sessions/rc reset to $b"
  else
    log "sessions/rc has uncommitted or unpushed work; leaving it as is"
  fi
}

while :; do
  release_stale_session_worktrees
  prepare_rc_worktree || { log "could not prepare $RC_DIR; retrying in 30s"; sleep 30; continue; }
  cd "$RC_DIR" || { sleep 30; continue; }
  log "starting remote-control in $RC_DIR, spawn mode $SPAWN (first start asks 'Enable Remote Control?' here; answer y)"
  out=$(mktemp)
  claude remote-control \
    --name "adlc-$ADLC_SLUG" \
    --spawn "$SPAWN" \
    --permission-mode "${ADLC_RC_PERMISSION_MODE:-acceptEdits}" 2> >(tee "$out" >&2) || true
  # The claude.ai login expired or was lost (delivery runs keep working: they use the setup token).
  # Say so where people look (adlc status, the dashboard's Health tab), and wait for a new login
  # instead of retrying every 15 seconds.
  if grep -qiE "must be logged in|auth login" "$out"; then
    rm -f "$STATE_DIR/logged_in"
    log "ERROR: the Claude login in the runner has expired. Remote Control is off until you run 'adlc login $ADLC_SLUG' on the host"
    rm -f "$out"
    until [ -f "$STATE_DIR/logged_in" ]; do sleep 30; done
    log "logged in again; starting Remote Control"
    continue
  fi
  rm -f "$out"
  log "remote-control exited; restarting in 15s"
  sleep 15
done
