#!/usr/bin/env bash
# Pull-based deployer for the dev environment: when CI has published images for the
# current head of the default branch, run `docker compose pull && up -d` with that tag.
# Active only when adlc.yaml says environments.dev.deploy.mechanism == pull-deployer.
set -uo pipefail
ADLC_COMPONENT=deployer
# shellcheck source=adlc-lib.sh
source /usr/local/bin/adlc-lib.sh

INTERVAL=${ADLC_DEPLOY_INTERVAL:-120}
ensure_dirs

# Missing secret files of the dev stack → state/dev_missing_secrets.json (for adlc status and the
# dashboard) and one log line per new set; returns 1 while any is missing.
missing_logged=""
check_dev_secrets() {
  local paths p name missing=() hint lines=() fmt gen cfiles=() a origin pr
  for a in "$@"; do [ "$a" = -f ] || cfiles+=("$a"); done
  paths=$(IMAGE_TAG=check ADLC_PROJECT_DOMAIN="$ADLC_SLUG.${ADLC_BASE_DOMAIN:-lan}" \
    docker compose -p "$ADLC_SLUG-dev" --project-directory "$REPO_DIR" "$@" config --format json 2>/dev/null \
    | jq -r '(.secrets // {})[] | .file // empty') || return 0      # can't tell: let the deploy report it
  for p in $paths; do [ -e "$p" ] || missing+=("$p"); done
  if [ ${#missing[@]} = 0 ]; then
    [ -z "$missing_logged" ] || log "dev secrets complete again"
    missing_logged=""; rm -f "$STATE_DIR/dev_missing_secrets.json"; return 0
  fi
  for p in "${missing[@]}"; do
    name=$(basename "$p")
    # The test environment usually generates the same secret: reuse its format (e.g. `make <name> hex 24`).
    fmt=$(grep -hE "^[[:space:]]*make[[:space:]]+$name[[:space:]]" "$REPO_DIR"/deploy/test/secrets.sh 2>/dev/null | head -1 | awk '{print $3, $4}')
    # or a one-line generator function in the same file (`make <name> <fn>` with `<fn>() { …; }`)
    gen=""; [ -n "${fmt%% *}" ] && gen=$(sed -nE "s/^[[:space:]]*${fmt%% *}\(\)[[:space:]]*\{[[:space:]]*(.*[^[:space:]])[[:space:]]*;?[[:space:]]*\}[[:space:]]*$/\1/p" "$REPO_DIR"/deploy/test/secrets.sh 2>/dev/null | head -1)
    case $fmt in
      "hex "*) hint="openssl rand -hex ${fmt#hex } > $p && chmod 444 $p   (chmod 600 instead if only a root container reads it and refuses world-readable files, like Garage)" ;;
      *) [ -n "$gen" ] && hint="( ${gen%;} ) > $p && chmod 444 $p" || hint="create $p (format: see deploy/test/secrets.sh or the PR's owner notes), then chmod 444 (600 if only a root container reads it)" ;;
    esac
    # The merged change that added it: the newest commit whose diff adds or removes the name in the
    # dev stack's compose files; a squash merge's subject ends with "(#<PR>)". Its owner notes say how.
    origin=$(git -C "$REPO_DIR" log -1 --format='%h%x09%s' -S"$name" -- "${cfiles[@]}" 2>/dev/null)
    pr=$(cut -f2- <<<"$origin" | grep -oE '\(#[0-9]+\)' | tail -1 | tr -dc '0-9')
    lines+=("$(jq -cn --arg name "$name" --arg path "$p" --arg hint "$hint" --arg commit "${origin%%$'\t'*}" \
      --arg title "$(cut -f2- <<<"$origin")" --arg pr "$pr" \
      '{name:$name,path:$path,hint:$hint} + (if $commit == "" then {} else {commit:$commit, title:$title} end)
       + (if $pr == "" then {} else {pr:($pr|tonumber)} end)')")
  done
  printf '%s\n' "${lines[@]}" | jq -s --arg tag "$tag" --arg at "$(date -u +%FT%TZ)" '{tag:$tag, since:$at, missing:.}' \
    >"$STATE_DIR/dev_missing_secrets.json.tmp" && mv "$STATE_DIR/dev_missing_secrets.json.tmp" "$STATE_DIR/dev_missing_secrets.json"
  if [ "$missing_logged" != "${missing[*]}" ]; then
    log "ERROR: $tag needs dev secret(s) that don't exist yet, so it isn't deployed:"
    printf '%s\n' "${lines[@]}" | jq -r '"  \(.name)\(if .pr then " (added by PR #\(.pr))" else "" end): \(.hint)"' | while IFS= read -r l; do log "$l"; done
    missing_logged="${missing[*]}"
  fi
  return 1
}

while :; do
  sleep "$INTERVAL"
  repo_ready || continue
  [ "$(cfg '.environments.dev.deploy.mechanism')" = pull-deployer ] || continue
  base=$(build_cfg '.deploy_files.base'); dev=$(build_cfg '.deploy_files.dev')
  [ -n "$base" ] && [ -f "$REPO_DIR/$base" ] || continue   # before the walking skeleton lands

  sha=$(git -C "$REPO_DIR" rev-parse --short=7 "origin/$(default_branch)" 2>/dev/null) || continue
  tag="sha-$sha"
  [ "$(cat "$STATE_DIR/dev_deployed" 2>/dev/null)" = "$tag" ] && continue

  ns=$(cfg '.registry.namespace')
  [ -n "$ns" ] && [ "$ns" != tbd ] || { log "registry.namespace is not set; skipping"; continue; }
  missing="" refused=""
  for img in $(cfg '.registry.images[]'); do
    if ! err=$(docker manifest inspect "$ns/$img:$tag" 2>&1 >/dev/null); then
      # Harbor answers 412 when its "prevent vulnerable images" policy blocks the pull; any other
      # error that isn't "not found" (auth, network) is worth showing too.
      case $err in
        *"no such manifest"*|*"manifest unknown"*|*"not found"*) missing="$missing $img" ;;
        *) refused="$refused $img ($(tr '\n' ' ' <<<"$err" | cut -c1-200))" ;;
      esac
    fi
  done
  if [ -n "$refused" ]; then
    log "ERROR: the registry refuses $tag:$refused. A vulnerability policy block means the image must be fixed (or the registry threshold changed); the publish workflow's scan shows the findings"
    continue
  fi
  if [ -n "$missing" ]; then log "waiting for CI to publish $tag:$missing"; continue; fi

  files=(-f "$REPO_DIR/$base"); [ -n "$dev" ] && [ -f "$REPO_DIR/$dev" ] && files+=(-f "$REPO_DIR/$dev")
  # Dev secrets are files the owner creates by hand. A feature that adds one would make the deploy fail
  # with a Docker mount error: name the missing ones instead, with how to create them, and wait.
  if ! check_dev_secrets "${files[@]}"; then continue; fi
  log "deploying $tag to dev"
  if IMAGE_TAG=$tag ADLC_PROJECT_DOMAIN="$ADLC_SLUG.${ADLC_BASE_DOMAIN:-lan}" \
       docker compose -p "$ADLC_SLUG-dev" --project-directory "$REPO_DIR" "${files[@]}" pull --quiet \
     && IMAGE_TAG=$tag ADLC_PROJECT_DOMAIN="$ADLC_SLUG.${ADLC_BASE_DOMAIN:-lan}" \
       docker compose -p "$ADLC_SLUG-dev" --project-directory "$REPO_DIR" "${files[@]}" up -d --remove-orphans --wait; then
    echo "$tag" >"$STATE_DIR/dev_deployed"
    log "dev is now at $tag"
    # The previous versions' images (each ~0.5 GB) are no longer needed: the registry keeps them.
    old=$(docker images --format '{{.Repository}}:{{.Tag}}' "$ns/*" 2>/dev/null | grep -v ":$tag\$" || true)
    # shellcheck disable=SC2086  # one image per word; in-use images fail harmlessly (no -f)
    [ -z "$old" ] || { docker rmi $old >/dev/null 2>&1 || true; log "removed $(wc -w <<<"$old") previous dev image(s)"; }
  else
    log "ERROR: dev deployment of $tag failed; will retry"
  fi
done
