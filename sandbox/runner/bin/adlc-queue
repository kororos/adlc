#!/usr/bin/env -S node --no-warnings
// adlc-queue [--all] [--limit N]: the project's open work in order of precedence.
// adlc-queue --snapshot <file>: the same plus open PRs, the issues waiting for a person and the GitHub
//   Actions runs (active and recent, with jobs and runners), as
//   JSON for the ADLC dashboard (written atomically; the poller refreshes it every minute).
//
// Mirrors the poller: an issue can start when all its "blocked by" issues are closed; among
// those, "run next" (label adlc:priority, set from the dashboard) comes first, then reworks (ready issues
// with an open agent PR, unless the switch rework_first is off), then the earliest milestone due date,
// then the oldest issue. With max_open_prs set, new issues wait while that many agent PRs are open. Owner tasks (adlc:owner)
// take their place in the same order, so you see when your task is the next thing in the way.
// Epics and issues without ADLC labels aren't pipeline work and are left out.
"use strict"
const { execFileSync } = require("node:child_process")
const fs = require("node:fs")

const args = process.argv.slice(2)
const all = args.includes("--all")
const li = args.indexOf("--limit")
const limit = all ? Infinity : Number(li >= 0 ? args[li + 1] : 15)
const si = args.indexOf("--snapshot")
const snapshot = si >= 0 ? args[si + 1] : ""
const [owner, name] = (process.env.ADLC_REPO || "").split("/")
if (!owner || !name) { console.error("adlc-queue: ADLC_REPO is not set"); process.exit(2) }

const query = `query($o:String!,$r:String!,$endCursor:String){repository(owner:$o,name:$r){
  issues(states:OPEN,first:100,after:$endCursor){pageInfo{hasNextPage endCursor}
    nodes{number title url createdAt milestone{title dueOn} labels(first:30){nodes{name}}
          assignees(first:5){nodes{login}}
          comments(last:1){nodes{author{login} createdAt body url}}
          blockedBy(first:100){nodes{number state}}}}}}`
const raw = execFileSync("gh", ["api", "graphql", "--paginate", "--slurp",
  "-f", `query=${query}`, "-f", `o=${owner}`, "-f", `r=${name}`], { encoding: "utf8", maxBuffer: 64 << 20 })
const issues = JSON.parse(raw).flatMap((p) => p.data.repository.issues.nodes)

// Issues with an open agent PR (branch adlc/<n>-…) and the poller's switches (state/settings.json).
const prIssues = new Set()
try {
  for (const p of JSON.parse(execFileSync("gh", ["pr", "list", "-R", `${owner}/${name}`, "--state", "open", "--limit", "100",
    "--json", "headRefName"], { encoding: "utf8" }))) {
    const m = p.headRefName.match(/^adlc\/(\d+)-/)
    if (m) prIssues.add(Number(m[1]))
  }
} catch { /* order without it */ }
const settings = (() => {
  try {
    const f = `${process.env.ADLC_ROOT}/projects/${process.env.ADLC_SLUG}/state/settings.json`
    return Object.fromEntries(JSON.parse(fs.readFileSync(f, "utf8")).settings.map((x) => [x.key, x.value]))
  } catch { return {} }
})()
const reworkFirst = (settings.rework_first ?? "on") === "on"
const maxOpenPrs = /^\d+$/.test(settings.max_open_prs ?? "") ? Number(settings.max_open_prs) : null
const wipHeld = maxOpenPrs !== null && prIssues.size >= maxOpenPrs

const STATES = ["in-progress", "pr-open", "needs-info", "blocked", "needs-human-review", "ready", "queued"]
const work = new Map()
for (const i of issues) {
  const labels = i.labels.nodes.map((l) => l.name)
  if (labels.includes("type:epic")) continue
  const isOwner = labels.includes("adlc:owner") || labels.includes("owner-task")
  const state = isOwner ? "owner" : STATES.find((s) => labels.includes(`adlc:${s}`))
  if (!state) continue
  work.set(i.number, {
    n: i.number, title: i.title, url: i.url, state, created: i.createdAt, raw: i,
    ms: i.milestone?.title ?? "", due: i.milestone?.dueOn ?? "9999", priority: labels.includes("adlc:priority"),
    rework: prIssues.has(i.number),
    blockers: i.blockedBy.nodes.filter((b) => b.state === "OPEN").map((b) => b.number),
  })
}

// Kahn's algorithm with the poller's tie-break. Blockers outside the pipeline (e.g. an epic or
// an unlabelled issue) still hold an issue back but can't be ordered, so they count as "done"
// for ordering and are shown on the issue.
const remaining = new Map([...work].map(([n, w]) => [n, w.blockers.filter((b) => work.has(b)).length]))
const blocks = new Map()
for (const w of work.values()) for (const b of w.blockers) if (work.has(b)) {
  if (!blocks.has(b)) blocks.set(b, [])
  blocks.get(b).push(w.n)
}
const key = (w) => [w.priority ? 0 : 1, reworkFirst && w.rework && w.state === "ready" ? 0 : 1, w.due, w.created, w.n]
const cmp = (a, b) => { const x = key(a), y = key(b); for (let k = 0; k < x.length; k++) if (x[k] !== y[k]) return x[k] < y[k] ? -1 : 1; return 0 }
const avail = [...work.values()].filter((w) => remaining.get(w.n) === 0)
const order = []
while (avail.length) {
  avail.sort(cmp)
  const w = avail.shift()
  order.push(w)
  for (const d of blocks.get(w.n) ?? []) {
    remaining.set(d, remaining.get(d) - 1)
    if (remaining.get(d) === 0) avail.push(work.get(d))
  }
}
const cyclic = [...work.values()].filter((w) => !order.includes(w)).sort(cmp)

if (snapshot) {
  const prQuery = `query($o:String!,$r:String!){repository(owner:$o,name:$r){
    pullRequests(states:OPEN,first:50,orderBy:{field:CREATED_AT,direction:DESC}){nodes{
      number title url isDraft createdAt author{login} reviewDecision mergeStateStatus
      labels(first:20){nodes{name}} closingIssuesReferences(first:5){nodes{number}}
      commits(last:1){nodes{commit{statusCheckRollup{state}}}}}}}}`
  const pr = JSON.parse(execFileSync("gh", ["api", "graphql", "-f", `query=${prQuery}`, "-f", `o=${owner}`, "-f", `r=${name}`],
    { encoding: "utf8", maxBuffer: 64 << 20 })).data.repository.pullRequests.nodes
  const item = (w, i) => ({
    rank: i + 1, number: w.n, title: w.title, url: w.url, state: w.state, milestone: w.ms,
    blockers: w.blockers.map((b) => ({ number: b, owner: work.get(b)?.state === "owner" })),
    unblocks: (blocks.get(w.n) ?? []).length, priority: w.priority, rework: w.rework,
    assignees: w.raw.assignees.nodes.map((a) => a.login),
  })
  const lastComment = (w) => {
    const c = w.raw.comments.nodes[0]
    return c ? { author: c.author?.login ?? "", at: c.createdAt, url: c.url, body: c.body.slice(0, 1500) } : null
  }
  const counts = {}
  for (const w of work.values()) counts[w.state] = (counts[w.state] ?? 0) + 1
  const data = {
    generatedAt: new Date().toISOString(),
    repo: `${owner}/${name}`,
    counts,
    wip: { openPrs: prIssues.size, max: maxOpenPrs, held: wipHeld },
    queue: [...order, ...cyclic].map(item),
    cyclic: cyclic.map((w) => w.n),
    attention: [...work.values()].filter((w) => ["blocked", "needs-info", "needs-human-review"].includes(w.state))
      .sort((a, b) => a.n - b.n).map((w) => ({ ...item(w, order.indexOf(w)), lastComment: lastComment(w) })),
    pullRequests: pr.map((p) => ({
      number: p.number, title: p.title, url: p.url, draft: p.isDraft, createdAt: p.createdAt,
      author: p.author?.login ?? "", reviewDecision: p.reviewDecision, mergeState: p.mergeStateStatus,
      labels: p.labels.nodes.map((l) => l.name), closes: p.closingIssuesReferences.nodes.map((c) => c.number),
      checks: p.commits.nodes[0]?.commit.statusCheckRollup?.state ?? null,
    })),
  }
  // GitHub Actions: runs that are queued or running, plus the most recent finished ones (last 6 h), each
  // with its jobs and the runner that took them (the ADLC runner's host and role are in its name:
  // adlc-<slug>[-<host>]-<test|publish|kvm>-<time>, no host on the main ADLC host). Best effort: the rest of
  // the snapshot doesn't depend on it.
  try {
    const gh = (path) => JSON.parse(execFileSync("gh", ["api", path], { encoding: "utf8", maxBuffer: 64 << 20 }))
    const since = Date.now() - 6 * 3600_000
    const runs = gh(`repos/${owner}/${name}/actions/runs?per_page=50`).workflow_runs
    const active = runs.filter((r) => r.status !== "completed")
    const recent = runs.filter((r) => r.status === "completed" && new Date(r.updated_at).getTime() > since).slice(0, 10)
    const runnerName = new RegExp(`^adlc-${process.env.ADLC_SLUG}-(?:([a-z0-9]+)-)?(test|publish|kvm)-\\d+$`)
    const role = (runner) => {
      if (!runner) return null
      const m = runner.match(runnerName)
      return m ? m[2] : runner.startsWith("adlc-") ? "self-hosted" : "github"
    }
    const host = (runner) => runner?.match(runnerName)?.[1] ?? null
    data.actions = {
      generatedAt: new Date().toISOString(),
      runs: [...active, ...recent].map((r) => {
        let jobs = []
        try {
          jobs = gh(`repos/${owner}/${name}/actions/runs/${r.id}/jobs?per_page=50`).jobs.map((j) => ({
            name: j.name, status: j.status, conclusion: j.conclusion, url: j.html_url,
            queuedAt: j.created_at, startedAt: j.started_at, completedAt: j.completed_at,
            runner: j.runner_name || null, role: role(j.runner_name), host: host(j.runner_name), labels: j.labels,
          }))
        } catch { /* keep the run without its jobs */ }
        return {
          id: r.id, workflow: r.name, title: r.display_title, branch: r.head_branch, event: r.event,
          sha: r.head_sha.slice(0, 7), pr: r.pull_requests?.[0]?.number ?? null, url: r.html_url,
          status: r.status, conclusion: r.conclusion, createdAt: r.created_at, startedAt: r.run_started_at,
          updatedAt: r.updated_at, jobs,
        }
      }),
    }
  } catch (e) {
    data.actions = { generatedAt: new Date().toISOString(), runs: [], error: String(e.message || e).slice(0, 300) }
  }
  const tmp = `${snapshot}.tmp`
  fs.writeFileSync(tmp, JSON.stringify(data))
  fs.renameSync(tmp, snapshot)
  process.exit(0)
}

const pad = (s, n) => (s.length > n ? s.slice(0, n - 1) + "…" : s.padEnd(n))
const line = (w, i, note = "") => {
  // owner blockers first (they're what you can act on), at most 5 listed
  const bs = [...w.blockers].sort((a, b) => (work.get(b)?.state === "owner") - (work.get(a)?.state === "owner") || a - b)
  const tag = (b) => `#${b}${work.get(b)?.state === "owner" ? "(owner)" : ""}`
  const why = bs.length ? `← ${bs.slice(0, 5).map(tag).join(" ")}${bs.length > 5 ? ` +${bs.length - 5}` : ""}` : ""
  const unblocks = (blocks.get(w.n) ?? []).length
  const tail = [w.priority ? "▲ run next" : "", w.rework && w.state === "ready" ? "↻ rework" : "", why, w.state === "owner" && unblocks ? `→ unblocks ${unblocks}` : "", note].filter(Boolean).join("  ")
  return `${String(i).padStart(4)}. #${String(w.n).padEnd(5)}${pad(w.state, 12)}${pad(w.ms.split(" ")[0] || "-", 4)} ${pad(w.title, 58)} ${tail}`
}
const shown = order.slice(0, limit)
const counts = {}
for (const w of work.values()) counts[w.state] = (counts[w.state] ?? 0) + 1
console.log(`queue: ${work.size} open (${Object.entries(counts).map(([s, c]) => `${c} ${s}`).join(", ")})` +
  (shown.length < order.length ? `, next ${shown.length} shown (--all for everything)` : ""))
if (wipHeld) console.log(`  new issues wait: ${prIssues.size} agent PRs are open (max_open_prs ${maxOpenPrs}); reworks still run`)
shown.forEach((w, i) => console.log(line(w, i + 1)))
if (all) cyclic.forEach((w, i) => console.log(line(w, order.length + i + 1, "(dependency cycle)")))
else if (cyclic.length) console.log(`  ${cyclic.length} issue(s) in a dependency cycle: ${cyclic.map((w) => `#${w.n}`).join(" ")}`)
